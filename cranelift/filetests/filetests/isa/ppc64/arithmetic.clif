function %iconst_various() -> i64 {
block0:
    v0 = iconst.i64 42
    v1 = iconst.i64 0x7fff_0000
    v2 = iconst.i64 0x1234_5678_9abc_def0
    v3 = iadd v0, v1
    v4 = iadd v3, v2
    return v4
}

