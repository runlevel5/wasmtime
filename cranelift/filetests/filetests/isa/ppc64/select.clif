; block0: ; offset 0x0
;   li r4, 0
;   cmpld r3, r4
;   bne 0x10
;   trap ; trap: user1
;   li r4, 0
;   cmpld r3, r4
;   beq 0x20
;   trap ; trap: user2
;   blr

function %iadd_imm(i64) -> i64 {
block0(v0: i64):
    v1 = iconst.i64 100
    v2 = iadd v0, v1
    return v2
}

