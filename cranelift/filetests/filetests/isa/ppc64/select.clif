test compile precise-output
target powerpc64le

function %select_fused(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64):
    v3 = icmp slt v0, v1
    v4 = select v3, v1, v2
    return v4
}

; VCode:
; block0:
;   select.slt r3, r4, r5 # cmp r3, r4
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   cmpd r3, r4
;   isel r3, r4, r5, cr0lt
;   blr

function %select_nonzero(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64):
    v3 = select v0, v1, v2
    return v3
}

; VCode:
