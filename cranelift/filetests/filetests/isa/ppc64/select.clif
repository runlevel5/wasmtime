function %trapz_trapnz(i64) {
block0(v0: i64):
    trapz v0, user1
    trapnz v0, user2
    return
}

; VCode:
; block0:
;   load_const r4, 0x0
;   trap_if.eq r3, r4 # user1
;   load_const r4, 0x0
;   trap_if.ne r3, r4 # user2
;   blr
;
