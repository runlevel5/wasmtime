;   addi r1, r1, -0x30
;   ld r0, 0x38(r1)
;   std r0, 8(r1)
;   ld r31, 0x30(r1)
;   std r31, 0(r1)
;   ori r31, r1, 0
; block1: ; offset 0x2c
;   std r3, 0x30(r1)
;   std r3, 0x38(r1)
;   ori r10, r3, 0
;   ori r4, r10, 0
;   ori r5, r10, 0
;   ori r6, r10, 0
;   ori r7, r10, 0
;   ori r8, r10, 0
;   ori r9, r10, 0
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
