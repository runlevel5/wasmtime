test compile precise-output
target powerpc64le

; The index is bounds-checked against the number of entries, then used to
; index a table of `b` instructions that follows inline. Reading the PC
; needs the `bcl`/`mflr` idiom, since PowerPC before POWER10 cannot compute
; a PC-relative address directly.
function %br_table(i32) -> i64 {
block0(v0: i32):
    br_table v0, block4, [block1, block2, block3]
block1:
    v1 = iconst.i64 1
    return v1
block2:
    v2 = iconst.i64 2
    return v2
block3:
    v3 = iconst.i64 3
    return v3
block4:
    v4 = iconst.i64 -1
    return v4
}

