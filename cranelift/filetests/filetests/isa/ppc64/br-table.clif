;   ori r31, r1, 0
; block1: ; offset 0x14
;   clrldi r7, r3, 0x20
;   cmpldi r7, 3
;   blt 0x24
;   b 0x94
;   bdnzl 0x28
;   mflr r6
;   sldi r7, r7, 2
;   add r6, r6, r7
;   addi r6, r6, 0x18
;   mtctr r6
;   bctr
;   b 0x7c
;   b 0x64
;   b 0x4c
; block2: ; offset 0x4c
;   li r3, 3
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr
; block3: ; offset 0x64
;   li r3, 2
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr
; block4: ; offset 0x7c
;   li r3, 1
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr
; block5: ; offset 0x94
