function %logic_v128(i32x4, i32x4) -> i32x4 {
block0(v0: i32x4, v1: i32x4):
    v2 = band v0, v1
    v3 = bor v2, v1
    v4 = bxor v3, v0
    v5 = bnot v4
    return v5
}

