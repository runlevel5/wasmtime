test compile precise-output
target powerpc64le

; `fcfid` and friends read a 64-bit integer out of an FPR, so the value is
; widened in a GPR (matching the conversion's signedness) and transferred.
function %from_sint_i64(i64) -> f64 {
block0(v0: i64):
    v1 = fcvt_from_sint.f64 v0
    return v1
}

; VCode:
; block0:
;   mtvsrd f2, r3
;   fcfid.f64 f1, f2
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   mtvsrd f2, r3
;   fcfid f1, f2
;   blr

function %from_uint_i64(i64) -> f64 {
block0(v0: i64):
    v1 = fcvt_from_uint.f64 v0
    return v1
}

; VCode:
; block0:
;   mtvsrd f2, r3
;   fcfidu.f64 f1, f2
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   mtvsrd f2, r3
;   fcfidu f1, f2
;   blr

function %from_sint_i32(i32) -> f64 {
block0(v0: i32):
    v1 = fcvt_from_sint.f64 v0
    return v1
}

; VCode:
; block0:
;   sext.32->64 r3, r3
;   mtvsrd f4, r3
;   fcfid.f64 f1, f4
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   extsw r3, r3
;   mtvsrd f4, r3
;   fcfid f1, f4
;   blr

function %from_uint_i32(i32) -> f64 {
block0(v0: i32):
    v1 = fcvt_from_uint.f64 v0
    return v1
}

; VCode:
; block0:
;   zext.32->64 r3, r3
;   mtvsrd f4, r3
;   fcfidu.f64 f1, f4
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   clrldi r3, r3, 0x20
;   mtvsrd f4, r3
;   fcfidu f1, f4
;   blr

function %from_sint_i32_f32(i32) -> f32 {
block0(v0: i32):
    v1 = fcvt_from_sint.f32 v0
    return v1
}

; VCode:
; block0:
;   sext.32->64 r3, r3
;   mtvsrd f4, r3
;   fcfid.f32 f1, f4
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   extsw r3, r3
;   mtvsrd f4, r3
;   fcfids f1, f4
;   blr

