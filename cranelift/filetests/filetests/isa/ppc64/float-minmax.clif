test compile precise-output
target powerpc64le

; xsmindp/xsmaxdp give the right signed-zero behaviour but return the
; numeric operand when the other is NaN, where CLIF wants NaN, so the
; unordered case falls through to an fadd that propagates a quiet NaN.
function %min_f64(f64, f64) -> f64 {
block0(v0: f64, v1: f64):
    v2 = fmin v0, v1
    return v2
}

; VCode:
;   mflr r0
;   load_addr sp, -16(sp)
;   std r0, 8(sp)
;   std fp, 0(sp)
;   mr fp, sp
; block0:
;   mr f4, f1
;   fmin f1, f4, f2
;   ld r0, 8(sp)
;   mtlr r0
;   ld fp, 0(sp)
;   load_addr sp, 16(sp)
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   mflr r0
;   addi r1, r1, -0x10
;   std r0, 8(r1)
;   std r31, 0(r1)
;   ori r31, r1, 0
; block1: ; offset 0x14
;   fmr f4, f1
;   fcmpu cr0, f4, f2
;   xsmindp f1, f4, f2
;   bns 0x28
;   fadd f1, f4, f2
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr

function %max_f32(f32, f32) -> f32 {
block0(v0: f32, v1: f32):
    v2 = fmax v0, v1
    return v2
}

