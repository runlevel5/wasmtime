test compile precise-output
target powerpc64le power10

; ISA 3.1 has PC-relative addressing, so the three sites that read the PC
; with `bcl 20,31,$+4; mflr` use a prefixed instruction instead and leave
; LR alone. A prefixed instruction must not cross a 64-byte boundary, so
; any function that uses one is 64-byte aligned and pads with a `nop`
; where needed.
;
; Capstone predates ISA 3.1 and cannot decode prefixed instructions, so
; below they appear as raw bytes (or a prefix followed by a misread
; suffix). Their encodings are pinned against llvm-mc by
; `isa_3_1_encodings` in inst/encode.rs.

; The jump table address is a single `paddi`.
function %br_table(i32) -> i64 {
block0(v0: i32):
    br_table v0, block4, [block1, block2, block3]
block1:
    v1 = iconst.i64 1
    return v1
block2:
    v2 = iconst.i64 2
    return v2
block3:
    v3 = iconst.i64 3
    return v3
block4:
    v4 = iconst.i64 -1
    return v4
}

; VCode:
;   mflr r0
;   load_addr sp, -16(sp)
;   std r0, 8(sp)
;   std fp, 0(sp)
;   mr fp, sp
; block0:
;   br_table r3 # 3 targets
; block1:
;   load_const r3, 0x3
;   ld r0, 8(sp)
;   mtlr r0
;   ld fp, 0(sp)
;   load_addr sp, 16(sp)
;   blr
; block2:
;   load_const r3, 0x2
;   ld r0, 8(sp)
;   mtlr r0
;   ld fp, 0(sp)
;   load_addr sp, 16(sp)
;   blr
; block3:
;   load_const r3, 0x1
;   ld r0, 8(sp)
;   mtlr r0
;   ld fp, 0(sp)
;   load_addr sp, 16(sp)
;   blr
; block4:
;   load_const r3, 0xffffffffffffffff
;   ld r0, 8(sp)
;   mtlr r0
;   ld fp, 0(sp)
;   load_addr sp, 16(sp)
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   mflr r0
;   addi r1, r1, -0x10
;   std r0, 8(r1)
;   std r31, 0(r1)
;   ori r31, r1, 0
; block1: ; offset 0x14
;   clrldi r7, r3, 0x20
;   cmpldi r7, 3
;   blt 0x24
;   b 0x90
;   .byte 0x00, 0x00, 0x10, 0x06
;   li r6, 0x18
;   sldi r7, r7, 2
;   add r6, r6, r7
;   mtctr r6
;   bctr
;   b 0x78
;   b 0x60
;   b 0x48
; block2: ; offset 0x48
;   li r3, 3
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr
; block3: ; offset 0x60
;   li r3, 2
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr
; block4: ; offset 0x78
;   li r3, 1
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr
; block5: ; offset 0x90
;   li r3, -1
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr

function %func_addr() -> i64 {
    fn0 = %g()

block0:
    v0 = func_addr.i64 fn0
    return v0
}

; VCode:
;   mflr r0
;   load_addr sp, -16(sp)
;   std r0, 8(sp)
;   std fp, 0(sp)
;   mr fp, sp
; block0:
;   load_ext_name r3, TestCase(%g)+0
;   ld r0, 8(sp)
;   mtlr r0
;   ld fp, 0(sp)
;   load_addr sp, 16(sp)
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   mflr r0
;   addi r1, r1, -0x10
;   std r0, 8(r1)
;   std r31, 0(r1)
;   ori r31, r1, 0
; block1: ; offset 0x14
;   .byte 0x00, 0x00, 0x10, 0x04
;   .byte 0x0c, 0x00, 0x60, 0xe4
;   b 0x28
;   .byte 0x00, 0x00, 0x00, 0x00 ; reloc_external Abs8 %g 0
;   .byte 0x00, 0x00, 0x00, 0x00
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr

function %handler_address() -> i64 {
    sig0 = () tail
    fn0 = %g() tail

    block0:
        v1 = get_exception_handler_address.i64 block1, 0
        jump block1

    block1:
        try_call fn0(), sig0, block2(), [ context v1, tag0: block3(exn1), default: block4() ]

    block2:
        return v1

    block3(v2: i64):
        return v2

    block4:
        return v1
}

