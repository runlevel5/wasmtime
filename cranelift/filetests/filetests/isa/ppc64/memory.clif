test compile precise-output
target powerpc64le

function %load_store(i64) -> i64 {
block0(v0: i64):
    v1 = load.i64 v0
    v2 = load.i32 v0+8
    v3 = uextend.i64 v2
    v4 = iadd v1, v3
    store v4, v0+16
    return v4
}

; VCode:
