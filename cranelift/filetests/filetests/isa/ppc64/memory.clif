; block0: ; offset 0x0
;   ld r5, 0(r3) ; trap: heap_oob
;   lwz r6, 8(r3) ; trap: heap_oob
;   ori r10, r3, 0
;   clrldi r6, r6, 0x20
;   add r3, r5, r6
;   std r3, 0x10(r10) ; trap: heap_oob
;   blr

function %big_offset(i64) -> i64 {
block0(v0: i64):
    v1 = load.i64 v0+0x12345
    return v1
}

