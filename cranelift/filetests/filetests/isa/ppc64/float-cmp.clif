test compile precise-output
target powerpc64le

; `fcmpu` records four mutually exclusive results in cr0 (less-than,
; greater-than, equal, unordered) and each FloatCC is a set of those, so
; conditions covering two results need a `cror` first, and conditions
; covering three are tested as the complement of the fourth.

; A single result: test the bit directly.
function %lt(f64, f64) -> i8 {
block0(v0: f64, v1: f64):
    v2 = fcmp lt v0, v1
    return v2
}

; VCode:
; block0:
;   fcmp_set.lt r3, f1, f2
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   fcmpu cr0, f1, f2
;   li r3, 1
;   li r0, 0
;   isel r3, r3, r0, cr0lt
;   blr

function %le(f64, f64) -> i8 {
block0(v0: f64, v1: f64):
    v2 = fcmp le v0, v1
    return v2
}

; VCode:
; block0:
;   fcmp_set.le r3, f1, f2
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   fcmpu cr0, f1, f2
;   cror cr0eq, cr0lt, cr0eq
;   li r3, 1
;   li r0, 0
;   isel r3, r3, r0, cr0eq
;   blr

function %one(f64, f64) -> i8 {
block0(v0: f64, v1: f64):
    v2 = fcmp one v0, v1
    return v2
}

; VCode:
; block0:
;   fcmp_set.one r3, f1, f2
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   fcmpu cr0, f1, f2
;   cror cr0lt, cr0lt, cr0gt
;   li r3, 1
;   li r0, 0
;   isel r3, r3, r0, cr0lt
;   blr

