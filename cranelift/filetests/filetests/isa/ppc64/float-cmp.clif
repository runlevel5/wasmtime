function %ule(f64, f64) -> i8 {
block0(v0: f64, v1: f64):
    v2 = fcmp ule v0, v1
    return v2
}

; VCode:
; block0:
;   fcmp_set.ule r3, f1, f2
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   fcmpu cr0, f1, f2
;   li r3, 1
;   isel r3, 0, r3, cr0gt
;   blr

function %br_uno(f64, f64) -> i64 {
block0(v0: f64, v1: f64):
    v2 = fcmp uno v0, v1
    brif v2, block1, block2
block1:
    v3 = iconst.i64 1
    return v3
block2:
    v4 = iconst.i64 2
    return v4
}

; VCode:
; block0:
;   fbr.uno f1, f2 # MachLabel(2), MachLabel(1)
; block1:
;   load_const r3, 0x2
;   blr
; block2:
;   load_const r3, 0x1
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   fcmpu cr0, f1, f2
;   bso 0x10
; block1: ; offset 0x8
;   li r3, 2
;   blr
; block2: ; offset 0x10
;   li r3, 1
;   blr

function %br_ge(f64, f64) -> i64 {
block0(v0: f64, v1: f64):
    v2 = fcmp ge v0, v1
    brif v2, block1, block2
block1:
    v3 = iconst.i64 1
    return v3
block2:
    v4 = iconst.i64 2
    return v4
}

; VCode:
; block0:
;   fbr.ge f1, f2 # MachLabel(2), MachLabel(1)
; block1:
;   load_const r3, 0x2
;   blr
; block2:
;   load_const r3, 0x1
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   fcmpu cr0, f1, f2
;   cror cr0eq, cr0gt, cr0eq
;   beq 0x14
; block1: ; offset 0xc
;   li r3, 2
;   blr
; block2: ; offset 0x14
;   li r3, 1
;   blr

