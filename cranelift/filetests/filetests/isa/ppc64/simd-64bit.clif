test compile precise-output
target powerpc64le

function %load_store_i8x8(i8x8, i64) -> i8x8 {
block0(v0: i8x8, v1: i64):
    store.i8x8 v0, v1
    v2 = load.i8x8 v1
    return v2
}

; VCode:
;   mflr r0
;   load_addr sp, -16(sp)
;   std r0, 8(sp)
;   std fp, 0(sp)
;   mr fp, sp
; block0:
;   vec_extract64 r6, v2, lane 1
;   std r6, 0(r5)
;   ld r5, 0(r5)
;   mtvsrd v2, r5
;   ld r0, 8(sp)
;   mtlr r0
;   ld fp, 0(sp)
;   load_addr sp, 16(sp)
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   mflr r0
;   addi r1, r1, -0x10
;   std r0, 8(r1)
;   std r31, 0(r1)
;   ori r31, r1, 0
; block1: ; offset 0x14
;   mfvsrd r6, v2
;   std r6, 0(r5) ; trap: heap_oob
;   ld r5, 0(r5) ; trap: heap_oob
;   mtvsrd v2, r5
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr

function %vall_true_i16x4(i16x4) -> i8 {
block0(v0: i16x4):
