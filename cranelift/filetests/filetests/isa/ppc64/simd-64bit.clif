; VCode:
;   mflr r0
;   load_addr sp, -16(sp)
;   std r0, 8(sp)
;   std fp, 0(sp)
;   mr fp, sp
; block0:
;   vec_zero v3
;   vcmpeq16 v4, v2, v3
;   vec_extract64 r6, v4, lane 1
;   load_const r8, 0x0
;   cmp_set.eq r3, r6, r8
;   ld r0, 8(sp)
;   mtlr r0
;   ld fp, 0(sp)
;   load_addr sp, 16(sp)
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   mflr r0
;   addi r1, r1, -0x10
;   std r0, 8(r1)
;   std r31, 0(r1)
;   ori r31, r1, 0
; block1: ; offset 0x14
;   xxlxor v3, v3, v3
;   vcmpequh v4, v2, v3
;   mfvsrd r6, v4
;   li r8, 0
;   cmpld r6, r8
;   li r3, 1
;   li r0, 0
;   isel r3, r3, r0, cr0eq
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr

