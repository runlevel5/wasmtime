test compile precise-output
target powerpc64le

; The trapping conversions check NaN and both exclusive range bounds
; explicitly: the hardware conversions saturate rather than trap. The
; saturating forms need only the NaN-to-zero fixup.
function %to_sint64(f64) -> i64 {
block0(v0: f64):
    v1 = fcvt_to_sint.i64 v0
    return v1
}

; VCode:
;   mflr r0
;   load_addr sp, -16(sp)
;   std r0, 8(sp)
;   std fp, 0(sp)
;   mr fp, sp
; block0:
;   fcvt_to_sint.i64 r3, f1
;   ld r0, 8(sp)
;   mtlr r0
;   ld fp, 0(sp)
;   load_addr sp, 16(sp)
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   mflr r0
;   addi r1, r1, -0x10
;   std r0, 8(r1)
;   std r31, 0(r1)
;   ori r31, r1, 0
; block1: ; offset 0x14
;   fcmpu cr0, f1, f1
;   bns 0x20
;   .byte 0x00, 0x00, 0x00, 0x00 ; trap: bad_toint
;   lis r3, -0x3c20
;   sldi r3, r3, 0x20
;   ori r3, r3, 1
;   mtvsrd f3, r3
;   fcmpu cr0, f1, f3
;   bgt 0x3c
;   .byte 0x00, 0x00, 0x00, 0x00 ; trap: int_ovf
;   lis r3, 0x43e0
;   sldi r3, r3, 0x20
;   mtvsrd f3, r3
;   fcmpu cr0, f1, f3
;   blt 0x54
;   .byte 0x00, 0x00, 0x00, 0x00 ; trap: int_ovf
;   fctidz f3, f1
;   mffprd r3, f3
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr

function %to_uint32(f64) -> i32 {
block0(v0: f64):
    v1 = fcvt_to_uint.i32 v0
    return v1
}

; VCode:
;   mflr r0
;   load_addr sp, -16(sp)
;   std r0, 8(sp)
;   std fp, 0(sp)
;   mr fp, sp
; block0:
;   fcvt_to_uint.i32 r3, f1
;   ld r0, 8(sp)
;   mtlr r0
;   ld fp, 0(sp)
;   load_addr sp, 16(sp)
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   mflr r0
;   addi r1, r1, -0x10
;   std r0, 8(r1)
;   std r31, 0(r1)
;   ori r31, r1, 0
; block1: ; offset 0x14
;   fcmpu cr0, f1, f1
;   bns 0x20
;   .byte 0x00, 0x00, 0x00, 0x00 ; trap: bad_toint
;   lis r3, -0x4010
;   sldi r3, r3, 0x20
;   mtvsrd f3, r3
;   fcmpu cr0, f1, f3
;   bgt 0x38
;   .byte 0x00, 0x00, 0x00, 0x00 ; trap: int_ovf
;   lis r3, 0x41f0
;   sldi r3, r3, 0x20
;   mtvsrd f3, r3
;   fcmpu cr0, f1, f3
;   blt 0x50
;   .byte 0x00, 0x00, 0x00, 0x00 ; trap: int_ovf
;   fctiwuz f3, f1
;   mffprd r3, f3
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr

function %to_sint32_from_f32(f32) -> i32 {
block0(v0: f32):
    v1 = fcvt_to_sint.i32 v0
    return v1
}

; VCode:
;   mflr r0
;   load_addr sp, -16(sp)
;   std r0, 8(sp)
;   std fp, 0(sp)
;   mr fp, sp
; block0:
;   fcvt_to_sint.i32 r3, f1
;   ld r0, 8(sp)
;   mtlr r0
;   ld fp, 0(sp)
;   load_addr sp, 16(sp)
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   mflr r0
;   addi r1, r1, -0x10
;   std r0, 8(r1)
;   std r31, 0(r1)
;   ori r31, r1, 0
; block1: ; offset 0x14
;   fcmpu cr0, f1, f1
;   bns 0x20
;   .byte 0x00, 0x00, 0x00, 0x00 ; trap: bad_toint
;   lis r3, -0x3e20
;   sldi r3, r3, 0x20
;   oris r3, r3, 0x2000
;   mtvsrd f3, r3
;   fcmpu cr0, f1, f3
;   bgt 0x3c
;   .byte 0x00, 0x00, 0x00, 0x00 ; trap: int_ovf
;   lis r3, 0x41e0
;   sldi r3, r3, 0x20
;   mtvsrd f3, r3
;   fcmpu cr0, f1, f3
;   blt 0x54
;   .byte 0x00, 0x00, 0x00, 0x00 ; trap: int_ovf
;   fctiwz f3, f1
;   mffprd r3, f3
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr

function %to_sint64_sat(f64) -> i64 {
block0(v0: f64):
    v1 = fcvt_to_sint_sat.i64 v0
    return v1
}

; VCode:
;   mflr r0
;   load_addr sp, -16(sp)
;   std r0, 8(sp)
;   std fp, 0(sp)
;   mr fp, sp
; block0:
;   fcvt_to_sint_sat.i64 r3, f1
;   ld r0, 8(sp)
;   mtlr r0
;   ld fp, 0(sp)
;   load_addr sp, 16(sp)
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   mflr r0
;   addi r1, r1, -0x10
;   std r0, 8(r1)
;   std r31, 0(r1)
;   ori r31, r1, 0
; block1: ; offset 0x14
;   fcmpu cr0, f1, f1
;   bns 0x24
;   li r3, 0
;   b 0x2c
;   fctidz f3, f1
;   mffprd r3, f3
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr

function %to_uint64_sat(f32) -> i64 {
block0(v0: f32):
    v1 = fcvt_to_uint_sat.i64 v0
    return v1
}

