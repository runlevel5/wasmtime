;   ori r31, r1, 0
; block1: ; offset 0x14
;   ori r5, r3, 0
;   sync
;   lbarx r3, 0, r5
;   stbcx. r4, 0, r5
;   bne 0x1c
;   isync
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr

function %rmw_smin32(i64, i32) -> i32 {
block0(v0: i64, v1: i32):
    v2 = atomic_rmw.i32 smin v0, v1
    return v2
}

; VCode:
;   mflr r0
;   load_addr sp, -16(sp)
;   std r0, 8(sp)
;   std fp, 0(sp)
;   mr fp, sp
; block0:
;   mr r6, r3
;   sext.32->64 r4, r4
;   atomic_rmw.i32 Smin r3, r4, (r6)
;   ld r0, 8(sp)
;   mtlr r0
;   ld fp, 0(sp)
;   load_addr sp, 16(sp)
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   mflr r0
;   addi r1, r1, -0x10
;   std r0, 8(r1)
;   std r31, 0(r1)
;   ori r31, r1, 0
; block1: ; offset 0x14
;   ori r6, r3, 0
;   extsw r4, r4
;   sync
;   lwarx r3, 0, r6
;   extsw r0, r3
;   cmpd r0, r4
;   isel r0, r3, r4, cr0lt
;   stwcx. r0, 0, r6
;   bne 0x20
;   isync
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr

function %cas16(i64, i16, i16) -> i16 {
block0(v0: i64, v1: i16, v2: i16):
    v3 = atomic_cas.i16 v0, v1, v2
    return v3
}

; VCode:
;   mflr r0
;   load_addr sp, -16(sp)
;   std r0, 8(sp)
;   std fp, 0(sp)
;   mr fp, sp
; block0:
;   mr r7, r3
;   zext.16->64 r4, r4
;   atomic_cas.i16 r3, r4, r5, (r7)
;   ld r0, 8(sp)
;   mtlr r0
;   ld fp, 0(sp)
;   load_addr sp, 16(sp)
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   mflr r0
;   addi r1, r1, -0x10
;   std r0, 8(r1)
;   std r31, 0(r1)
;   ori r31, r1, 0
; block1: ; offset 0x14
;   ori r7, r3, 0
;   clrldi r4, r4, 0x30
;   sync
;   lharx r3, 0, r7
;   cmpld r3, r4
;   bne 0x34
;   sthcx. r5, 0, r7
;   bne 0x20
;   isync
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr

function %fence() {
block0:
    fence
    return
}

