test compile precise-output
target powerpc64le

; Atomic accesses are sequentially consistent: a heavyweight `sync`
; before, and for loads a control dependency (compare + never-taken
; branch) feeding an `isync`, the pattern the kernel and LLVM use.
function %aload32(i64) -> i32 {
block0(v0: i64):
    v1 = atomic_load.i32 v0
    return v1
}

; VCode:
;   mflr r0
;   load_addr sp, -16(sp)
;   std r0, 8(sp)
;   std fp, 0(sp)
;   mr fp, sp
; block0:
;   atomic_load.i32 r3, (r3)
;   ld r0, 8(sp)
;   mtlr r0
;   ld fp, 0(sp)
;   load_addr sp, 16(sp)
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   mflr r0
;   addi r1, r1, -0x10
;   std r0, 8(r1)
;   std r31, 0(r1)
;   ori r31, r1, 0
; block1: ; offset 0x14
;   sync
;   lwzx r3, 0, r3
;   cmpd r3, r3
;   bne 0x24
;   isync
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr

function %astore64(i64, i64) {
block0(v0: i64, v1: i64):
    atomic_store v1, v0
    return
}

; VCode:
;   mflr r0
;   load_addr sp, -16(sp)
;   std r0, 8(sp)
;   std fp, 0(sp)
;   mr fp, sp
; block0:
;   atomic_store.i64 r4, (r3)
;   ld r0, 8(sp)
;   mtlr r0
;   ld fp, 0(sp)
;   load_addr sp, 16(sp)
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   mflr r0
;   addi r1, r1, -0x10
;   std r0, 8(r1)
;   std r31, 0(r1)
;   ori r31, r1, 0
; block1: ; offset 0x14
;   sync
;   stdx r4, 0, r3
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr

function %rmw_add64(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = atomic_rmw.i64 add v0, v1
    return v2
}

; VCode:
;   mflr r0
;   load_addr sp, -16(sp)
;   std r0, 8(sp)
;   std fp, 0(sp)
;   mr fp, sp
; block0:
;   mr r5, r3
;   atomic_rmw.i64 Add r3, r4, (r5)
;   ld r0, 8(sp)
;   mtlr r0
;   ld fp, 0(sp)
;   load_addr sp, 16(sp)
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   mflr r0
;   addi r1, r1, -0x10
;   std r0, 8(r1)
;   std r31, 0(r1)
;   ori r31, r1, 0
; block1: ; offset 0x14
;   ori r5, r3, 0
;   sync
;   ldarx r3, 0, r5
;   add r0, r3, r4
;   stdcx. r0, 0, r5
;   bne 0x1c
;   isync
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr

function %rmw_xchg8(i64, i8) -> i8 {
block0(v0: i64, v1: i8):
    v2 = atomic_rmw.i8 xchg v0, v1
    return v2
}

; VCode:
;   mflr r0
;   load_addr sp, -16(sp)
;   std r0, 8(sp)
;   std fp, 0(sp)
;   mr fp, sp
; block0:
;   mr r5, r3
;   atomic_rmw.i8 Xchg r3, r4, (r5)
;   ld r0, 8(sp)
;   mtlr r0
;   ld fp, 0(sp)
;   load_addr sp, 16(sp)
;   blr
