;   load_addr sp, -16(sp)
;   std r0, 8(sp)
;   std fp, 0(sp)
;   mr fp, sp
;   load_addr sp, -32(sp)
; block0:
;   bl TestCase(%callee)
;   load_addr sp, 32(sp)
;   ld r0, 8(sp)
;   mtlr r0
;   ld fp, 0(sp)
;   load_addr sp, 16(sp)
;   blr
;
