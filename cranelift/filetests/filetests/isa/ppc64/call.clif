function %try_call_direct(i64) -> i64 tail {
    sig0 = (i64) -> i64 tail
    fn0 = colocated %callee(i64) -> i64 tail
block0(v0: i64):
    try_call fn0(v0), sig0, block1(ret0), [ default: block2(exn0) ]
block1(v1: i64):
    return v1
block2(v2: i64):
    return v2
}

