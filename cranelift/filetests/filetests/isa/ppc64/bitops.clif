;   or r11, r3, r0
;   addi r0, r11, -1
;   andc r0, r0, r11
;   popcntd r3, r0
;   blr

function %neg_not(i64) -> i64 {
block0(v0: i64):
    v1 = ineg v0
    v2 = bnot v1
    return v2
}

; VCode:
; block0:
;   neg r3, r3
;   not r3, r3
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   neg r3, r3
;   nor r3, r3, r3
;   blr

