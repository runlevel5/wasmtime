;   load_addr sp, 16(sp)
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   mflr r0
;   addi r1, r1, -0x10
;   std r0, 8(r1)
;   std r31, 0(r1)
;   ori r31, r1, 0
; block1: ; offset 0x14
;   addi r0, r3, -1
