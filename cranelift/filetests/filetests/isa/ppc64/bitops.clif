;   popcntd r3, r0
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr

function %neg_not(i64) -> i64 {
block0(v0: i64):
    v1 = ineg v0
    v2 = bnot v1
    return v2
}

