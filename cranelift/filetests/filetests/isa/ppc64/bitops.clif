test compile precise-output
target powerpc64le

function %clz_i64(i64) -> i64 {
block0(v0: i64):
    v1 = clz v0
    return v1
}

; VCode:
; block0:
;   clz.i64 r3, r3
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   cntlzd r3, r3
;   blr

function %popcnt_i64(i64) -> i64 {
block0(v0: i64):
    v1 = popcnt v0
    return v1
}

; VCode:
; block0:
;   popcnt.i64 r3, r3
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   popcntd r3, r3
;   blr

function %ctz_i64(i64) -> i64 {
block0(v0: i64):
    v1 = ctz v0
    return v1
}

; VCode:
; block0:
;   ctz.i64 r3, r3
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   addi r0, r3, -1
;   andc r0, r0, r3
;   popcntd r3, r0
;   blr

function %ctz_i32(i32) -> i32 {
block0(v0: i32):
    v1 = ctz v0
    return v1
}

; VCode:
; block0:
;   ctz.i32 r3, r3
;   blr
