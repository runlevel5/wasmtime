function %ctz_i64(i64) -> i64 {
block0(v0: i64):
    v1 = ctz v0
    return v1
}

; VCode:
;   mflr r0
;   load_addr sp, -16(sp)
;   std r0, 8(sp)
;   std fp, 0(sp)
;   mr fp, sp
; block0:
;   ctz.i64 r3, r3
