test compile precise-output
target powerpc64le

; The single-precision forms differ from the double ones only in primary
; opcode, and using them is what rounds each f32 result to single precision.
function %arith_f64(f64, f64) -> f64 {
block0(v0: f64, v1: f64):
    v2 = fadd v0, v1
    v3 = fsub v2, v1
    v4 = fmul v3, v0
    v5 = fdiv v4, v1
    return v5
}

; VCode:
;   mflr r0
;   load_addr sp, -16(sp)
;   std r0, 8(sp)
;   std fp, 0(sp)
;   mr fp, sp
; block0:
;   fadd.f64 f6, f1, f2
;   fsub.f64 f6, f6, f2
;   fmul.f64 f6, f6, f1
;   fdiv.f64 f1, f6, f2
;   ld r0, 8(sp)
;   mtlr r0
;   ld fp, 0(sp)
;   load_addr sp, 16(sp)
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   mflr r0
;   addi r1, r1, -0x10
;   std r0, 8(r1)
;   std r31, 0(r1)
;   ori r31, r1, 0
; block1: ; offset 0x14
;   fadd f6, f1, f2
;   fsub f6, f6, f2
;   fmul f6, f6, f1
;   fdiv f1, f6, f2
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr

function %arith_f32(f32, f32) -> f32 {
block0(v0: f32, v1: f32):
    v2 = fadd v0, v1
    v3 = fmul v2, v1
    return v3
}

; VCode:
;   mflr r0
;   load_addr sp, -16(sp)
;   std r0, 8(sp)
;   std fp, 0(sp)
;   mr fp, sp
; block0:
;   fadd.f32 f4, f1, f2
;   fmul.f32 f1, f4, f2
;   ld r0, 8(sp)
;   mtlr r0
;   ld fp, 0(sp)
;   load_addr sp, 16(sp)
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   mflr r0
;   addi r1, r1, -0x10
;   std r0, 8(r1)
;   std r31, 0(r1)
;   ori r31, r1, 0
; block1: ; offset 0x14
;   fadds f4, f1, f2
;   fmuls f1, f4, f2
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr

function %unary(f64) -> f64 {
block0(v0: f64):
    v1 = fneg v0
    v2 = fabs v1
    v3 = sqrt v2
    return v3
}

; VCode:
;   mflr r0
;   load_addr sp, -16(sp)
;   std r0, 8(sp)
;   std fp, 0(sp)
;   mr fp, sp
; block0:
;   fneg.f64 f4, f1
;   fabs.f64 f4, f4
;   fsqrt.f64 f1, f4
;   ld r0, 8(sp)
;   mtlr r0
;   ld fp, 0(sp)
;   load_addr sp, 16(sp)
;   blr
