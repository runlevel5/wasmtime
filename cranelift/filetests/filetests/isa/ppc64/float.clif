;   addi r1, r1, 0x10
;   blr

function %consts() -> f64 {
block0:
    v0 = f64const 0x1.5p3
    v1 = f32const 0x1.0p1
    v2 = fpromote.f64 v1
    v3 = fadd v0, v2
    return v3
}

; VCode:
;   mflr r0
;   load_addr sp, -16(sp)
;   std r0, 8(sp)
;   std fp, 0(sp)
;   mr fp, sp
; block0:
;   load_const r4, 0x4025000000000000
;   mtvsrd f6, r4
;   load_const r4, 0x4000000000000000
;   mtvsrd f7, r4
;   fmr.f64 f5, f7
;   fadd.f64 f1, f6, f5
;   ld r0, 8(sp)
;   mtlr r0
;   ld fp, 0(sp)
;   load_addr sp, 16(sp)
;   blr
;
; Disassembled:
; block0: ; offset 0x0
;   mflr r0
;   addi r1, r1, -0x10
;   std r0, 8(r1)
;   std r31, 0(r1)
;   ori r31, r1, 0
; block1: ; offset 0x14
;   lis r4, 0x4025
;   sldi r4, r4, 0x20
;   mtvsrd f6, r4
;   lis r4, 0x4000
;   sldi r4, r4, 0x20
;   mtvsrd f7, r4
;   fmr f5, f7
;   fadd f1, f6, f5
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr

function %promote_demote(f64) -> f64 {
block0(v0: f64):
    v1 = fdemote.f32 v0
    v2 = fpromote.f64 v1
    return v2
}

