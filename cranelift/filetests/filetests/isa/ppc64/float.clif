;   ori r31, r1, 0
; block1: ; offset 0x14
;   frsp f3, f1
;   fmr f1, f3
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr

function %bitcast_f64(f64) -> i64 {
block0(v0: f64):
    v1 = bitcast.i64 v0
    v2 = bitcast.f64 v1
    v3 = bitcast.i64 v2
    return v3
}

