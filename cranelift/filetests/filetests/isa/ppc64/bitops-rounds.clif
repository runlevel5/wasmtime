; block0: ; offset 0x0
;   mflr r0
;   addi r1, r1, -0x10
;   std r0, 8(r1)
;   std r31, 0(r1)
;   ori r31, r1, 0
; block1: ; offset 0x14
;   extsw r3, r3
;   li r4, 0x3f
;   srad r6, r3, r4
;   xor r8, r3, r6
;   cntlzd r10, r8
;   addi r3, r10, -0x21
;   ld r0, 8(r1)
;   mtlr r0
;   ld r31, 0(r1)
;   addi r1, r1, 0x10
;   blr

