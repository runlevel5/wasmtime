; run: %imul_i8x16([3 -4 5 -6 7 -8 9 127 -128 11 -12 13 -14 15 -16 17], [7 9 -11 13 -15 17 -19 3 -1 21 -23 25 -27 29 -31 33]) == [21 -36 -55 -78 -105 120 85 125 -128 -25 20 69 122 -77 -16 49]

