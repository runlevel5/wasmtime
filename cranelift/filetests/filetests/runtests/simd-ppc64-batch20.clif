test interpret
test run
target powerpc64le
target powerpc64le has_isa_3_0

;; Exhaustive lane-index sweep. Every lane of every integer vector
;; type, both directions. The lowering translates CLIF's
;; little-endian lane index into a big-endian element number, so an
;; off-by-one or a reflection error shows up at one index and not
;; others -- which sampling a few indices would miss.

function %ex_i8x16_0(i8x16) -> i8 {
block0(v0: i8x16):
    v1 = extractlane v0, 0
    return v1
}
; run: %ex_i8x16_0([1 8 15 22 29 36 43 50 57 64 71 78 85 92 99 106]) == 1

function %ex_i8x16_1(i8x16) -> i8 {
block0(v0: i8x16):
    v1 = extractlane v0, 1
    return v1
}
; run: %ex_i8x16_1([1 8 15 22 29 36 43 50 57 64 71 78 85 92 99 106]) == 8

