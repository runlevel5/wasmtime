test interpret
test run
target powerpc64le
target powerpc64le has_isa_3_0

;; Vector minimum and maximum. The hardware instructions are already
;; right about signed zeros and infinities; what they get wrong is the
;; quiet-NaN case, where they return the numeric operand instead of a
;; NaN. So the NaN lanes are the point of these tests, and they appear
;; in both operand positions because the hardware's wrong answer is
;; asymmetric in exactly that way.

function %fmin_f32x4(f32x4, f32x4) -> f32x4 {
block0(v0: f32x4, v1: f32x4):
    v2 = fmin v0, v1
    return v2
}
; run: %fmin_f32x4([0x1.0 0x2.0 -0x1.0 0x0.0], [0x2.0 0x1.0 0x1.0 0x1.0]) == [0x1.0 0x1.0 -0x1.0 0x0.0]
; run: %fmin_f32x4([Inf -Inf 0x1.0 -Inf], [-Inf Inf -Inf Inf]) == [-Inf -Inf -Inf -Inf]

function %fmax_f32x4(f32x4, f32x4) -> f32x4 {
block0(v0: f32x4, v1: f32x4):
    v2 = fmax v0, v1
    return v2
}
; run: %fmax_f32x4([0x1.0 0x2.0 -0x1.0 0x0.0], [0x2.0 0x1.0 0x1.0 0x1.0]) == [0x2.0 0x2.0 0x1.0 0x1.0]
; run: %fmax_f32x4([Inf -Inf 0x1.0 -Inf], [-Inf Inf -Inf Inf]) == [Inf Inf 0x1.0 Inf]

function %fmin_f64x2(f64x2, f64x2) -> f64x2 {
block0(v0: f64x2, v1: f64x2):
    v2 = fmin v0, v1
    return v2
}
; run: %fmin_f64x2([0x1.0 0x2.0], [0x2.0 0x1.0]) == [0x1.0 0x1.0]
; run: %fmin_f64x2([Inf -Inf], [-Inf Inf]) == [-Inf -Inf]

function %fmax_f64x2(f64x2, f64x2) -> f64x2 {
block0(v0: f64x2, v1: f64x2):
    v2 = fmax v0, v1
    return v2
}
; run: %fmax_f64x2([0x1.0 0x2.0], [0x2.0 0x1.0]) == [0x2.0 0x2.0]
; run: %fmax_f64x2([Inf -Inf], [-Inf Inf]) == [Inf Inf]

;; Signed zeros: -0 counts as below +0, and the answer must not depend
;; on which operand it arrived in. The hardware gets this right on its
;; own, so these guard the fixup against breaking it.
function %fmin_zeros_f32x4(f32x4, f32x4) -> f32x4 {
block0(v0: f32x4, v1: f32x4):
    v2 = fmin v0, v1
    return v2
}
; run: %fmin_zeros_f32x4([-0x0.0 0x0.0 -0x0.0 0x0.0], [0x0.0 -0x0.0 -0x0.0 0x0.0]) == [-0x0.0 -0x0.0 -0x0.0 0x0.0]

function %fmax_zeros_f32x4(f32x4, f32x4) -> f32x4 {
block0(v0: f32x4, v1: f32x4):
    v2 = fmax v0, v1
    return v2
}
; run: %fmax_zeros_f32x4([-0x0.0 0x0.0 -0x0.0 0x0.0], [0x0.0 -0x0.0 -0x0.0 0x0.0]) == [0x0.0 0x0.0 -0x0.0 0x0.0]

function %fmin_zeros_f64x2(f64x2, f64x2) -> f64x2 {
block0(v0: f64x2, v1: f64x2):
    v2 = fmin v0, v1
    return v2
}
; run: %fmin_zeros_f64x2([-0x0.0 0x0.0], [0x0.0 -0x0.0]) == [-0x0.0 -0x0.0]

function %fmax_zeros_f64x2(f64x2, f64x2) -> f64x2 {
block0(v0: f64x2, v1: f64x2):
    v2 = fmax v0, v1
    return v2
}
; run: %fmax_zeros_f64x2([-0x0.0 0x0.0], [0x0.0 -0x0.0]) == [0x0.0 0x0.0]

;; NaN in either operand must give a NaN, and the payload must be the
;; propagated one rather than an arbitrary quiet NaN -- the sum of the
;; operands is what supplies it. Comparing the raw bits is the only way
;; to see the payload, so the results go through a bitcast.
function %fmin_nan_bits_f64x2(f64x2, f64x2) -> i64x2 {
block0(v0: f64x2, v1: f64x2):
    v2 = fmin v0, v1
    v3 = bitcast.i64x2 little v2
    return v3
}
; run: %fmin_nan_bits_f64x2([+NaN 0x1.0], [0x1.0 +NaN]) == [0x7ff8000000000000 0x7ff8000000000000]
; run: %fmin_nan_bits_f64x2([+NaN +NaN], [+NaN 0x1.0]) == [0x7ff8000000000000 0x7ff8000000000000]

function %fmax_nan_bits_f64x2(f64x2, f64x2) -> i64x2 {
block0(v0: f64x2, v1: f64x2):
    v2 = fmax v0, v1
    v3 = bitcast.i64x2 little v2
    return v3
}
; run: %fmax_nan_bits_f64x2([+NaN 0x1.0], [0x1.0 +NaN]) == [0x7ff8000000000000 0x7ff8000000000000]

function %fmin_nan_bits_f32x4(f32x4, f32x4) -> i32x4 {
block0(v0: f32x4, v1: f32x4):
    v2 = fmin v0, v1
    v3 = bitcast.i32x4 little v2
    return v3
}
; run: %fmin_nan_bits_f32x4([+NaN 0x1.0 +NaN 0x2.0], [0x1.0 +NaN +NaN 0x3.0]) == [0x7fc00000 0x7fc00000 0x7fc00000 0x40000000]

function %fmax_nan_bits_f32x4(f32x4, f32x4) -> i32x4 {
block0(v0: f32x4, v1: f32x4):
    v2 = fmax v0, v1
    v3 = bitcast.i32x4 little v2
    return v3
}
; run: %fmax_nan_bits_f32x4([+NaN 0x1.0 +NaN 0x2.0], [0x1.0 +NaN +NaN 0x3.0]) == [0x7fc00000 0x7fc00000 0x7fc00000 0x40400000]

;; A NaN lane must not disturb its neighbours: the fixup is a bitwise
;; select, so a mask built at the wrong width would corrupt them.
function %fmin_mixed_f32x4(f32x4, f32x4) -> i32x4 {
block0(v0: f32x4, v1: f32x4):
    v2 = fmin v0, v1
    v3 = bitcast.i32x4 little v2
    return v3
}
; run: %fmin_mixed_f32x4([+NaN 0x2.0 0x5.0 +NaN], [0x1.0 0x3.0 0x4.0 0x6.0]) == [0x7fc00000 0x40000000 0x40800000 0x7fc00000]
