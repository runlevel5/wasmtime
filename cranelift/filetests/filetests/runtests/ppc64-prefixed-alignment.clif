test interpret
test run
target powerpc64le has_isa_3_0 has_isa_3_1

;; ISA 3.1 prefixed instructions must not cross a 64-byte boundary, so
;; the emitter pads with a `nop` when one would start in the last word of
;; a block. Each function below puts a different number of filler
;; instructions (one per step, alternating `iadd` and `rotl` by a
;; constant, so nothing folds) ahead of a `br_table` (`paddi` for the
;; table address) or a `func_addr` (`pld`), sweeping the prefix across
;; every word offset within a 64-byte block -- including the one that
;; needs padding -- and executing each.

function %callee(i64) -> i64 {
block0(v0: i64):
    v1 = iconst.i64 10
    v2 = iadd v0, v1
    return v2
}

function %br_table_0(i64, i64, i32) -> i64 {
block0(v0: i64, v1: i64, v2: i32):
    v3 = iconst.i64 1
    br_table v2, block4, [block1, block2, block3]
block1:
    v101 = iconst.i64 1
    v111 = iadd v0, v101
    return v111
block2:
    v102 = iconst.i64 2
    v112 = iadd v0, v102
    return v112
block3:
    v103 = iconst.i64 3
    v113 = iadd v0, v103
    return v113
block4:
    v104 = iconst.i64 4
    v114 = iadd v0, v104
    return v114
}

; run: %br_table_0(81985529216486895, 4369, 0) == 81985529216486896
; run: %br_table_0(81985529216486895, 4369, 1) == 81985529216486897
; run: %br_table_0(81985529216486895, 4369, 2) == 81985529216486898
; run: %br_table_0(81985529216486895, 4369, 3) == 81985529216486899
; run: %br_table_0(81985529216486895, 4369, 99) == 81985529216486899

function %func_addr_0(i64, i64) -> i64 {
    fn0 = %callee(i64) -> i64

block0(v0: i64, v1: i64):
    v3 = iconst.i64 1
    v200 = func_addr.i64 fn0
    v201 = call_indirect sig0, v200(v0)
    return v201
}

; run: %func_addr_0(81985529216486895, 4369) == 81985529216486905

function %br_table_1(i64, i64, i32) -> i64 {
block0(v0: i64, v1: i64, v2: i32):
    v3 = iconst.i64 1
    v10 = iadd v0, v1
    br_table v2, block4, [block1, block2, block3]
block1:
    v101 = iconst.i64 1
    v111 = iadd v10, v101
    return v111
block2:
    v102 = iconst.i64 2
    v112 = iadd v10, v102
    return v112
block3:
    v103 = iconst.i64 3
    v113 = iadd v10, v103
    return v113
block4:
    v104 = iconst.i64 4
    v114 = iadd v10, v104
    return v114
}

