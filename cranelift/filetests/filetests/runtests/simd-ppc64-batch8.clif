test run
target powerpc64le
target powerpc64le has_isa_3_0

function %imul_i64x2(i64x2, i64x2) -> i64x2 {
block0(v0: i64x2, v1: i64x2):
    v2 = imul v0, v1
    return v2
}
; run: %imul_i64x2([3 5], [7 11]) == [21 55]
; run: %imul_i64x2([0 1], [12345 0]) == [0 0]
;; Exercises every term of the decomposition: low*low, both cross
;; products, and the discarded high*high.
; run: %imul_i64x2([0x0000000100000000 0x0000000100000001], [0x0000000100000000 0x0000000100000001]) == [0 0x0000000200000001]
; run: %imul_i64x2([0xffffffffffffffff 0x123456789abcdef0], [0xffffffffffffffff 2]) == [1 0x2468acf13579bde0]
; run: %imul_i64x2([0x00000000ffffffff 0xffffffff00000000], [0x00000000ffffffff 0x0000000000000002]) == [0xfffffffe00000001 0xfffffffe00000000]
; run: %imul_i64x2([0x7fffffffffffffff -1], [3 -1]) == [0x7ffffffffffffffd 1]
