function %imul_i16x8(i16x8, i16x8) -> i16x8 {
block0(v0: i16x8, v1: i16x8):
    v2 = imul v0, v1
    return v2
}
; run: %imul_i16x8([1 2 3 4 5 6 7 8], [10 20 30 40 50 60 70 80]) == [10 40 90 160 250 360 490 640]
; run: %imul_i16x8([0x1000 -1 0x7fff 2 0 1 -1 -1], [0x10 -1 2 0x4000 5 1 1 -1]) == [0 1 -2 -32768 0 1 -1 1]

function %imul_i32x4(i32x4, i32x4) -> i32x4 {
block0(v0: i32x4, v1: i32x4):
    v2 = imul v0, v1
    return v2
}
; run: %imul_i32x4([1 2 3 4], [100 200 300 400]) == [100 400 900 1600]
; run: %imul_i32x4([0x10000 -1 0x7fffffff 0], [0x10000 -1 2 12345]) == [0 1 -2 0]

function %sqmul_i16x8(i16x8, i16x8) -> i16x8 {
block0(v0: i16x8, v1: i16x8):
    v2 = sqmul_round_sat v0, v1
    return v2
}
; run: %sqmul_i16x8([0x4000 0x4000 0 0 0 0 0 0], [0x4000 0x2000 0 0 0 0 0 0]) == [0x2000 0x1000 0 0 0 0 0 0]
