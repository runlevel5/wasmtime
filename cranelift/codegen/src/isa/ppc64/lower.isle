;; ppc64le instruction selection: CLIF to MachInst lowering.
;;
;; Scope so far: integer ALU ops, constants, extensions, shifts, bit
;; counting, division and remainder, selects, loads/stores, comparisons,
;; control flow, calls, and traps. Floating point, i128 and vectors are
;; not yet lowered and fall through to a "cannot lower" error.

;; The main lowering constructor term: takes a clif `Inst` and returns the
;; register(s) within which the lowered instruction's result values live.
(decl partial lower (Inst) InstOutput)

;; Branch lowering, with a list of block targets.
(decl partial lower_branch (Inst MachLabelSlice) Unit)

;;;; Rules for `iconst` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (iconst ty (u64_from_imm64 n)))
  (output_reg (imm ty n)))

;;;; Rules for integer ALU ops ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; `add`/`subf`/logicals operate on the full 64-bit register; for narrower
;; integer types the low bits are correct and the high bits are allowed to
;; be garbage, per Cranelift's value conventions.
(rule (lower (iadd (fits_in_64 (ty_int _)) x y))
  (output_reg (ppc_add (put_in_reg x) (put_in_reg y))))

(rule (lower (isub (fits_in_64 (ty_int _)) x y))
  (output_reg (ppc_sub (put_in_reg x) (put_in_reg y))))

(rule (lower (band (fits_in_64 (ty_int _)) x y))
  (output_reg (ppc_and (put_in_reg x) (put_in_reg y))))

(rule (lower (bor (fits_in_64 (ty_int _)) x y))
  (output_reg (ppc_or (put_in_reg x) (put_in_reg y))))

(rule (lower (bxor (fits_in_64 (ty_int _)) x y))
  (output_reg (ppc_xor (put_in_reg x) (put_in_reg y))))

(rule (lower (imul (fits_in_64 (ty_int _)) x y))
  (output_reg (ppc_mulld (put_in_reg x) (put_in_reg y))))

;; `addi` when one operand is a constant in signed-16-bit range.
(rule 1 (lower (iadd (fits_in_64 (ty_int _)) x (iconst _ n)))
  (if-let imm (simm16_from_imm64 n))
  (output_reg (alu_rr_imm16 (AluImmOp.Addi) (put_in_reg x) imm)))

(rule 2 (lower (iadd (fits_in_64 (ty_int _)) (iconst _ n) y))
  (if-let imm (simm16_from_imm64 n))
  (output_reg (alu_rr_imm16 (AluImmOp.Addi) (put_in_reg y) imm)))

;;;; Rules for `smulhi` / `umulhi` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule 1 (lower (smulhi $I64 x y))
  (output_reg (ppc_mulhd (put_in_reg x) (put_in_reg y))))
(rule 1 (lower (umulhi $I64 x y))
  (output_reg (ppc_mulhdu (put_in_reg x) (put_in_reg y))))

;; The word forms give the high half of a *32-bit* product, which is
;; what `i32` asks for and needs no narrowing of the operands.
(rule 1 (lower (smulhi $I32 x y))
  (output_reg (ppc_mulhw (put_in_reg x) (put_in_reg y))))
(rule 1 (lower (umulhi $I32 x y))
  (output_reg (ppc_mulhwu (put_in_reg x) (put_in_reg y))))

;; For a narrower type the wanted half is the high half of *that*
;; width, not of a word: `umulhi.i8(255, 255)` is 0xFE01 >> 8, and
;; taking a word's high half would give zero. So the operands are
;; extended, the whole product formed -- two extended 16-bit values
;; cannot overflow a doubleword -- and shifted down by the type's
;; width. The bits left above the result are outside the type and so
;; are don't-care.
(rule 0 (lower (smulhi (fits_in_16 ty) x y))
  (output_reg
    (gen_shift (ShiftOp.Srad)
               (ppc_mulld (ext_to_64 x ty true) (ext_to_64 y ty true))
               (imm $I64 (ty_bits_u64 ty)))))
(rule 0 (lower (umulhi (fits_in_16 ty) x y))
  (output_reg
    (gen_shift (ShiftOp.Srd)
               (ppc_mulld (ext_to_64 x ty false) (ext_to_64 y ty false))
               (imm $I64 (ty_bits_u64 ty)))))

;;;; Rules for `bmask` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; All ones when the input is non-zero, all zeros otherwise.
(rule (lower (bmask (fits_in_64 (ty_int _)) val @ (value_type (fits_in_64 in_ty))))
  (output_reg
    (gen_select (int_compare (IntCC.NotEqual)
                             (put_in_cmp_reg val (IntCC.NotEqual) in_ty)
                             (imm $I64 0)
                             in_ty)
                (imm $I64 0xffffffffffffffff)
                (imm $I64 0))))

;;;; Rules for `ineg` / `bnot` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (ineg (fits_in_64 (ty_int _)) x))
  (output_reg (gen_unary (UnaryOp.Neg) (put_in_reg x))))

(rule (lower (bnot (fits_in_64 (ty_int _)) x))
  (output_reg (gen_unary (UnaryOp.Not) (put_in_reg x))))

;;;; Rules for shifts ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Left shifts need no input narrowing: the low bits of the result depend
;; only on the low bits of the input.
(rule 1 (lower (ishl $I64 x y))
  (output_reg (gen_shift (ShiftOp.Sld) (put_in_reg x) (mask_shift_amount y $I64))))

(rule 0 (lower (ishl (fits_in_32 ty) x y))
  (output_reg (gen_shift (ShiftOp.Slw) (put_in_reg x) (mask_shift_amount y ty))))

;; `srd`/`srad` read the whole register and `srw`/`sraw` read the whole low
;; word, so i64 and i32 need no narrowing; anything narrower does, since
;; the bits above the type's width are allowed to be garbage and would
;; otherwise be shifted into the result.
(rule 2 (lower (ushr $I64 x y))
  (output_reg (gen_shift (ShiftOp.Srd) (put_in_reg x) (mask_shift_amount y $I64))))

(rule 1 (lower (ushr $I32 x y))
  (output_reg (gen_shift (ShiftOp.Srw) (put_in_reg x) (mask_shift_amount y $I32))))

(rule 0 (lower (ushr (fits_in_16 ty) x y))
  (output_reg
    (gen_shift (ShiftOp.Srw)
               (gen_extend (put_in_reg x) false (ty_bits ty) 64)
               (mask_shift_amount y ty))))

(rule 2 (lower (sshr $I64 x y))
  (output_reg (gen_shift (ShiftOp.Srad) (put_in_reg x) (mask_shift_amount y $I64))))

(rule 1 (lower (sshr $I32 x y))
  (output_reg (gen_shift (ShiftOp.Sraw) (put_in_reg x) (mask_shift_amount y $I32))))

(rule 0 (lower (sshr (fits_in_16 ty) x y))
  (output_reg
    (gen_shift (ShiftOp.Sraw)
               (gen_extend (put_in_reg x) true (ty_bits ty) 64)
               (mask_shift_amount y ty))))

;; A constant shift amount uses the rotate-and-mask immediate forms,
;; saving the `li` that materializing the amount into a register would
;; need. wasm only has 32- and 64-bit shifts, so the narrower types keep
;; to the register path.
(rule 5 (lower (ishl $I64 x (iconst _ (u64_from_imm64 n))))
  (output_reg (gen_shift_imm (ShiftOp.Sld) (put_in_reg x) (shift_imm n $I64))))
(rule 5 (lower (ishl $I32 x (iconst _ (u64_from_imm64 n))))
  (output_reg (gen_shift_imm (ShiftOp.Slw) (put_in_reg x) (shift_imm n $I32))))
(rule 5 (lower (ushr $I64 x (iconst _ (u64_from_imm64 n))))
  (output_reg (gen_shift_imm (ShiftOp.Srd) (put_in_reg x) (shift_imm n $I64))))
(rule 5 (lower (ushr $I32 x (iconst _ (u64_from_imm64 n))))
  (output_reg (gen_shift_imm (ShiftOp.Srw) (put_in_reg x) (shift_imm n $I32))))
(rule 5 (lower (sshr $I64 x (iconst _ (u64_from_imm64 n))))
  (output_reg (gen_shift_imm (ShiftOp.Srad) (put_in_reg x) (shift_imm n $I64))))
(rule 5 (lower (sshr $I32 x (iconst _ (u64_from_imm64 n))))
  (output_reg (gen_shift_imm (ShiftOp.Sraw) (put_in_reg x) (shift_imm n $I32))))

;;;; Rules for `rotl` / `rotr` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; The rotate instructions mask the amount to the width themselves, and a
;; right-rotation is a left-rotation by the negated amount (which the
;; hardware masking reduces mod the width).
(rule (lower (rotl $I64 x y))
  (output_reg (gen_shift (ShiftOp.Rotld) (put_in_reg x) (shift_amt_64 y))))

(rule (lower (rotl $I32 x y))
  (output_reg (gen_shift (ShiftOp.Rotlw) (put_in_reg x) (shift_amt_64 y))))

(rule (lower (rotr $I64 x y))
  (output_reg (gen_shift (ShiftOp.Rotld) (put_in_reg x)
                         (gen_unary (UnaryOp.Neg) (shift_amt_64 y)))))

(rule (lower (rotr $I32 x y))
  (output_reg (gen_shift (ShiftOp.Rotlw) (put_in_reg x)
                         (gen_unary (UnaryOp.Neg) (shift_amt_64 y)))))

;; There is no narrow rotate instruction: zero-extend the value so the
;; wrap-around bits are in a known place, then combine a left and a
;; right shift. For rotl by n (mod the width): v << n | v >> (width-n);
;; when n = 0 the right shift is by the full width, which `srw` (a
;; 32-bit shift of a value at most 16 bits wide) turns into zero.
(decl narrow_rot (bool Value Value Type) Reg)
(rule (narrow_rot true x y ty)
  (let ((v Reg (gen_extend (put_in_reg x) false (ty_bits ty) 64))
        (n Reg (mask_shift_amount y ty))
        (back Reg (ppc_sub (imm $I64 (ty_bits_u64 ty)) n)))
    (ppc_or (gen_shift (ShiftOp.Slw) v n)
            (gen_shift (ShiftOp.Srw) v back))))
(rule (narrow_rot false x y ty)
  (let ((v Reg (gen_extend (put_in_reg x) false (ty_bits ty) 64))
        (n Reg (mask_shift_amount y ty))
        (back Reg (ppc_sub (imm $I64 (ty_bits_u64 ty)) n)))
    (ppc_or (gen_shift (ShiftOp.Srw) v n)
            (gen_shift (ShiftOp.Slw) v back))))

(rule 1 (lower (rotl (fits_in_16 ty) x y))
  (output_reg (narrow_rot true x y ty)))

(rule 1 (lower (rotr (fits_in_16 ty) x y))
  (output_reg (narrow_rot false x y ty)))

(rule 5 (lower (rotl $I64 x (iconst _ (u64_from_imm64 n))))
  (output_reg (gen_shift_imm (ShiftOp.Rotld) (put_in_reg x) (shift_imm n $I64))))
(rule 5 (lower (rotl $I32 x (iconst _ (u64_from_imm64 n))))
  (output_reg (gen_shift_imm (ShiftOp.Rotlw) (put_in_reg x) (shift_imm n $I32))))

;; A right rotate by n is a left rotate by (width - n) mod width.
(rule 5 (lower (rotr $I64 x (iconst _ (u64_from_imm64 n))))
  (output_reg (gen_shift_imm (ShiftOp.Rotld) (put_in_reg x) (rot_imm_neg n $I64))))
(rule 5 (lower (rotr $I32 x (iconst _ (u64_from_imm64 n))))
  (output_reg (gen_shift_imm (ShiftOp.Rotlw) (put_in_reg x) (rot_imm_neg n $I32))))

;;;; Rules for bit counting ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule 1 (lower (clz (ty_32_or_64 ty) x))
  (output_reg (gen_bitcount (BitOp.Clz) (put_in_reg x) ty)))

(rule 1 (lower (ctz (ty_32_or_64 ty) x))
  (output_reg (gen_bitcount (BitOp.Ctz) (put_in_reg x) ty)))

(rule 1 (lower (popcnt (ty_32_or_64 ty) x))
  (output_reg (gen_bitcount (BitOp.Popcnt) (put_in_reg x) ty)))

;; Narrower than a word: zero-extend and work in 64 bits. Leading zeros
;; then need the extension's width subtracting off, and trailing zeros
;; need a bit set just above the value so a zero input reports the type's
;; width rather than 64.
(rule 0 (lower (clz (fits_in_16 ty) x))
  (output_reg
    (alu_rr_imm16 (AluImmOp.Addi)
                  (gen_bitcount (BitOp.Clz)
                                (gen_extend (put_in_reg x) false (ty_bits ty) 64)
                                $I64)
                  (clz_narrow_adjust ty))))

(rule 0 (lower (ctz (fits_in_16 ty) x))
  (output_reg
    (gen_bitcount (BitOp.Ctz)
                  (ppc_or (gen_extend (put_in_reg x) false (ty_bits ty) 64)
                          (imm $I64 (ty_width_bit ty)))
                  $I64)))

(rule 0 (lower (popcnt (fits_in_16 ty) x))
  (output_reg
    (gen_bitcount (BitOp.Popcnt)
                  (gen_extend (put_in_reg x) false (ty_bits ty) 64)
                  $I64)))

;; `-(64 - bits)` as a 16-bit immediate, for the `addi` above.
(decl cls_adjust (Type) u16)
(extern constructor cls_adjust cls_adjust)

(decl clz_narrow_adjust (Type) u16)
(extern constructor clz_narrow_adjust clz_narrow_adjust)

;; `1 << bits`, the bit just above a narrow value.
(decl ty_width_bit (Type) u64)
(extern constructor ty_width_bit ty_width_bit)

;;;; Rules for division and remainder ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule 1 (lower (sdiv (ty_32_or_64 ty) x y))
  (output_reg (gen_divrem (DivOp.SDiv) (put_in_reg x) (put_in_reg y) ty)))

(rule 1 (lower (udiv (ty_32_or_64 ty) x y))
  (output_reg (gen_divrem (DivOp.UDiv) (put_in_reg x) (put_in_reg y) ty)))

(rule 1 (lower (srem (ty_32_or_64 ty) x y))
  (output_reg (gen_divrem (DivOp.SRem) (put_in_reg x) (put_in_reg y) ty)))

(rule 1 (lower (urem (ty_32_or_64 ty) x y))
  (output_reg (gen_divrem (DivOp.URem) (put_in_reg x) (put_in_reg y) ty)))

;; Narrower than a word: extend both operands to a full word (matching the
;; operation's signedness) and divide there. The divide-by-zero and
;; overflow checks the word form performs remain correct, since the
;; extended values span the same numeric range.
(rule 0 (lower (sdiv (fits_in_16 ty) x y))
  (output_reg (gen_divrem (DivOp.SDiv)
                          (gen_extend (put_in_reg x) true (ty_bits ty) 64)
                          (gen_extend (put_in_reg y) true (ty_bits ty) 64)
                          $I32)))

(rule 0 (lower (udiv (fits_in_16 ty) x y))
  (output_reg (gen_divrem (DivOp.UDiv)
                          (gen_extend (put_in_reg x) false (ty_bits ty) 64)
                          (gen_extend (put_in_reg y) false (ty_bits ty) 64)
                          $I32)))

(rule 0 (lower (srem (fits_in_16 ty) x y))
  (output_reg (gen_divrem (DivOp.SRem)
                          (gen_extend (put_in_reg x) true (ty_bits ty) 64)
                          (gen_extend (put_in_reg y) true (ty_bits ty) 64)
                          $I32)))

(rule 0 (lower (urem (fits_in_16 ty) x y))
  (output_reg (gen_divrem (DivOp.URem)
                          (gen_extend (put_in_reg x) false (ty_bits ty) 64)
                          (gen_extend (put_in_reg y) false (ty_bits ty) 64)
                          $I32)))

;;;; Rules for integer `smin`/`smax`/`umin`/`umax` ;;;;;;;;;;;;;;;;;;;;;;;;;

;; A compare feeding `isel`. The comparison inputs are extended when
;; narrower than a word; the selected values keep their original
;; registers, whose low bits are the payload either way.
(rule (lower (smin (fits_in_64 (ty_int ty)) x y))
  (output_reg (gen_select (int_compare (IntCC.SignedLessThan)
                                       (put_in_cmp_reg x (IntCC.SignedLessThan) ty)
                                       (put_in_cmp_reg y (IntCC.SignedLessThan) ty)
                                       ty)
                          (put_in_reg x) (put_in_reg y))))

(rule (lower (smax (fits_in_64 (ty_int ty)) x y))
  (output_reg (gen_select (int_compare (IntCC.SignedGreaterThan)
                                       (put_in_cmp_reg x (IntCC.SignedGreaterThan) ty)
                                       (put_in_cmp_reg y (IntCC.SignedGreaterThan) ty)
                                       ty)
                          (put_in_reg x) (put_in_reg y))))

(rule (lower (umin (fits_in_64 (ty_int ty)) x y))
  (output_reg (gen_select (int_compare (IntCC.UnsignedLessThan)
                                       (put_in_cmp_reg x (IntCC.UnsignedLessThan) ty)
                                       (put_in_cmp_reg y (IntCC.UnsignedLessThan) ty)
                                       ty)
                          (put_in_reg x) (put_in_reg y))))

(rule (lower (umax (fits_in_64 (ty_int ty)) x y))
  (output_reg (gen_select (int_compare (IntCC.UnsignedGreaterThan)
                                       (put_in_cmp_reg x (IntCC.UnsignedGreaterThan) ty)
                                       (put_in_cmp_reg y (IntCC.UnsignedGreaterThan) ty)
                                       ty)
                          (put_in_reg x) (put_in_reg y))))

;;;; Rules for `uadd_overflow_trap` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Unsigned overflow occurred iff the sum is less than either operand.
;; The comparison width matches the type, so upper-bit garbage in narrow
;; inputs cannot affect the verdict.
(rule (lower (uadd_overflow_trap (ty_32_or_64 ty) x y tc))
  (let ((xr Reg (put_in_reg x))
        (sum Reg (ppc_add xr (put_in_reg y)))
        (_ Unit (emit_side_effect
                  (gen_trapif (int_compare (IntCC.UnsignedLessThan) sum xr ty) tc))))
    (output_reg sum)))

;;;; Rules for `select` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Fuse an `icmp` condition into the select's compare.
(rule 1 (lower (select (fits_in_64 (ty_int _))
                       (maybe_uextend (icmp _ cc a @ (value_type (fits_in_64 in_ty)) b))
                       x y))
  (output_reg
    (gen_select (int_compare cc
                             (put_in_cmp_reg a cc in_ty)
                             (put_in_cmp_reg b cc in_ty)
                             in_ty)
                (put_in_reg x)
                (put_in_reg y))))

;; Otherwise test the condition against zero.
(rule 0 (lower (select (fits_in_64 (ty_int _)) c @ (value_type (fits_in_64 cty)) x y))
  (output_reg
    (gen_select (int_compare (IntCC.NotEqual)
                             (put_in_cmp_reg c (IntCC.NotEqual) cty)
                             (imm $I64 0)
                             cty)
                (put_in_reg x)
                (put_in_reg y))))

;;;; Rules for floating-point constants ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; There is no floating-point immediate form, so constants are built in a
;; GPR and moved across.
(rule (lower (f64const _ (u64_from_ieee64 n)))
  (output_reg (mov_to_fpr (imm $I64 n) $F64)))

(rule (lower (f32const _ (u32_from_ieee32 n)))
  (output_reg (mov_to_fpr (imm $I64 (f32_bits_as_f64 n)) $F32)))

;;;; Rules for floating-point arithmetic ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (fadd (ty_scalar_float ty) x y))
  (output_reg (fpu_rrr (FpuOp2.Add) (put_in_reg x) (put_in_reg y) ty)))

(rule (lower (fsub (ty_scalar_float ty) x y))
  (output_reg (fpu_rrr (FpuOp2.Sub) (put_in_reg x) (put_in_reg y) ty)))

(rule (lower (fmul (ty_scalar_float ty) x y))
  (output_reg (fpu_rrr (FpuOp2.Mul) (put_in_reg x) (put_in_reg y) ty)))

(rule (lower (fdiv (ty_scalar_float ty) x y))
  (output_reg (fpu_rrr (FpuOp2.Div) (put_in_reg x) (put_in_reg y) ty)))

(rule (lower (fcopysign (ty_scalar_float ty) x y))
  (output_reg (fpu_rrr (FpuOp2.CopySign) (put_in_reg y) (put_in_reg x) ty)))

(rule (lower (fneg (ty_scalar_float ty) x))
  (output_reg (fpu_rr (FpuOp1.Neg) (put_in_reg x) ty)))

(rule (lower (fabs (ty_scalar_float ty) x))
  (output_reg (fpu_rr (FpuOp1.Abs) (put_in_reg x) ty)))

(rule (lower (sqrt (ty_scalar_float ty) x))
  (output_reg (fpu_rr (FpuOp1.Sqrt) (put_in_reg x) ty)))

(rule (lower (fma (ty_scalar_float ty) x y z))
  (output_reg (fpu_fma (put_in_reg x) (put_in_reg y) (put_in_reg z) ty)))

;; An `f32` is held in an FPR already widened to double, so promotion
;; needs no conversion — but it must not be a plain move: wasm requires
;; promoting a NaN to yield an arithmetic (quiet) NaN, and `lfs`/`fmr`
;; preserve a signalling NaN's quiet bit. Multiplying by 1.0 is exact for
;; every numeric value, preserves signed zeros, and quiets NaNs.
(rule (lower (fpromote $F64 x))
  (output_reg (fpu_rrr (FpuOp2.Mul)
                       (put_in_reg x)
                       (mov_to_fpr (imm $I64 0x3FF0000000000000) $F64)
                       $F64)))

(rule (lower (fdemote $F32 x))
  (output_reg (fpu_rr (FpuOp1.Demote) (put_in_reg x) $F32)))

;;;; Rules for integer-to-float conversions ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; A 64-bit source needs no widening; anything narrower is extended to 64
;; bits first, matching the conversion's signedness, since `fcfid` reads a
;; full doubleword.
(rule 1 (lower (fcvt_from_sint (ty_scalar_float out_ty) x @ (value_type $I64)))
  (output_reg (int_to_fpu (mov_to_fpr (put_in_reg x) $F64) true out_ty)))

(rule 0 (lower (fcvt_from_sint (ty_scalar_float out_ty) x @ (value_type (fits_in_32 in_ty))))
  (output_reg (gen_int_to_fpu x in_ty true out_ty)))

(rule 1 (lower (fcvt_from_uint (ty_scalar_float out_ty) x @ (value_type $I64)))
  (output_reg (int_to_fpu (mov_to_fpr (put_in_reg x) $F64) false out_ty)))

(rule 0 (lower (fcvt_from_uint (ty_scalar_float out_ty) x @ (value_type (fits_in_32 in_ty))))
  (output_reg (gen_int_to_fpu x in_ty false out_ty)))

;;;; Rules for `fmin` / `fmax` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Both types operate in the double domain: the minimum of two exactly
;; representable singles is one of them, so no re-rounding is needed.
(rule (lower (fmin (ty_scalar_float ty) x y))
  (output_reg (fpu_min_max (put_in_reg x) (put_in_reg y) false ty)))

(rule (lower (fmax (ty_scalar_float ty) x y))
  (output_reg (fpu_min_max (put_in_reg x) (put_in_reg y) true ty)))

;;;; Rules for float-to-integer conversions ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (fcvt_to_sint (ty_32_or_64 out_ty) x @ (value_type (ty_scalar_float in_ty))))
  (output_reg (fpu_to_int (put_in_reg x) true false in_ty out_ty)))

(rule (lower (fcvt_to_uint (ty_32_or_64 out_ty) x @ (value_type (ty_scalar_float in_ty))))
  (output_reg (fpu_to_int (put_in_reg x) false false in_ty out_ty)))

(rule (lower (fcvt_to_sint_sat (ty_32_or_64 out_ty) x @ (value_type (ty_scalar_float in_ty))))
  (output_reg (fpu_to_int (put_in_reg x) true true in_ty out_ty)))

(rule (lower (fcvt_to_uint_sat (ty_32_or_64 out_ty) x @ (value_type (ty_scalar_float in_ty))))
  (output_reg (fpu_to_int (put_in_reg x) false true in_ty out_ty)))

;;;; Rules for `fcmp` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Note that `fcmp`'s controlling type is the *result* -- `i8` for a
;; scalar compare, a lane-mask vector for a vector one -- so the guard
;; that keeps this rule off vector comparisons has to name the operand
;; type. Without it, vector registers reached this scalar compare and
;; tripped regalloc2's register-class assertion.
(rule (lower (fcmp _ cc x @ (value_type (ty_scalar_float _)) y))
  (output_reg (fpu_cmp_set (float_compare cc (put_in_reg x) (put_in_reg y)))))

;;;; Rules for `select_spectre_guard` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; `isel` is a conditional move rather than a branch, so there is no
;; mispredicted path for speculation to run down, which is what this
;; operation requires. The rules mirror `select` above.
(rule 1 (lower (select_spectre_guard (fits_in_64 (ty_int _))
                                     (maybe_uextend (icmp _ cc a @ (value_type (fits_in_64 in_ty)) b))
                                     x y))
  (output_reg
    (gen_select (int_compare cc
                             (put_in_cmp_reg a cc in_ty)
                             (put_in_cmp_reg b cc in_ty)
                             in_ty)
                (put_in_reg x)
                (put_in_reg y))))

(rule 3 (lower (select_spectre_guard $I128
                                     (maybe_uextend (icmp _ cc a @ (value_type (fits_in_64 in_ty)) b))
                                     x y))
  (let ((kind IntegerCompare (int_compare cc
                                          (put_in_cmp_reg a cc in_ty)
                                          (put_in_cmp_reg b cc in_ty)
                                          in_ty))
        (xr ValueRegs (put_in_regs x))
        (yr ValueRegs (put_in_regs y)))
    (output (value_regs (gen_select kind (lo xr) (lo yr))
                        (gen_select kind (hi xr) (hi yr))))))

(rule 2 (lower (select_spectre_guard $I128 c @ (value_type (fits_in_64 cty)) x y))
  (let ((kind IntegerCompare (int_compare (IntCC.NotEqual)
                                          (put_in_cmp_reg c (IntCC.NotEqual) cty)
                                          (imm $I64 0)
                                          cty))
        (xr ValueRegs (put_in_regs x))
        (yr ValueRegs (put_in_regs y)))
    (output (value_regs (gen_select kind (lo xr) (lo yr))
                        (gen_select kind (hi xr) (hi yr))))))

(rule 4 (lower (select_spectre_guard $I128 c @ (value_type $I128) x y))
  (let ((kind IntegerCompare (cond128 c))
        (xr ValueRegs (put_in_regs x))
        (yr ValueRegs (put_in_regs y)))
    (output (value_regs (gen_select kind (lo xr) (lo yr))
                        (gen_select kind (hi xr) (hi yr))))))

(rule 5 (lower (select_spectre_guard (fits_in_64 (ty_int _)) c @ (value_type $I128) x y))
  (output_reg (gen_select (cond128 c) (put_in_reg x) (put_in_reg y))))

(rule 0 (lower (select_spectre_guard (fits_in_64 (ty_int _)) c @ (value_type (fits_in_64 cty)) x y))
  (output_reg
    (gen_select (int_compare (IntCC.NotEqual)
                             (put_in_cmp_reg c (IntCC.NotEqual) cty)
                             (imm $I64 0)
                             cty)
                (put_in_reg x)
                (put_in_reg y))))

;;;; Rules for floating-point `select` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; `isel` only works on general registers, so both candidates are bounced
;; through them. The bit patterns are copied verbatim, so this is exact
;; for `f32` despite its widened in-register form.
(rule 3 (lower (select (ty_scalar_float ty)
                       (maybe_uextend (icmp _ cc a @ (value_type (fits_in_64 in_ty)) b))
                       x y))
  (output_reg
    (gen_fpu_select (int_compare cc
                                 (put_in_cmp_reg a cc in_ty)
                                 (put_in_cmp_reg b cc in_ty)
                                 in_ty)
                    (put_in_reg x)
                    (put_in_reg y)
                    ty)))

(rule 2 (lower (select (ty_scalar_float ty) c @ (value_type (fits_in_64 cty)) x y))
  (output_reg
    (gen_fpu_select (int_compare (IntCC.NotEqual)
                                 (put_in_cmp_reg c (IntCC.NotEqual) cty)
                                 (imm $I64 0)
                                 cty)
                    (put_in_reg x)
                    (put_in_reg y)
                    ty)))

;;;; Rules for bitwise ops on floating-point types ;;;;;;;;;;;;;;;;;;;;;;;;;

;; CLIF permits the bitwise operations on float types, meaning the bit
;; pattern of the value. For `f64` the register already holds exactly
;; those bits; for `f32` they have to be converted out of the widened
;; form and back.
(rule 1 (lower (band $F64 x y))
  (output_reg (mov_to_fpr (ppc_and (mov_from_fpr (put_in_reg x))
                                   (mov_from_fpr (put_in_reg y))) $F64)))
(rule 1 (lower (bor $F64 x y))
  (output_reg (mov_to_fpr (ppc_or (mov_from_fpr (put_in_reg x))
                                  (mov_from_fpr (put_in_reg y))) $F64)))
(rule 1 (lower (bxor $F64 x y))
  (output_reg (mov_to_fpr (ppc_xor (mov_from_fpr (put_in_reg x))
                                   (mov_from_fpr (put_in_reg y))) $F64)))
(rule 1 (lower (bnot $F64 x))
  (output_reg (mov_to_fpr (gen_unary (UnaryOp.Not) (mov_from_fpr (put_in_reg x))) $F64)))

(rule 1 (lower (band $F32 x y))
  (output_reg (f32_from_bits (ppc_and (f32_to_bits (put_in_reg x))
                                      (f32_to_bits (put_in_reg y))))))
(rule 1 (lower (bor $F32 x y))
  (output_reg (f32_from_bits (ppc_or (f32_to_bits (put_in_reg x))
                                     (f32_to_bits (put_in_reg y))))))
(rule 1 (lower (bxor $F32 x y))
  (output_reg (f32_from_bits (ppc_xor (f32_to_bits (put_in_reg x))
                                      (f32_to_bits (put_in_reg y))))))
(rule 1 (lower (bnot $F32 x))
  (output_reg (f32_from_bits (gen_unary (UnaryOp.Not) (f32_to_bits (put_in_reg x))))))

;;;; Rules for `bitcast` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (bitcast $I128 _ x @ (value_type $I128)))
  (output (put_in_regs x)))

;; Same-type bitcasts are no-ops.
(rule (lower (bitcast $I8 _ x @ (value_type $I8))) (output_reg (put_in_reg x)))
(rule (lower (bitcast $I16 _ x @ (value_type $I16))) (output_reg (put_in_reg x)))
(rule (lower (bitcast $I32 _ x @ (value_type $I32))) (output_reg (put_in_reg x)))
(rule (lower (bitcast $I64 _ x @ (value_type $I64))) (output_reg (put_in_reg x)))
(rule (lower (bitcast $F32 _ x @ (value_type $F32))) (output_reg (put_in_reg x)))
(rule (lower (bitcast $F64 _ x @ (value_type $F64))) (output_reg (put_in_reg x)))

(rule (lower (bitcast $I64 _ x @ (value_type $F64)))
  (output_reg (mov_from_fpr (put_in_reg x))))

(rule (lower (bitcast $F64 _ x @ (value_type $I64)))
  (output_reg (mov_to_fpr (put_in_reg x) $F64)))

(rule (lower (bitcast $I32 _ x @ (value_type $F32)))
  (output_reg (f32_to_bits (put_in_reg x))))

(rule (lower (bitcast $F32 _ x @ (value_type $I32)))
  (output_reg (f32_from_bits (put_in_reg x))))

;;;; Rules for `uextend`/`sextend`/`ireduce` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (uextend out_ty val @ (value_type in_ty)))
  (output_reg (gen_extend (put_in_reg val) false (ty_bits in_ty) (ty_bits out_ty))))

(rule (lower (sextend out_ty val @ (value_type in_ty)))
  (output_reg (gen_extend (put_in_reg val) true (ty_bits in_ty) (ty_bits out_ty))))

;; Truncation is a no-op: narrow values live in the low bits.
(rule (lower (ireduce _ val))
  (output_reg (put_in_reg val)))

;;;; Rules for loads ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; The `little_or_native_endian` extractor is the seam where big-endian
;; support would slot in: explicitly-BE accesses have no rules yet.
(rule (lower (load ty (little_or_native_endian flags) addr offset))
  (output_reg (gen_load ty (amode addr offset) flags)))

;; Extending loads: PPC has zero-extending loads natively (lbz/lhz/lwz);
;; use them and extend as required.
(rule (lower (uload8 _ (little_or_native_endian flags) addr offset))
  (output_reg (gen_load $I8 (amode addr offset) flags)))
(rule (lower (uload16 _ (little_or_native_endian flags) addr offset))
  (output_reg (gen_load $I16 (amode addr offset) flags)))
(rule (lower (uload32 _ (little_or_native_endian flags) addr offset))
  (output_reg (gen_load $I32 (amode addr offset) flags)))

(rule (lower (sload8 _ (little_or_native_endian flags) addr offset))
  (output_reg (gen_extend (gen_load $I8 (amode addr offset) flags) true 8 64)))
(rule (lower (sload16 _ (little_or_native_endian flags) addr offset))
  (output_reg (gen_extend (gen_load $I16 (amode addr offset) flags) true 16 64)))
(rule (lower (sload32 _ (little_or_native_endian flags) addr offset))
  (output_reg (gen_extend (gen_load $I32 (amode addr offset) flags) true 32 64)))

;;;; Rules for stores ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (store (little_or_native_endian flags) val @ (value_type ty) addr offset))
  (side_effect (gen_store ty (amode addr offset) flags (put_in_reg val))))

(rule (lower (istore8 (little_or_native_endian flags) val addr offset))
  (side_effect (gen_store $I8 (amode addr offset) flags (put_in_reg val))))
(rule (lower (istore16 (little_or_native_endian flags) val addr offset))
  (side_effect (gen_store $I16 (amode addr offset) flags (put_in_reg val))))
(rule (lower (istore32 (little_or_native_endian flags) val addr offset))
  (side_effect (gen_store $I32 (amode addr offset) flags (put_in_reg val))))

;;;; Rules for `icmp` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; `cmpw`/`cmpd` (and unsigned variants) handle 32- and 64-bit inputs
;; regardless of upper-bit garbage; 8/16-bit inputs must be extended
;; first, matching the comparison's signedness.
(decl put_in_cmp_reg (Value IntCC Type) Reg)
(rule 1 (put_in_cmp_reg val cc (fits_in_16 ty))
  (gen_extend (put_in_reg val) (cc_is_signed cc) (ty_bits ty) 64))
(rule 0 (put_in_cmp_reg val _ $I32) (put_in_reg val))
(rule 0 (put_in_cmp_reg val _ $I64) (put_in_reg val))

(decl cc_is_signed (IntCC) bool)
(extern constructor cc_is_signed cc_is_signed)

(rule (lower (icmp _ cc x @ (value_type (fits_in_64 in_ty)) y))
  (output_reg
    (cmp_set (int_compare cc
                          (put_in_cmp_reg x cc in_ty)
                          (put_in_cmp_reg y cc in_ty)
                          in_ty))))

;;;; Rules for branches ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower_branch (br_table index _) targets)
  (lower_br_table index targets))

(rule (lower_branch (jump _) (single_target label))
  (emit_side_effect (ppc_jump label)))

;; brif on an icmp: fuse compare and branch.
(rule 1 (lower_branch (brif (maybe_uextend (icmp _ cc x @ (value_type (fits_in_64 in_ty)) y)) _ _)
                      (two_targets taken not_taken))
  (emit_side_effect
    (ppc_cond_br (int_compare cc
                              (put_in_cmp_reg x cc in_ty)
                              (put_in_cmp_reg y cc in_ty)
                              in_ty)
                 taken not_taken)))

;; brif on an fcmp: fuse compare and branch.
(rule 2 (lower_branch (brif (maybe_uextend (fcmp _ cc x y)) _ _)
                      (two_targets taken not_taken))
  (emit_side_effect
    (fpu_cond_br (float_compare cc (put_in_reg x) (put_in_reg y)) taken not_taken)))

;; brif on a general boolean value: compare against zero.
(rule 0 (lower_branch (brif val @ (value_type (fits_in_64 ty)) _ _)
                      (two_targets taken not_taken))
  (emit_side_effect
    (ppc_cond_br (int_compare (IntCC.NotEqual)
                              (put_in_cmp_reg val (IntCC.NotEqual) ty)
                              (imm $I64 0)
                              ty)
                 taken not_taken)))

;;;; Rules for atomics ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (atomic_load (fits_in_64 (ty_int ty)) (little_or_native_endian _flags) p))
  (output_reg (gen_atomic_load (put_in_reg p) ty)))

(rule (lower (atomic_store (little_or_native_endian _flags)
                           src @ (value_type (fits_in_64 (ty_int ty)))
                           p))
  (side_effect (gen_atomic_store (put_in_reg src) (put_in_reg p) ty)))

(rule (lower (atomic_rmw (fits_in_64 (ty_int ty)) (little_or_native_endian _flags) op p x))
  (output_reg (gen_atomic_rmw op (put_in_reg p) (atomic_rmw_src op ty x) ty)))

(rule (lower (atomic_cas (fits_in_64 (ty_int ty)) (little_or_native_endian _flags) p e x))
  (output_reg (gen_atomic_cas (put_in_reg p)
                              (put_in_zext_reg e ty)
                              (put_in_reg x)
                              ty)))

;; Zero-extend for the full-width compare against a zero-extending
;; reservation load; i32 and i64 loads fill the compared width already.
(decl put_in_zext_reg (Value Type) Reg)
(rule 1 (put_in_zext_reg val (ty_32_or_64 _)) (put_in_reg val))
(rule 0 (put_in_zext_reg val (fits_in_16 ty))
  (gen_extend (put_in_reg val) false (ty_bits ty) 64))

(rule (lower (fence))
  (side_effect (SideEffectNoResult.Inst (MInst.Fence))))

;;;; Rules for `stack_addr` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (stack_addr _ ss offset))
  (output_reg (gen_stack_addr ss offset)))

;;;; Rules for traps ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (trap code))
  (side_effect (SideEffectNoResult.Inst (MInst.Udf code))))

(rule (lower (trapz val @ (value_type (fits_in_64 ty)) code))
  (side_effect
    (gen_trapif (int_compare (IntCC.Equal)
                             (put_in_cmp_reg val (IntCC.Equal) ty)
                             (imm $I64 0)
                             ty)
                code)))

(rule (lower (trapnz val @ (value_type (fits_in_64 ty)) code))
  (side_effect
    (gen_trapif (int_compare (IntCC.NotEqual)
                             (put_in_cmp_reg val (IntCC.NotEqual) ty)
                             (imm $I64 0)
                             ty)
                code)))

;; An `i128` trap condition tests whether either half is non-zero.
(rule 1 (lower (trapz val @ (value_type $I128) code))
  (let ((vr ValueRegs (put_in_regs val)))
    (side_effect
      (gen_trapif (int_compare (IntCC.Equal)
                               (ppc_or (value_regs_get vr 0) (value_regs_get vr 1))
                               (imm $I64 0)
                               $I64)
                  code))))

(rule 1 (lower (trapnz val @ (value_type $I128) code))
  (let ((vr ValueRegs (put_in_regs val)))
    (side_effect
      (gen_trapif (int_compare (IntCC.NotEqual)
                               (ppc_or (value_regs_get vr 0) (value_regs_get vr 1))
                               (imm $I64 0)
                               $I64)
                  code))))

;;;; Rules for `return` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; N.B.: the Ret itself is generated by the ABI.
(rule (lower (return args))
  (lower_return args))

;;;; Rules for calls ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Direct call to an in-range function.
(rule 1 (lower (call (func_ref_data sig_ref name (RelocDistance.Near) patchable) args))
  (let ((output ValueRegsVec (gen_call_output sig_ref))
        (abi Sig (abi_sig sig_ref))
        (uses CallArgList (gen_call_args abi args))
        (defs CallRetList (gen_call_rets abi output))
        (info BoxCallInfo (gen_call_info abi name uses defs (try_call_none) patchable))
        (_ Unit (emit_side_effect (SideEffectNoResult.Inst (MInst.Call info)))))
    output))

;; Direct call to an out-of-range function, via its absolute address.
(rule (lower (call (func_ref_data sig_ref name dist false) args))
  (let ((output ValueRegsVec (gen_call_output sig_ref))
        (abi Sig (abi_sig sig_ref))
        (uses CallArgList (gen_call_args abi args))
        (defs CallRetList (gen_call_rets abi output))
        (target Reg (load_ext_name name 0))
        (info BoxCallIndInfo (gen_call_ind_info abi target uses defs (try_call_none)))
        (_ Unit (emit_side_effect (SideEffectNoResult.Inst (MInst.CallInd info)))))
    output))

;; Indirect call.
(rule (lower (call_indirect sig_ref ptr args))
  (let ((output ValueRegsVec (gen_call_output sig_ref))
        (abi Sig (abi_sig sig_ref))
        (target Reg (put_in_reg ptr))
        (uses CallArgList (gen_call_args abi args))
        (defs CallRetList (gen_call_rets abi output))
        (info BoxCallIndInfo (gen_call_ind_info abi target uses defs (try_call_none)))
        (_ Unit (emit_side_effect (SideEffectNoResult.Inst (MInst.CallInd info)))))
    output))

;;;; Rules for `try_call` and `try_call_indirect` ;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Direct call to an in-range function.
(rule 1 (lower_branch (try_call (func_ref_data sig_ref name (RelocDistance.Near) patchable) args et) targets)
  (let ((abi Sig (abi_sig sig_ref))
        (trycall OptionTryCallInfo (try_call_info et targets))
        (uses CallArgList (gen_call_args abi args))
        (defs CallRetList (gen_try_call_rets abi))
        (info BoxCallInfo (gen_call_info abi name uses defs trycall patchable)))
    (emit_side_effect (SideEffectNoResult.Inst (MInst.Call info)))))

;; Direct call to an out-of-range function, via its absolute address.
(rule (lower_branch (try_call (func_ref_data sig_ref name dist false) args et) targets)
  (let ((abi Sig (abi_sig sig_ref))
        (trycall OptionTryCallInfo (try_call_info et targets))
        (uses CallArgList (gen_call_args abi args))
        (defs CallRetList (gen_try_call_rets abi))
        (target Reg (load_ext_name name 0))
        (info BoxCallIndInfo (gen_call_ind_info abi target uses defs trycall)))
    (emit_side_effect (SideEffectNoResult.Inst (MInst.CallInd info)))))

;; Indirect call.
(rule (lower_branch (try_call_indirect ptr args et) targets)
  (if-let (exception_sig sig_ref) et)
  (let ((abi Sig (abi_sig sig_ref))
        (trycall OptionTryCallInfo (try_call_info et targets))
        (target Reg (put_in_reg ptr))
        (uses CallArgList (gen_call_args abi args))
        (defs CallRetList (gen_try_call_rets abi))
        (info BoxCallIndInfo (gen_call_ind_info abi target uses defs trycall)))
    (emit_side_effect (SideEffectNoResult.Inst (MInst.CallInd info)))))

;;;; Rules for `get_{stack,frame}_pointer` and `get_return_address` ;;;;;;;;;

(rule (lower (get_stack_pointer _))
  (output_reg (ppc_mov_from_preg 1)))

(rule (lower (get_frame_pointer _))
  (output_reg (ppc_mov_from_preg 31)))

(rule (lower (get_return_address _))
  (output_reg (read_return_address)))

;;;; Rules for `get_exception_handler_address` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (get_exception_handler_address _ block (u64_from_imm64 idx)))
  (output_reg (ppc_label_address (block_exn_successor_label block idx))))

;;;; Rules for `return_call` and `return_call_indirect` ;;;;;;;;;;;;;;;;;;;;

(rule 1 (lower (return_call (func_ref_data sig_ref name (RelocDistance.Near) false) args))
  (let ((abi Sig (abi_sig sig_ref))
        (uses CallArgList (gen_return_call_args abi args))
        (info BoxReturnCallInfo (gen_return_call_info abi name uses)))
    (side_effect (SideEffectNoResult.Inst (MInst.ReturnCall info)))))

;; Out of range: via the absolute address, like ordinary far calls.
(rule (lower (return_call (func_ref_data sig_ref name _dist false) args))
  (let ((abi Sig (abi_sig sig_ref))
        (uses CallArgList (gen_return_call_args abi args))
        (target Reg (load_ext_name name 0))
        (info BoxReturnCallIndInfo (gen_return_call_ind_info abi target uses)))
    (side_effect (SideEffectNoResult.Inst (MInst.ReturnCallInd info)))))

(rule (lower (return_call_indirect sig_ref ptr args))
  (let ((abi Sig (abi_sig sig_ref))
        (target Reg (put_in_reg ptr))
        (uses CallArgList (gen_return_call_args abi args))
        (info BoxReturnCallIndInfo (gen_return_call_ind_info abi target uses)))
    (side_effect (SideEffectNoResult.Inst (MInst.ReturnCallInd info)))))

;; Load the absolute address of an external symbol.
(decl load_ext_name (ExternalName i64) Reg)
(extern constructor load_ext_name load_ext_name)

(rule (lower (func_addr _ (func_ref_data _ name _ _)))
  (output_reg (load_ext_name name 0)))

(rule (lower (symbol_value _ (symbol_value_data name _ offset)))
  (output_reg (load_ext_name name offset)))

;;;; Rules for `i128` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; An `i128` value lives in a pair of GPRs, low doubleword first (see
;; `rc_for_type`). The rules here follow one convention throughout:
;; both operands' registers are extracted *before* the first
;; instruction of a carry chain is emitted, so an `addc`/`adde` (or
;; `subc`/`sube`) pair is always adjacent in the lowered code, with
;; nothing between it that could clobber XER.CA.

;; Convenience: the low or high doubleword of a 128-bit value.
(decl lo (ValueRegs) Reg)
(rule (lo x) (value_regs_get x 0))
(decl hi (ValueRegs) Reg)
(rule (hi x) (value_regs_get x 1))

;;;; `iconcat` / `isplit`

(rule (lower (iconcat $I128 x y))
  (output (value_regs (put_in_reg x) (put_in_reg y))))

(rule (lower (isplit $I64 x @ (value_type $I128)))
  (let ((xr ValueRegs (put_in_regs x)))
    (output_pair (value_reg (lo xr)) (value_reg (hi xr)))))

;;;; Addition, subtraction, negation

(rule 3 (lower (iadd $I128 x y))
  (let ((xr ValueRegs (put_in_regs x))
        (yr ValueRegs (put_in_regs y))
        (lo_sum Reg (ppc_addc (lo xr) (lo yr)))
        (hi_sum Reg (ppc_adde (hi xr) (hi yr))))
    (output (value_regs lo_sum hi_sum))))

(rule 3 (lower (isub $I128 x y))
  (let ((xr ValueRegs (put_in_regs x))
        (yr ValueRegs (put_in_regs y))
        (lo_diff Reg (ppc_subfc (lo xr) (lo yr)))
        (hi_diff Reg (ppc_subfe (hi xr) (hi yr))))
    (output (value_regs lo_diff hi_diff))))

(rule 1 (lower (ineg $I128 x))
  (let ((xr ValueRegs (put_in_regs x))
        (zero Reg (imm $I64 0))
        (lo_neg Reg (ppc_subfc zero (lo xr)))
        (hi_neg Reg (ppc_subfe zero (hi xr))))
    (output (value_regs lo_neg hi_neg))))

;;;; Multiplication
;;
;; (a_hi:a_lo) * (b_hi:b_lo) mod 2^128: the low doubleword is the low
;; half of a_lo*b_lo; the high doubleword collects the upper half of
;; that product plus the two cross products (whose own upper halves
;; fall outside 128 bits).

(rule 1 (lower (imul $I128 x y))
  (let ((xr ValueRegs (put_in_regs x))
        (yr ValueRegs (put_in_regs y))
        (lo_prod Reg (ppc_mulld (lo xr) (lo yr)))
        (carry Reg (ppc_mulhdu (lo xr) (lo yr)))
        (cross1 Reg (ppc_mulld (hi xr) (lo yr)))
        (cross2 Reg (ppc_mulld (lo xr) (hi yr)))
        (hi_prod Reg (ppc_add carry (ppc_add cross1 cross2))))
    (output (value_regs lo_prod hi_prod))))

;;;; Bitwise logic

(rule 1 (lower (band $I128 x y))
  (let ((xr ValueRegs (put_in_regs x))
        (yr ValueRegs (put_in_regs y)))
    (output (value_regs (ppc_and (lo xr) (lo yr)) (ppc_and (hi xr) (hi yr))))))

(rule 1 (lower (bor $I128 x y))
  (let ((xr ValueRegs (put_in_regs x))
        (yr ValueRegs (put_in_regs y)))
    (output (value_regs (ppc_or (lo xr) (lo yr)) (ppc_or (hi xr) (hi yr))))))

(rule 1 (lower (bxor $I128 x y))
  (let ((xr ValueRegs (put_in_regs x))
        (yr ValueRegs (put_in_regs y)))
    (output (value_regs (ppc_xor (lo xr) (lo yr)) (ppc_xor (hi xr) (hi yr))))))

(rule 1 (lower (bnot $I128 x))
  (let ((xr ValueRegs (put_in_regs x)))
    (output (value_regs (gen_unary (UnaryOp.Not) (lo xr))
                        (gen_unary (UnaryOp.Not) (hi xr))))))

;;;; Extension and truncation

(rule 1 (lower (uextend $I128 val @ (value_type in_ty)))
  (output (value_regs (gen_extend (put_in_reg val) false (ty_bits in_ty) 64)
                      (imm $I64 0))))

(rule 1 (lower (sextend $I128 val @ (value_type in_ty)))
  (let ((lo_half Reg (gen_extend (put_in_reg val) true (ty_bits in_ty) 64))
        (hi_half Reg (gen_shift (ShiftOp.Srad) lo_half (imm $I64 63))))
    (output (value_regs lo_half hi_half))))

(rule 1 (lower (ireduce _ val @ (value_type $I128)))
  (output_reg (lo (put_in_regs val))))

;;;; Loads and stores
;;
;; Two doubleword accesses, low half at the lower address. A trap can
;; land between the halves, which CLIF permits for a multi-word access.

(rule 1 (lower (load $I128 (little_or_native_endian flags) addr offset))
  (let ((lo_half Reg (gen_load $I64 (amode addr offset) flags))
        (hi_half Reg (gen_load $I64 (amode8 addr offset) flags)))
    (output (value_regs lo_half hi_half))))

(rule 1 (lower (store (little_or_native_endian flags)
                      val @ (value_type $I128) addr offset))
  (let ((vr ValueRegs (put_in_regs val)))
    (side_effect
      (side_effect_concat
        (gen_store $I64 (amode addr offset) flags (lo vr))
        (gen_store $I64 (amode8 addr offset) flags (hi vr))))))

;;;; Comparisons
;;
;; Equality is a bit-level question: OR together the XORs of the two
;; halves and test for zero. The ordered comparisons decompose as
;; "high halves strictly ordered, or high halves equal and low halves
;; unsigned-ordered" -- the low half is always compared unsigned
;; because it carries no sign.

(rule 2 (lower (icmp _ (IntCC.Equal) x @ (value_type $I128) y))
  (let ((xr ValueRegs (put_in_regs x))
        (yr ValueRegs (put_in_regs y))
        (diff Reg (ppc_or (ppc_xor (lo xr) (lo yr)) (ppc_xor (hi xr) (hi yr)))))
    (output_reg (cmp_set (int_compare (IntCC.Equal) diff (imm $I64 0) $I64)))))

(rule 2 (lower (icmp _ (IntCC.NotEqual) x @ (value_type $I128) y))
  (let ((xr ValueRegs (put_in_regs x))
        (yr ValueRegs (put_in_regs y))
        (diff Reg (ppc_or (ppc_xor (lo xr) (lo yr)) (ppc_xor (hi xr) (hi yr)))))
    (output_reg (cmp_set (int_compare (IntCC.NotEqual) diff (imm $I64 0) $I64)))))

(decl icmp128_ordered (IntCC ValueRegs ValueRegs) Reg)
(rule (icmp128_ordered cc xr yr)
  (if-let hi_cc (icmp128_hi_cc cc))
  (if-let lo_cc (icmp128_lo_cc cc))
  (let ((hi_strict Reg (cmp_set (int_compare hi_cc (hi xr) (hi yr) $I64)))
        (hi_eq Reg (cmp_set (int_compare (IntCC.Equal) (hi xr) (hi yr) $I64)))
        (lo_cmp Reg (cmp_set (int_compare lo_cc (lo xr) (lo yr) $I64))))
    (ppc_or hi_strict (ppc_and hi_eq lo_cmp))))

(rule 1 (lower (icmp _ cc x @ (value_type $I128) y))
  (output_reg (icmp128_ordered cc (put_in_regs x) (put_in_regs y))))

;;;; Selects

;; A select producing an `i128` runs the same compare-and-isel once
;; per half.
(rule 6 (lower (select $I128
                       (maybe_uextend (icmp _ cc a @ (value_type (fits_in_64 in_ty)) b))
                       x y))
  (let ((kind IntegerCompare (int_compare cc
                                          (put_in_cmp_reg a cc in_ty)
                                          (put_in_cmp_reg b cc in_ty)
                                          in_ty))
        (xr ValueRegs (put_in_regs x))
        (yr ValueRegs (put_in_regs y)))
    (output (value_regs (gen_select kind (lo xr) (lo yr))
                        (gen_select kind (hi xr) (hi yr))))))

(rule 5 (lower (select $I128 c @ (value_type (fits_in_64 cty)) x y))
  (let ((kind IntegerCompare (int_compare (IntCC.NotEqual)
                                          (put_in_cmp_reg c (IntCC.NotEqual) cty)
                                          (imm $I64 0)
                                          cty))
        (xr ValueRegs (put_in_regs x))
        (yr ValueRegs (put_in_regs y)))
    (output (value_regs (gen_select kind (lo xr) (lo yr))
                        (gen_select kind (hi xr) (hi yr))))))

;; An `i128` condition is truthy when either half is non-zero.
(decl cond128 (Value) IntegerCompare)
(rule (cond128 c)
  (let ((cr ValueRegs (put_in_regs c)))
    (int_compare (IntCC.NotEqual) (ppc_or (lo cr) (hi cr)) (imm $I64 0) $I64)))

(rule 4 (lower (select $I128 c @ (value_type $I128) x y))
  (let ((kind IntegerCompare (cond128 c))
        (xr ValueRegs (put_in_regs x))
        (yr ValueRegs (put_in_regs y)))
    (output (value_regs (gen_select kind (lo xr) (lo yr))
                        (gen_select kind (hi xr) (hi yr))))))

(rule 7 (lower (select (fits_in_64 (ty_int _)) c @ (value_type $I128) x y))
  (output_reg (gen_select (cond128 c) (put_in_reg x) (put_in_reg y))))

(rule 8 (lower (select (ty_scalar_float ty) c @ (value_type $I128) x y))
  (output_reg (gen_fpu_select (cond128 c) (put_in_reg x) (put_in_reg y) ty)))

;;;; Branch on an `i128` condition

(rule 3 (lower_branch (brif val @ (value_type $I128) _ _)
                      (two_targets taken not_taken))
  (emit_side_effect (ppc_cond_br (cond128 val) taken not_taken)))

;;;; Shifts
;;
;; `sld`/`srd`/`srad` consume seven bits of shift amount: the shifts
;; produce zero (`srad`: all sign bits) for amounts 64-127. That makes
;; the classic branchless double-register sequences work for the full
;; 0-127 range. For a left shift by n:
;;
;;   lo' = lo << n
;;   hi' = (hi << n) | (lo >> (64-n)) | (lo << (n-64))
;;
;; For n = 0 both correction terms shift by 64 (mod 128) and vanish;
;; for n in 1..63 the second term carries lo's high bits in; for n in
;; 64..127 the first two terms vanish and the third places lo alone.
;; Right shifts mirror this. The arithmetic right shift needs one
;; `isel` because for n >= 64 the low half is `hi >> (n-64)` with sign
;; fill, which no OR of unsigned pieces produces.

(decl shl128 (ValueRegs Reg) ValueRegs)
(rule (shl128 x amt)
  (let ((n Reg (alu_rr_imm16 (AluImmOp.Andi) amt 127))
        (lo_out Reg (gen_shift (ShiftOp.Sld) (lo x) n))
        (nback Reg (ppc_sub (imm $I64 64) n))
        (nbig Reg (gen_unary (UnaryOp.Neg) nback))
        (hi_out Reg (ppc_or (ppc_or (gen_shift (ShiftOp.Sld) (hi x) n)
                                    (gen_shift (ShiftOp.Srd) (lo x) nback))
                            (gen_shift (ShiftOp.Sld) (lo x) nbig))))
    (value_regs lo_out hi_out)))

(decl ushr128 (ValueRegs Reg) ValueRegs)
(rule (ushr128 x amt)
  (let ((n Reg (alu_rr_imm16 (AluImmOp.Andi) amt 127))
        (hi_out Reg (gen_shift (ShiftOp.Srd) (hi x) n))
        (nback Reg (ppc_sub (imm $I64 64) n))
        (nbig Reg (gen_unary (UnaryOp.Neg) nback))
        (lo_out Reg (ppc_or (ppc_or (gen_shift (ShiftOp.Srd) (lo x) n)
                                    (gen_shift (ShiftOp.Sld) (hi x) nback))
                            (gen_shift (ShiftOp.Srd) (hi x) nbig))))
    (value_regs lo_out hi_out)))

(decl sshr128 (ValueRegs Reg) ValueRegs)
(rule (sshr128 x amt)
  (let ((n Reg (alu_rr_imm16 (AluImmOp.Andi) amt 127))
        (c64 Reg (imm $I64 64))
        (hi_out Reg (gen_shift (ShiftOp.Srad) (hi x) n))
        (nback Reg (ppc_sub c64 n))
        (nbig Reg (gen_unary (UnaryOp.Neg) nback))
        (lo_small Reg (ppc_or (gen_shift (ShiftOp.Srd) (lo x) n)
                              (gen_shift (ShiftOp.Sld) (hi x) nback)))
        (lo_big Reg (gen_shift (ShiftOp.Srad) (hi x) nbig))
        (lo_out Reg (gen_select (int_compare (IntCC.UnsignedLessThan) n c64 $I64)
                                lo_small lo_big)))
    (value_regs lo_out hi_out)))

(rule 3 (lower (ishl $I128 x y))
  (output (shl128 (put_in_regs x) (shift_amt_64 y))))

(rule 3 (lower (ushr $I128 x y))
  (output (ushr128 (put_in_regs x) (shift_amt_64 y))))

(rule 3 (lower (sshr $I128 x y))
  (output (sshr128 (put_in_regs x) (shift_amt_64 y))))

;;;; Rotates
;;
;; rot(x, n) = shifted-one-way OR shifted-the-other-way-by(-n); both
;; helpers mask their amount mod 128, and (-n) mod 128 = 128-n, so
;; n = 0 degenerates to x | x.

(decl or128 (ValueRegs ValueRegs) ValueRegs)
(rule (or128 x y)
  (value_regs (ppc_or (lo x) (lo y)) (ppc_or (hi x) (hi y))))

(rule 2 (lower (rotl $I128 x y))
  (let ((xr ValueRegs (put_in_regs x))
        (n Reg (shift_amt_64 y)))
    (output (or128 (shl128 xr n)
                   (ushr128 xr (gen_unary (UnaryOp.Neg) n))))))

(rule 2 (lower (rotr $I128 x y))
  (let ((xr ValueRegs (put_in_regs x))
        (n Reg (shift_amt_64 y)))
    (output (or128 (ushr128 xr n)
                   (shl128 xr (gen_unary (UnaryOp.Neg) n))))))

;;;; Bit counting
;;
;; The result of a 128-bit count fits in seven bits, so the high half
;; of the result is always zero.

(rule 2 (lower (clz $I128 x))
  (let ((xr ValueRegs (put_in_regs x))
        (count_hi Reg (gen_bitcount (BitOp.Clz) (hi xr) $I64))
        (count_lo Reg (ppc_add (gen_bitcount (BitOp.Clz) (lo xr) $I64)
                               (imm $I64 64)))
        (res Reg (gen_select (int_compare (IntCC.Equal) (hi xr) (imm $I64 0) $I64)
                             count_lo count_hi)))
    (output (value_regs res (imm $I64 0)))))

(rule 2 (lower (ctz $I128 x))
  (let ((xr ValueRegs (put_in_regs x))
        (count_lo Reg (gen_bitcount (BitOp.Ctz) (lo xr) $I64))
        (count_hi Reg (ppc_add (gen_bitcount (BitOp.Ctz) (hi xr) $I64)
                               (imm $I64 64)))
        (res Reg (gen_select (int_compare (IntCC.Equal) (lo xr) (imm $I64 0) $I64)
                             count_hi count_lo)))
    (output (value_regs res (imm $I64 0)))))

(rule 2 (lower (popcnt $I128 x))
  (let ((xr ValueRegs (put_in_regs x)))
    (output (value_regs (ppc_add (gen_bitcount (BitOp.Popcnt) (lo xr) $I64)
                                 (gen_bitcount (BitOp.Popcnt) (hi xr) $I64))
                        (imm $I64 0)))))

;;;; Integer min/max

;; Compare once (a 0/1 result), then select each half on it.
(decl minmax128 (IntCC Value Value) InstOutput)
(rule (minmax128 cc x y)
  (let ((xr ValueRegs (put_in_regs x))
        (yr ValueRegs (put_in_regs y))
        (kind IntegerCompare (int_compare (IntCC.NotEqual)
                                          (icmp128_ordered cc xr yr)
                                          (imm $I64 0)
                                          $I64)))
    (output (value_regs (gen_select kind (lo xr) (lo yr))
                        (gen_select kind (hi xr) (hi yr))))))

(rule 1 (lower (smin $I128 x y)) (minmax128 (IntCC.SignedLessThan) x y))
(rule 1 (lower (smax $I128 x y)) (minmax128 (IntCC.SignedGreaterThan) x y))
(rule 1 (lower (umin $I128 x y)) (minmax128 (IntCC.UnsignedLessThan) x y))
(rule 1 (lower (umax $I128 x y)) (minmax128 (IntCC.UnsignedGreaterThan) x y))

;;;; `bitselect`: (x & mask) | (y & ~mask)

(decl bitselect64 (Reg Reg Reg) Reg)
(rule (bitselect64 mask x y)
  (ppc_or (ppc_and mask x)
          (ppc_and (gen_unary (UnaryOp.Not) mask) y)))

(rule (lower (bitselect (fits_in_64 (ty_int _)) mask x y))
  (output_reg (bitselect64 (put_in_reg mask) (put_in_reg x) (put_in_reg y))))

(rule 1 (lower (bitselect $I128 mask x y))
  (let ((mr ValueRegs (put_in_regs mask))
        (xr ValueRegs (put_in_regs x))
        (yr ValueRegs (put_in_regs y)))
    (output (value_regs (bitselect64 (lo mr) (lo xr) (lo yr))
                        (bitselect64 (hi mr) (hi xr) (hi yr))))))

;;;; Rules for `cls` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; XORing a value with its own sign-fill turns the leading sign bits
;; (and the sign bit itself) into leading zeros, so a count of leading
;; sign bits is `clz(x ^ (x >> 63)) - 1` on the sign-extended value,
;; adjusted for the type's width.

(rule (lower (cls (fits_in_64 (ty_int ty)) x))
  (let ((s Reg (gen_extend (put_in_reg x) true (ty_bits ty) 64))
        (u Reg (ppc_xor s (gen_shift (ShiftOp.Srad) s (imm $I64 63)))))
    (output_reg (alu_rr_imm16 (AluImmOp.Addi)
                              (gen_bitcount (BitOp.Clz) u $I64)
                              (cls_adjust ty)))))

(rule 1 (lower (cls $I128 x))
  (let ((xr ValueRegs (put_in_regs x))
        (sign Reg (gen_shift (ShiftOp.Srad) (hi xr) (imm $I64 63)))
        (ulo Reg (ppc_xor (lo xr) sign))
        (uhi Reg (ppc_xor (hi xr) sign))
        (chi Reg (gen_bitcount (BitOp.Clz) uhi $I64))
        (clo64 Reg (ppc_add (gen_bitcount (BitOp.Clz) ulo $I64) (imm $I64 64)))
        (count Reg (gen_select (int_compare (IntCC.Equal) uhi (imm $I64 0) $I64)
                               clo64 chi)))
    ;; `count` here is a true 128-bit leading-zero count of the
    ;; sign-XORed value, so the only correction is the sign bit itself.
    (output (value_regs (alu_rr_imm16 (AluImmOp.Addi) count 0xffff)
                        (imm $I64 0)))))

;;;; Rules for `iabs` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (iabs (fits_in_64 (ty_int ty)) x))
  (let ((s Reg (gen_extend (put_in_reg x) true (ty_bits ty) 64)))
    (output_reg (gen_select (int_compare (IntCC.SignedLessThan) s (imm $I64 0) $I64)
                            (gen_unary (UnaryOp.Neg) s)
                            s))))

(rule 1 (lower (iabs $I128 x))
  (let ((xr ValueRegs (put_in_regs x))
        (zero Reg (imm $I64 0))
        (nlo Reg (ppc_subfc zero (lo xr)))
        (nhi Reg (ppc_subfe zero (hi xr)))
        (kind IntegerCompare (int_compare (IntCC.SignedLessThan) (hi xr) zero $I64)))
    (output (value_regs (gen_select kind nlo (lo xr))
                        (gen_select kind nhi (hi xr))))))

;;;; Rules for `bswap` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (bswap $I16 x)) (output_reg (gen_bswap $I16 (put_in_reg x))))
(rule (lower (bswap $I32 x)) (output_reg (gen_bswap $I32 (put_in_reg x))))
(rule (lower (bswap $I64 x)) (output_reg (gen_bswap $I64 (put_in_reg x))))

;; Byte-reversing 128 bits swaps the two doublewords as well as the
;; bytes within each.
(rule (lower (bswap $I128 x))
  (let ((xr ValueRegs (put_in_regs x)))
    (output (value_regs (gen_bswap $I64 (hi xr))
                        (gen_bswap $I64 (lo xr))))))

;;;; Rules for `bitrev` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Reverse the bytes with the `bswap` sequence, then reverse the bits
;; inside each byte with three swap-and-merge rounds. For narrow types
;; the wanted bits end up at the top of the register, so a single
;; shift finishes the job (whatever garbage the upper input bits held
;; is shifted out).

(decl bitrev64 (Reg) Reg)
(rule (bitrev64 x)
  (let ((b Reg (gen_bswap $I64 x))
        (m4 Reg (imm $I64 0x0f0f0f0f0f0f0f0f))
        (t4 Reg (ppc_or (gen_shift (ShiftOp.Sld) (ppc_and b m4) (imm $I64 4))
                        (ppc_and (gen_shift (ShiftOp.Srd) b (imm $I64 4)) m4)))
        (m2 Reg (imm $I64 0x3333333333333333))
        (t2 Reg (ppc_or (gen_shift (ShiftOp.Sld) (ppc_and t4 m2) (imm $I64 2))
                        (ppc_and (gen_shift (ShiftOp.Srd) t4 (imm $I64 2)) m2)))
        (m1 Reg (imm $I64 0x5555555555555555)))
    (ppc_or (gen_shift (ShiftOp.Sld) (ppc_and t2 m1) (imm $I64 1))
            (ppc_and (gen_shift (ShiftOp.Srd) t2 (imm $I64 1)) m1))))

(rule (lower (bitrev $I8 x))
  (output_reg (gen_shift (ShiftOp.Srd) (bitrev64 (put_in_reg x)) (imm $I64 56))))
(rule (lower (bitrev $I16 x))
  (output_reg (gen_shift (ShiftOp.Srd) (bitrev64 (put_in_reg x)) (imm $I64 48))))
(rule (lower (bitrev $I32 x))
  (output_reg (gen_shift (ShiftOp.Srd) (bitrev64 (put_in_reg x)) (imm $I64 32))))
(rule (lower (bitrev $I64 x))
  (output_reg (bitrev64 (put_in_reg x))))

(rule (lower (bitrev $I128 x))
  (let ((xr ValueRegs (put_in_regs x)))
    (output (value_regs (bitrev64 (hi xr))
                        (bitrev64 (lo xr))))))

;;;; `bmask` with an `i128` on either side ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(decl bmask64 (Reg) Reg)
(rule (bmask64 c)
  (gen_select (int_compare (IntCC.NotEqual) c (imm $I64 0) $I64)
              (imm $I64 0xffffffffffffffff)
              (imm $I64 0)))

(rule 1 (lower (bmask (fits_in_64 (ty_int _)) val @ (value_type $I128)))
  (let ((vr ValueRegs (put_in_regs val)))
    (output_reg (bmask64 (ppc_or (lo vr) (hi vr))))))

(rule 3 (lower (bmask $I128 val @ (value_type (fits_in_64 in_ty))))
  (let ((m Reg (bmask64 (put_in_cmp_reg val (IntCC.NotEqual) in_ty))))
    (output (value_regs m m))))

(rule 2 (lower (bmask $I128 val @ (value_type $I128)))
  (let ((vr ValueRegs (put_in_regs val))
        (m Reg (bmask64 (ppc_or (lo vr) (hi vr)))))
    (output (value_regs m m))))

;;;; Rules for `ceil`/`floor`/`trunc`/`nearest` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; All four operate on the double held in the FPR; an `f32` input
;; rounds to an integer that is exactly representable in `f32` (values
;; of magnitude 2^24 and above are already integral), so no re-round
;; to single is needed.

(rule (lower (ceil (ty_scalar_float _) x))
  (output_reg (fpu_round (FpuRoundMode.Ceil) (put_in_reg x))))
(rule (lower (floor (ty_scalar_float _) x))
  (output_reg (fpu_round (FpuRoundMode.Floor) (put_in_reg x))))
(rule (lower (trunc (ty_scalar_float _) x))
  (output_reg (fpu_round (FpuRoundMode.Trunc) (put_in_reg x))))
(rule (lower (nearest (ty_scalar_float _) x))
  (output_reg (fpu_round (FpuRoundMode.Nearest) (put_in_reg x))))

;;;; 128-bit atomics ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; All four go through `lqarx`/`stqcx.` pseudo-loops with pinned
;; registers; see the instruction definitions. Note that a CLIF atomic
;; access requires natural (16-byte) alignment, which is also what the
;; reservation instructions require.

(rule 1 (lower (atomic_load $I128 (little_or_native_endian _flags) p))
  (output (gen_atomic_load128 (put_in_reg p))))

(rule 1 (lower (atomic_store (little_or_native_endian _flags)
                             src @ (value_type $I128)
                             p))
  (let ((sr ValueRegs (put_in_regs src)))
    (side_effect (gen_atomic_store128 (lo sr) (hi sr) (put_in_reg p)))))

(rule 1 (lower (atomic_rmw $I128 (little_or_native_endian _flags) op p x))
  (let ((xr ValueRegs (put_in_regs x)))
    (output (gen_atomic_rmw128 op (put_in_reg p) (lo xr) (hi xr)))))

(rule 1 (lower (atomic_cas $I128 (little_or_native_endian _flags) p e x))
  (let ((er ValueRegs (put_in_regs e))
        (xr ValueRegs (put_in_regs x)))
    (output (gen_atomic_cas128 (put_in_reg p)
                               (lo er) (hi er)
                               (lo xr) (hi xr)))))

;;;; Vector (128-bit SIMD) foundations ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Lane order is little-endian throughout: wasm lane 0 lives in the
;; least-significant bits of the register and at the lowest memory
;; address. PPC's own element numbering is big-endian (element 0 = most
;; significant), so lane-indexed instructions translate the index; the
;; memory instructions are chosen so that no other rule ever sees the
;; difference (see `VecLoad` in inst.isle).

;;;; Loads and stores

(rule 2 (lower (load (ty_vec128 _) (little_or_native_endian flags) addr offset))
  (output_reg (gen_vec_load (amode addr offset) flags)))

(rule 2 (lower (store (little_or_native_endian flags)
                      val @ (value_type (ty_vec128 _)) addr offset))
  (side_effect (gen_vec_store (amode addr offset) flags (put_in_reg val))))

;;;; Constants

;; Zero comes free; the general case goes through the GPRs: two 64-bit
;; halves, `mtvsrd` into big-endian doubleword 0 of two scratch vectors,
;; then `xxpermdi` pairs them with the high half in BE doubleword 0 (the
;; high lanes). Both live in `vec_const`, which the permute-control
;; vector below also uses.
(rule (lower (vconst (ty_vec128 _) (u128_from_constant n)))
  (output_reg (vec_const n)))

;;;; Splats

(rule (lower (splat $I8X16 x))
  (output_reg (vec_splat_lane (mov_to_vec (put_in_reg x)) $I8X16)))
(rule (lower (splat $I16X8 x))
  (output_reg (vec_splat_lane (mov_to_vec (put_in_reg x)) $I16X8)))
(rule (lower (splat $I32X4 x))
  (output_reg (vec_splat_lane (mov_to_vec (put_in_reg x)) $I32X4)))
(rule (lower (splat $I64X2 x))
  (output_reg (vec_splat_lane (mov_to_vec (put_in_reg x)) $I64X2)))

;; A scalar `f32` is held widened to double; `xscvdpspn` deposits its
;; single-precision bits in big-endian word 0, which `xxspltw` then
;; replicates. An `f64` doubles its doubleword with `xxpermdi`.
(rule (lower (splat $F32X4 x))
  (output_reg (vec_splat_fpr (fpu_rr (FpuOp1.CvtToSingleBits) (put_in_reg x) $F32)
                             true)))
(rule (lower (splat $F64X2 x))
  (output_reg (vec_splat_fpr (put_in_reg x) false)))

;;;; Integer lane arithmetic

(rule 4 (lower (iadd (ty_vec128 ty) x y))
  (output_reg (vec_alu_rrr (VecAluOp.Add) (put_in_reg x) (put_in_reg y) ty)))

(rule 4 (lower (isub (ty_vec128 ty) x y))
  (output_reg (vec_alu_rrr (VecAluOp.Sub) (put_in_reg x) (put_in_reg y) ty)))

;;;; Bitwise logic

(rule 2 (lower (band (ty_vec128 ty) x y))
  (output_reg (vec_alu_rrr (VecAluOp.And) (put_in_reg x) (put_in_reg y) ty)))
(rule 2 (lower (bor (ty_vec128 ty) x y))
  (output_reg (vec_alu_rrr (VecAluOp.Or) (put_in_reg x) (put_in_reg y) ty)))
(rule 2 (lower (bxor (ty_vec128 ty) x y))
  (output_reg (vec_alu_rrr (VecAluOp.Xor) (put_in_reg x) (put_in_reg y) ty)))
(rule 2 (lower (bnot (ty_vec128 ty) x))
  (let ((xr Reg (put_in_reg x)))
    (output_reg (vec_alu_rrr (VecAluOp.Nor) xr xr ty))))

;;;; Bitcasts between 128-bit vector types are pure reinterpretation.

(rule 2 (lower (bitcast (ty_vec128 _) _ x @ (value_type (ty_vec128 _))))
  (output_reg (put_in_reg x)))

;;;; Vector comparisons ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; A CLIF vector `icmp` yields an all-ones lane for true and all-zeros
;; for false, which is exactly what the hardware compares produce. Only
;; equality and signed/unsigned greater-than exist as instructions, so
;; the other six conditions come from swapping the operands (turning
;; `>` into `<`) and complementing the mask (turning `<` into `>=`).

(rule 3 (lower (icmp (ty_vec_any ty) (IntCC.Equal) x y))
  (output_reg (vec_alu_rrr (VecAluOp.CmpEq) (put_in_reg x) (put_in_reg y) ty)))

(rule 3 (lower (icmp (ty_vec_any ty) (IntCC.NotEqual) x y))
  (output_reg
    (vec_not (vec_alu_rrr (VecAluOp.CmpEq) (put_in_reg x) (put_in_reg y) ty) ty)))

(rule 3 (lower (icmp (ty_vec_any ty) (IntCC.SignedGreaterThan) x y))
  (output_reg (vec_alu_rrr (VecAluOp.CmpGtS) (put_in_reg x) (put_in_reg y) ty)))

(rule 3 (lower (icmp (ty_vec_any ty) (IntCC.SignedLessThan) x y))
  (output_reg (vec_alu_rrr (VecAluOp.CmpGtS) (put_in_reg y) (put_in_reg x) ty)))

(rule 3 (lower (icmp (ty_vec_any ty) (IntCC.SignedGreaterThanOrEqual) x y))
  (output_reg
    (vec_not (vec_alu_rrr (VecAluOp.CmpGtS) (put_in_reg y) (put_in_reg x) ty) ty)))

(rule 3 (lower (icmp (ty_vec_any ty) (IntCC.SignedLessThanOrEqual) x y))
  (output_reg
    (vec_not (vec_alu_rrr (VecAluOp.CmpGtS) (put_in_reg x) (put_in_reg y) ty) ty)))

(rule 3 (lower (icmp (ty_vec_any ty) (IntCC.UnsignedGreaterThan) x y))
  (output_reg (vec_alu_rrr (VecAluOp.CmpGtU) (put_in_reg x) (put_in_reg y) ty)))

(rule 3 (lower (icmp (ty_vec_any ty) (IntCC.UnsignedLessThan) x y))
  (output_reg (vec_alu_rrr (VecAluOp.CmpGtU) (put_in_reg y) (put_in_reg x) ty)))

(rule 3 (lower (icmp (ty_vec_any ty) (IntCC.UnsignedGreaterThanOrEqual) x y))
  (output_reg
    (vec_not (vec_alu_rrr (VecAluOp.CmpGtU) (put_in_reg y) (put_in_reg x) ty) ty)))

(rule 3 (lower (icmp (ty_vec_any ty) (IntCC.UnsignedLessThanOrEqual) x y))
  (output_reg
    (vec_not (vec_alu_rrr (VecAluOp.CmpGtU) (put_in_reg x) (put_in_reg y) ty) ty)))

;;;; Vector integer min/max ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule 2 (lower (smin (ty_vec_any ty) x y))
  (output_reg (vec_alu_rrr (VecAluOp.MinS) (put_in_reg x) (put_in_reg y) ty)))
(rule 2 (lower (umin (ty_vec_any ty) x y))
  (output_reg (vec_alu_rrr (VecAluOp.MinU) (put_in_reg x) (put_in_reg y) ty)))
(rule 2 (lower (smax (ty_vec_any ty) x y))
  (output_reg (vec_alu_rrr (VecAluOp.MaxS) (put_in_reg x) (put_in_reg y) ty)))
(rule 2 (lower (umax (ty_vec_any ty) x y))
  (output_reg (vec_alu_rrr (VecAluOp.MaxU) (put_in_reg x) (put_in_reg y) ty)))

;;;; Vector shifts ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; CLIF supplies one scalar amount for the whole vector; the hardware
;; wants it per lane, so it is splatted first. No masking: the hardware
;; already uses only the low log2(lane width) bits of each element.

(rule 6 (lower (ishl (ty_vec_any ty) x y))
  (output_reg (vec_alu_rrr (VecAluOp.Shl) (put_in_reg x) (vec_shift_amount y ty) ty)))

(rule 6 (lower (ushr (ty_vec_any ty) x y))
  (output_reg (vec_alu_rrr (VecAluOp.ShrU) (put_in_reg x) (vec_shift_amount y ty) ty)))

(rule 6 (lower (sshr (ty_vec_any ty) x y))
  (output_reg (vec_alu_rrr (VecAluOp.ShrS) (put_in_reg x) (vec_shift_amount y ty) ty)))

;;;; Floating-point lane arithmetic ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule 2 (lower (fadd (ty_vec_any ty) x y))
  (output_reg (vec_fpu_rrr (VecFpuOp2.Add) (put_in_reg x) (put_in_reg y) ty)))
(rule 2 (lower (fsub (ty_vec_any ty) x y))
  (output_reg (vec_fpu_rrr (VecFpuOp2.Sub) (put_in_reg x) (put_in_reg y) ty)))
(rule 2 (lower (fmul (ty_vec_any ty) x y))
  (output_reg (vec_fpu_rrr (VecFpuOp2.Mul) (put_in_reg x) (put_in_reg y) ty)))
(rule 2 (lower (fdiv (ty_vec_any ty) x y))
  (output_reg (vec_fpu_rrr (VecFpuOp2.Div) (put_in_reg x) (put_in_reg y) ty)))

(rule 2 (lower (sqrt (ty_vec_any ty) x))
  (output_reg (vec_fpu_rr (VecFpuOp1.Sqrt) (put_in_reg x) ty)))
(rule 2 (lower (fneg (ty_vec_any ty) x))
  (output_reg (vec_fpu_rr (VecFpuOp1.Neg) (put_in_reg x) ty)))
(rule 2 (lower (fabs (ty_vec_any ty) x))
  (output_reg (vec_fpu_rr (VecFpuOp1.Abs) (put_in_reg x) ty)))

;;;; Vector floating-point comparisons ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; The hardware provides ordered equal, greater-than and
;; greater-or-equal; each is false when either operand is NaN. The
;; unordered-aware conditions come from complementing (CLIF's
;; `NotEqual` is "unordered or not equal", so it is exactly the
;; complement of ordered equality) and from swapping operands to turn
;; `>` into `<`.

(decl vec_fcmp (VecFpuOp2 Value Value Type) Reg)
(rule (vec_fcmp op x y ty)
  (vec_fpu_rrr op (put_in_reg x) (put_in_reg y) ty))

(rule 2 (lower (fcmp _ (FloatCC.Equal) x @ (value_type (ty_vec_any ty)) y))
  (output_reg (vec_fcmp (VecFpuOp2.CmpEq) x y ty)))

(rule 2 (lower (fcmp _ (FloatCC.NotEqual) x @ (value_type (ty_vec_any ty)) y))
  (output_reg (vec_not (vec_fcmp (VecFpuOp2.CmpEq) x y ty) ty)))

(rule 2 (lower (fcmp _ (FloatCC.GreaterThan) x @ (value_type (ty_vec_any ty)) y))
  (output_reg (vec_fcmp (VecFpuOp2.CmpGt) x y ty)))

(rule 2 (lower (fcmp _ (FloatCC.GreaterThanOrEqual) x @ (value_type (ty_vec_any ty)) y))
  (output_reg (vec_fcmp (VecFpuOp2.CmpGe) x y ty)))

(rule 2 (lower (fcmp _ (FloatCC.LessThan) x @ (value_type (ty_vec_any ty)) y))
  (output_reg (vec_fcmp (VecFpuOp2.CmpGt) y x ty)))

(rule 2 (lower (fcmp _ (FloatCC.LessThanOrEqual) x @ (value_type (ty_vec_any ty)) y))
  (output_reg (vec_fcmp (VecFpuOp2.CmpGe) y x ty)))

;; A value is ordered exactly when it equals itself, so a pair is
;; ordered when both self-comparisons hold -- and unordered when they
;; do not *both* hold. That is a NAND, not a NOR: with one NaN and one
;; normal operand the two differ, and only the NAND is right.
(decl vec_ford (Value Value Type) Reg)
(rule (vec_ford x y ty)
  (vec_alu_rrr (VecAluOp.And)
               (vec_fcmp (VecFpuOp2.CmpEq) x x ty)
               (vec_fcmp (VecFpuOp2.CmpEq) y y ty)
               ty))

(rule 2 (lower (fcmp _ (FloatCC.Ordered) x @ (value_type (ty_vec_any ty)) y))
  (output_reg (vec_ford x y ty)))

(rule 2 (lower (fcmp _ (FloatCC.Unordered) x @ (value_type (ty_vec_any ty)) y))
  (output_reg (vec_not (vec_ford x y ty) ty)))

;; The remaining conditions are the unordered-tolerant counterparts of
;; the strict ones. Since every hardware compare is false when either
;; operand is NaN, complementing a strict compare yields exactly
;; "unordered or the opposite", which is what CLIF's `Unordered*`
;; conditions mean.
(rule 2 (lower (fcmp _ (FloatCC.UnorderedOrLessThan) x @ (value_type (ty_vec_any ty)) y))
  (output_reg (vec_not (vec_fcmp (VecFpuOp2.CmpGe) x y ty) ty)))

(rule 2 (lower (fcmp _ (FloatCC.UnorderedOrLessThanOrEqual) x @ (value_type (ty_vec_any ty)) y))
  (output_reg (vec_not (vec_fcmp (VecFpuOp2.CmpGt) x y ty) ty)))

(rule 2 (lower (fcmp _ (FloatCC.UnorderedOrGreaterThan) x @ (value_type (ty_vec_any ty)) y))
  (output_reg (vec_not (vec_fcmp (VecFpuOp2.CmpGe) y x ty) ty)))

(rule 2 (lower (fcmp _ (FloatCC.UnorderedOrGreaterThanOrEqual) x @ (value_type (ty_vec_any ty)) y))
  (output_reg (vec_not (vec_fcmp (VecFpuOp2.CmpGt) y x ty) ty)))

;; Equality that tolerates NaN, and its strict-ordered complement:
;; neither operand greater means equal-or-unordered, and either one
;; greater means ordered-and-unequal.
(rule 2 (lower (fcmp _ (FloatCC.UnorderedOrEqual) x @ (value_type (ty_vec_any ty)) y))
  (output_reg (vec_alu_rrr (VecAluOp.Nor)
                           (vec_fcmp (VecFpuOp2.CmpGt) x y ty)
                           (vec_fcmp (VecFpuOp2.CmpGt) y x ty)
                           ty)))

(rule 2 (lower (fcmp _ (FloatCC.OrderedNotEqual) x @ (value_type (ty_vec_any ty)) y))
  (output_reg (vec_alu_rrr (VecAluOp.Or)
                           (vec_fcmp (VecFpuOp2.CmpGt) x y ty)
                           (vec_fcmp (VecFpuOp2.CmpGt) y x ty)
                           ty)))

;;;; Vector `iabs` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; No vector absolute-value instruction exists: take the signed maximum
;; of the value and its negation. This gives CLIF's wrapping behaviour
;; for the most negative lane value for free, since negating it yields
;; itself and the maximum is then also itself.

(rule 2 (lower (iabs (ty_vec_any ty) x))
  (let ((xr Reg (put_in_reg x))
        (neg Reg (vec_alu_rrr (VecAluOp.Sub) (vec_zero) xr ty)))
    (output_reg (vec_alu_rrr (VecAluOp.MaxS) xr neg ty))))

;;;; Vector rounding average ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (avg_round (ty_vec128 ty) x y))
  (if-let true (vec_lanes_under_64 ty))
  (output_reg (vec_alu_rrr (VecAluOp.AvgRoundU) (put_in_reg x) (put_in_reg y) ty)))

;;;; Vector lane reductions ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule 1 (lower (vall_true _ x @ (value_type (ty_vec128 ty))))
  (output_reg (vec_test_lanes (put_in_reg x) ty true)))

(rule 1 (lower (vany_true _ x @ (value_type (ty_vec128 ty))))
  (output_reg (vec_test_lanes (put_in_reg x) ty false)))

;;;; Lane extract and insert ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Integer lanes come out through a splat-and-read sequence and go in
;; through a red-zone round-trip; float lanes convert at the boundary
;; between the raw lane bits and the widened-double form scalars use.
;; See the instruction definitions for the endianness reasoning.

(rule (lower (extractlane _ x @ (value_type $I8X16) (u8_from_uimm8 lane)))
  (output_reg (vec_extract_lane_int (put_in_reg x) $I8X16 lane)))
(rule (lower (extractlane _ x @ (value_type $I16X8) (u8_from_uimm8 lane)))
  (output_reg (vec_extract_lane_int (put_in_reg x) $I16X8 lane)))
(rule (lower (extractlane _ x @ (value_type $I32X4) (u8_from_uimm8 lane)))
  (output_reg (vec_extract_lane_int (put_in_reg x) $I32X4 lane)))
(rule (lower (extractlane _ x @ (value_type $I64X2) (u8_from_uimm8 lane)))
  (output_reg (vec_extract_lane_int (put_in_reg x) $I64X2 lane)))
(rule (lower (extractlane _ x @ (value_type $F32X4) (u8_from_uimm8 lane)))
  (output_reg (vec_extract_lane_fpu (put_in_reg x) $F32X4 lane)))
(rule (lower (extractlane _ x @ (value_type $F64X2) (u8_from_uimm8 lane)))
  (output_reg (vec_extract_lane_fpu (put_in_reg x) $F64X2 lane)))

(rule (lower (insertlane _ x @ (value_type (ty_vec128 ty)) y (u8_from_uimm8 lane)))
  (output_reg (vec_insert_lane (put_in_reg x) (put_in_reg y) ty lane)))

;; Vector bitselect is a single `xxsel`.
(rule 2 (lower (bitselect (ty_vec_any _) mask x y))
  (output_reg (vec_sel (put_in_reg x) (put_in_reg y) (put_in_reg mask))))

;;;; Vector saturating arithmetic, popcnt and rounding ;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (sadd_sat (ty_vec_any ty) x y))
  (if-let true (vec_lanes_under_64 ty))
  (output_reg (vec_alu_rrr (VecAluOp.SAddSat) (put_in_reg x) (put_in_reg y) ty)))
(rule (lower (uadd_sat (ty_vec_any ty) x y))
  (if-let true (vec_lanes_under_64 ty))
  (output_reg (vec_alu_rrr (VecAluOp.UAddSat) (put_in_reg x) (put_in_reg y) ty)))
(rule (lower (ssub_sat (ty_vec_any ty) x y))
  (if-let true (vec_lanes_under_64 ty))
  (output_reg (vec_alu_rrr (VecAluOp.SSubSat) (put_in_reg x) (put_in_reg y) ty)))
(rule (lower (usub_sat (ty_vec_any ty) x y))
  (if-let true (vec_lanes_under_64 ty))
  (output_reg (vec_alu_rrr (VecAluOp.USubSat) (put_in_reg x) (put_in_reg y) ty)))

(rule 3 (lower (popcnt (ty_vec_any ty) x))
  (output_reg (vec_unary (VecUnaryOp.Popcnt) (put_in_reg x) ty)))

(rule 2 (lower (ceil (ty_vec_any ty) x))
  (output_reg (vec_round (FpuRoundMode.Ceil) (put_in_reg x) ty)))
(rule 2 (lower (floor (ty_vec_any ty) x))
  (output_reg (vec_round (FpuRoundMode.Floor) (put_in_reg x) ty)))
(rule 2 (lower (trunc (ty_vec_any ty) x))
  (output_reg (vec_round (FpuRoundMode.Trunc) (put_in_reg x) ty)))
(rule 2 (lower (nearest (ty_vec_any ty) x))
  (output_reg (vec_round (FpuRoundMode.Nearest) (put_in_reg x) ty)))

;;;; Vector widening and narrowing ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; The instruction names invert against CLIF's here, and it is worth
;; being explicit about why. PPC numbers vector elements big-endian, so
;; its "high" elements are the register's most-significant bytes --
;; which under this backend's little-endian lane order are CLIF's *high*
;; lanes. Working it through for bytes, where LE lane i is BE element
;; 15-i: `vupkhsb` reads BE elements 0-7, i.e. LE lanes 8-15, so it
;; implements `swiden_high`; `vupklsb` reads BE elements 8-15, i.e. LE
;; lanes 0-7, so it implements `swiden_low`. Every rule below is
;; selected by the *source* lane width.

(rule (lower (swiden_low _ x @ (value_type (ty_vec128 in_ty))))
  (if-let true (vec_lanes_under_64 in_ty))
  (output_reg (vec_unary (VecUnaryOp.WidenSLow) (put_in_reg x) in_ty)))

(rule (lower (swiden_high _ x @ (value_type (ty_vec128 in_ty))))
  (if-let true (vec_lanes_under_64 in_ty))
  (output_reg (vec_unary (VecUnaryOp.WidenSHigh) (put_in_reg x) in_ty)))

;; There are no unsigned unpack instructions, so interleave with zero:
;; each source lane is paired with a zero lane of the same width, which
;; is a zero-extension to double width. The zero vector supplies the
;; more-significant half of each pair, so it is the first operand.
(rule (lower (uwiden_low _ x @ (value_type (ty_vec128 in_ty))))
  (if-let true (vec_lanes_under_64 in_ty))
  (output_reg (vec_alu_rrr (VecAluOp.MergeLow) (vec_zero) (put_in_reg x) in_ty)))

(rule (lower (uwiden_high _ x @ (value_type (ty_vec128 in_ty))))
  (if-let true (vec_lanes_under_64 in_ty))
  (output_reg (vec_alu_rrr (VecAluOp.MergeHigh) (vec_zero) (put_in_reg x) in_ty)))

;; The pack instructions put their first operand in the result's
;; big-endian-low elements, which are the little-endian *high* lanes.
;; CLIF's `snarrow(x, y)` wants x in the low lanes, so the operands are
;; swapped.
(rule (lower (snarrow _ x @ (value_type (ty_vec128 in_ty)) y))
  (if-let true (vec_lanes_over_8 in_ty))
  (output_reg (vec_alu_rrr (VecAluOp.PackSS) (put_in_reg y) (put_in_reg x) in_ty)))

(rule (lower (unarrow _ x @ (value_type (ty_vec128 in_ty)) y))
  (if-let true (vec_lanes_over_8 in_ty))
  (output_reg (vec_alu_rrr (VecAluOp.PackSU) (put_in_reg y) (put_in_reg x) in_ty)))

(rule (lower (uunarrow _ x @ (value_type (ty_vec128 in_ty)) y))
  (if-let true (vec_lanes_over_8 in_ty))
  (output_reg (vec_alu_rrr (VecAluOp.PackUU) (put_in_reg y) (put_in_reg x) in_ty)))

;;;; Vector integer multiply ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Only the per-lane forms are here. The even/odd multiplies, which the
;; remaining widths and the high-half operations need, pick out
;; alternating big-endian elements and so carry the same lane-order
;; inversion as the pack and unpack instructions; they are left for
;; their own change rather than derived in passing.

(rule 5 (lower (imul $I16X8 x y))
  (output_reg (vec_alu_rrrr (VecAluOp4.MulAddUH)
                            (put_in_reg x) (put_in_reg y) (vec_zero))))

(rule 5 (lower (imul $I32X4 x y))
  (output_reg (vec_alu_rrr (VecAluOp.MulWord) (put_in_reg x) (put_in_reg y) $I32X4)))

;; Q15 saturating rounding multiply: the instruction computes
;; sat((a * b + 0x4000) >> 15) + c, so a zero addend gives exactly the
;; CLIF operation.
(rule (lower (sqmul_round_sat $I16X8 x y))
  (output_reg (vec_alu_rrrr (VecAluOp4.MulHiRoundAddSHS)
                            (put_in_reg x) (put_in_reg y) (vec_zero))))

;; Doubleword multiply has no single instruction before POWER10, so it
;; is built from the 32-bit halves:
;;
;;   a * b  ==  al*bl + (al*bh + ah*bl) * 2^32   (mod 2^64)
;;
;; the ah*bh term falling outside 64 bits. `vmulouw` supplies al*bl
;; directly -- see the note on `MulOddWordU` for why the "odd"
;; mnemonic denotes the low word here -- and rotating each doubleword
;; by 32 swaps its halves, so the same instruction applied to a
;; rotated operand gives a cross product. The shift amount comes from
;; a general register because `vspltisw`'s immediate only reaches 15.
(rule 5 (lower (imul $I64X2 x y))
  (let ((xr Reg (put_in_reg x))
        (yr Reg (put_in_reg y))
        (c32 Reg (vec_splat_lane (mov_to_vec (imm $I64 32)) $I64X2))
        ;; Word sources, doubleword products: the op is selected by the
        ;; source width, so this is $I32X4 even though the lanes being
        ;; multiplied are halves of $I64X2 lanes.
        (lo Reg (vec_alu_rrr (VecAluOp.MulOddU) xr yr $I32X4))
        (y_swapped Reg (vec_alu_rrr (VecAluOp.Rotl) yr c32 $I64X2))
        (x_swapped Reg (vec_alu_rrr (VecAluOp.Rotl) xr c32 $I64X2))
        (cross_a Reg (vec_alu_rrr (VecAluOp.MulOddU) xr y_swapped $I32X4))
        (cross_b Reg (vec_alu_rrr (VecAluOp.MulOddU) x_swapped yr $I32X4))
        (cross Reg (vec_alu_rrr (VecAluOp.Add) cross_a cross_b $I64X2))
        (shifted Reg (vec_alu_rrr (VecAluOp.Shl) cross c32 $I64X2)))
    (output_reg (vec_alu_rrr (VecAluOp.Add) lo shifted $I64X2))))

;;;; Vector high-half multiply ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; The even/odd multiplies give full double-width products of alternate
;; lanes, so the high halves have to be gathered back into one vector.
;; Naming the intermediates by *lane order* rather than by mnemonic:
;; `evens` holds the products of the even little-endian lanes (from the
;; instruction whose mnemonic says "odd") and `odds` the products of the
;; odd lanes.
;;
;; At word width the gather is a single instruction. A doubleword's high
;; word is its odd little-endian word lane, and `vmrgew` interleaves
;; exactly the odd little-endian word lanes of its two operands, in the
;; order (second operand's, first operand's, ...) -- so it collects the
;; four high words directly.
(decl mulhi_i32x4 (Reg Reg) Reg)
(rule (mulhi_i32x4 evens odds)
  (vec_alu_rrr (VecAluOp.MergeEvenWord) odds evens $I32X4))

(rule 3 (lower (smulhi $I32X4 x y))
  (output_reg (mulhi_i32x4
                (vec_alu_rrr (VecAluOp.MulOddS) (put_in_reg x) (put_in_reg y) $I32X4)
                (vec_alu_rrr (VecAluOp.MulEvenS) (put_in_reg x) (put_in_reg y) $I32X4))))

(rule 3 (lower (umulhi $I32X4 x y))
  (output_reg (mulhi_i32x4
                (vec_alu_rrr (VecAluOp.MulOddU) (put_in_reg x) (put_in_reg y) $I32X4)
                (vec_alu_rrr (VecAluOp.MulEvenU) (put_in_reg x) (put_in_reg y) $I32X4))))

;; At the narrower widths there is no merge for the needed granularity,
;; so the products are first interleaved back into source order with the
;; ordinary merges, then each one's high half is moved down and the two
;; halves packed. The shift amount comes from a splat immediate whose
;; *low bits* carry it: the vector shifts read only log2(lane width)
;; bits of each element, so -16 splatted to words shifts by 16.
(decl mulhi_narrow (Reg Reg Type Type i8) Reg)
(rule (mulhi_narrow evens odds prod_ty out_ty shift)
  (let ((lo Reg (vec_alu_rrr (VecAluOp.MergeLow) odds evens prod_ty))
        (hi Reg (vec_alu_rrr (VecAluOp.MergeHigh) odds evens prod_ty))
        (amt Reg (vec_splt_imm shift prod_ty))
        (lo_sh Reg (vec_alu_rrr (VecAluOp.ShrU) lo amt prod_ty))
        (hi_sh Reg (vec_alu_rrr (VecAluOp.ShrU) hi amt prod_ty)))
    (vec_alu_rrr (VecAluOp.PackMod) hi_sh lo_sh prod_ty)))

(rule 3 (lower (smulhi $I16X8 x y))
  (output_reg (mulhi_narrow
                (vec_alu_rrr (VecAluOp.MulOddS) (put_in_reg x) (put_in_reg y) $I16X8)
                (vec_alu_rrr (VecAluOp.MulEvenS) (put_in_reg x) (put_in_reg y) $I16X8)
                $I32X4 $I16X8 -16)))

(rule 3 (lower (umulhi $I16X8 x y))
  (output_reg (mulhi_narrow
                (vec_alu_rrr (VecAluOp.MulOddU) (put_in_reg x) (put_in_reg y) $I16X8)
                (vec_alu_rrr (VecAluOp.MulEvenU) (put_in_reg x) (put_in_reg y) $I16X8)
                $I32X4 $I16X8 -16)))

(rule 3 (lower (smulhi $I8X16 x y))
  (output_reg (mulhi_narrow
                (vec_alu_rrr (VecAluOp.MulOddS) (put_in_reg x) (put_in_reg y) $I8X16)
                (vec_alu_rrr (VecAluOp.MulEvenS) (put_in_reg x) (put_in_reg y) $I8X16)
                $I16X8 $I8X16 8)))

(rule 3 (lower (umulhi $I8X16 x y))
  (output_reg (mulhi_narrow
                (vec_alu_rrr (VecAluOp.MulOddU) (put_in_reg x) (put_in_reg y) $I8X16)
                (vec_alu_rrr (VecAluOp.MulEvenU) (put_in_reg x) (put_in_reg y) $I8X16)
                $I16X8 $I8X16 8)))

;;;; Pairwise addition ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; There is no horizontal-add instruction, but a pair of adjacent lanes
;; is exactly one lane of the next width up, holding the even element in
;; its low half and the odd element in its high half. So shifting a
;; double-width lane down by one element width brings the odd element
;; alongside the even one, and a double-width add leaves their sum in the
;; low half -- the carry out of it corrupts only the high half, which the
;; pack then discards. The first operand supplies the result's low lanes,
;; which is the second argument to the pack.
(decl iadd_pairwise_via (Reg Reg Reg Type) Reg)
(rule (iadd_pairwise_via xr yr amt wide_ty)
  (let ((xs Reg (vec_alu_rrr (VecAluOp.Add) xr
                             (vec_alu_rrr (VecAluOp.ShrU) xr amt wide_ty)
                             wide_ty))
        (ys Reg (vec_alu_rrr (VecAluOp.Add) yr
                             (vec_alu_rrr (VecAluOp.ShrU) yr amt wide_ty)
                             wide_ty)))
    (vec_alu_rrr (VecAluOp.PackMod) ys xs wide_ty)))

;; The shift amounts ride in the low bits of a splat immediate where
;; they fit: the shifts read only log2(lane width) bits per element, so
;; -16 splatted to words means sixteen. A doubleword shift of
;; thirty-two has no such encoding -- no five-bit immediate is
;; congruent to it modulo sixty-four -- so that one comes through a
;; general register.
(rule (lower (iadd_pairwise $I8X16 x y))
  (output_reg (iadd_pairwise_via (put_in_reg x) (put_in_reg y)
                                 (vec_splt_imm 8 $I16X8) $I16X8)))

(rule (lower (iadd_pairwise $I16X8 x y))
  (output_reg (iadd_pairwise_via (put_in_reg x) (put_in_reg y)
                                 (vec_splt_imm -16 $I32X4) $I32X4)))

(rule (lower (iadd_pairwise $I32X4 x y))
  (output_reg (iadd_pairwise_via (put_in_reg x) (put_in_reg y)
                                 (vec_splat_lane (mov_to_vec (imm $I64 32)) $I64X2)
                                 $I64X2)))

;;;; Float/integer lane conversions ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; The hardware conversions truncate toward zero and saturate to the
;; representable range, matching CLIF's saturating conversions. Their
;; NaN behaviour differs by signedness, which was measured on a POWER9
;; rather than taken from the manual: an unsigned conversion already
;; yields zero for a NaN lane, which is what CLIF wants, but a signed
;; one yields the most negative value. So the signed rules mask the
;; result with the source compared against itself -- all ones for an
;; ordered lane, all zeros where the source was NaN.

(decl fcvt_to_sint_sat_masked (VecCvtOp VecFpuOp2 Value Type) Reg)
(rule (fcvt_to_sint_sat_masked cvt cmp x ty)
  (let ((xr Reg (put_in_reg x))
        (converted Reg (vec_cvt cvt xr))
        (ordered Reg (vec_fpu_rrr cmp xr xr ty)))
    (vec_alu_rrr (VecAluOp.And) converted ordered ty)))

(rule 2 (lower (fcvt_to_sint_sat $I32X4 x @ (value_type $F32X4)))
  (output_reg (fcvt_to_sint_sat_masked (VecCvtOp.F32ToI32S) (VecFpuOp2.CmpEq)
                                       x $F32X4)))

(rule 2 (lower (fcvt_to_sint_sat $I64X2 x @ (value_type $F64X2)))
  (output_reg (fcvt_to_sint_sat_masked (VecCvtOp.F64ToI64S) (VecFpuOp2.CmpEq)
                                       x $F64X2)))

;; No mask needed: these already give zero for a NaN lane, and zero for
;; a negative source, both of which are what CLIF specifies.
(rule 2 (lower (fcvt_to_uint_sat $I32X4 x @ (value_type $F32X4)))
  (output_reg (vec_cvt (VecCvtOp.F32ToI32U) (put_in_reg x))))

(rule 2 (lower (fcvt_to_uint_sat $I64X2 x @ (value_type $F64X2)))
  (output_reg (vec_cvt (VecCvtOp.F64ToI64U) (put_in_reg x))))

(rule 2 (lower (fcvt_from_sint $F32X4 x @ (value_type $I32X4)))
  (output_reg (vec_cvt (VecCvtOp.I32ToF32S) (put_in_reg x))))

(rule 2 (lower (fcvt_from_uint $F32X4 x @ (value_type $I32X4)))
  (output_reg (vec_cvt (VecCvtOp.I32ToF32U) (put_in_reg x))))

(rule 2 (lower (fcvt_from_sint $F64X2 x @ (value_type $I64X2)))
  (output_reg (vec_cvt (VecCvtOp.I64ToF64S) (put_in_reg x))))

(rule 2 (lower (fcvt_from_uint $F64X2 x @ (value_type $I64X2)))
  (output_reg (vec_cvt (VecCvtOp.I64ToF64U) (put_in_reg x))))

;;;; Precision changes between float vector widths ;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Neither instruction converts in place, so each needs the lanes moved
;; around it. Both derivations below use the standing identity that
;; little-endian lane i is big-endian element (count - 1 - i).
;;
;; `xvcvdpsp` writes the conversion of big-endian doubleword 0 to
;; big-endian word 0 and of doubleword 1 to word 2 -- that is, in
;; little-endian terms, the results of lanes 0 and 1 land in word lanes
;; 1 and 3, each sitting in the *high* word of its doubleword. Rotating
;; each doubleword by 32 brings both down to their low words, and then
;; packing the low words of the rotated value against a zero vector
;; puts them in result lanes 0 and 1 with the upper two zeroed, which is
;; what `fvdemote` specifies.
(rule (lower (fvdemote _ x @ (value_type $F64X2)))
  (let ((converted Reg (vec_cvt (VecCvtOp.F64ToF32) (put_in_reg x)))
        (amt Reg (vec_splat_lane (mov_to_vec (imm $I64 32)) $I64X2))
        (lowered Reg (vec_alu_rrr (VecAluOp.Rotl) converted amt $I64X2)))
    (output_reg (vec_alu_rrr (VecAluOp.PackMod) (vec_zero) lowered $I64X2))))

;; `xvcvspdp` reads from big-endian words 0 and 2, which are
;; little-endian word lanes 3 and 1 -- the high word of each doubleword.
;; So the two lanes to be promoted have to be moved there first, and
;; merging the source against zero does exactly that: the merge places
;; its first operand's lanes in the odd little-endian positions, leaving
;; lanes 0 and 1 of the source at word lanes 1 and 3.
(rule (lower (fvpromote_low _ x @ (value_type $F32X4)))
  (let ((spread Reg (vec_alu_rrr (VecAluOp.MergeLow) (put_in_reg x) (vec_zero) $I32X4)))
    (output_reg (vec_cvt (VecCvtOp.F32ToF64) spread))))

;;;; Byte permutes: `shuffle` and `swizzle` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; `vperm` concatenates its two sources into a 32-byte value and takes
;; one byte of it per control byte, using only the low five bits. The
;; catch is that the concatenation is numbered from the big end, while
;; CLIF numbers both its lanes and its shuffle indices from the little
;; end -- and over 32 bytes those two orders are exact reflections,
;; index k against 31 - k. Reflecting the index also swaps which half
;; of the concatenation it lands in, so the sources have to be passed
;; in the opposite order to compensate.
;;
;; POWER9 adds `vpermr`, the same permute with the little-endian index
;; convention, which would remove both adjustments. It buys nothing
;; here -- the reflection is constant-folded for `shuffle` and shares
;; an instruction with the bounds check for `swizzle` -- so the POWER8
;; sequences below are used unconditionally.

;; The mask is an immediate, so its reflection costs nothing at all and
;; a shuffle is a single permute against a materialized control vector.
(rule (lower (shuffle _ a b (u128_from_immediate mask)))
  (output_reg (vec_alu_rrrr (VecAluOp4.Perm)
                            (put_in_reg b)
                            (put_in_reg a)
                            (vec_const (shuffle_ctrl mask)))))

;; `swizzle` indexes one vector with a *runtime* index vector and must
;; produce zero wherever an index is outside 0..15, reading the indices
;; as unsigned. Two separate hazards come from `vperm` here: indices
;; 16..31 would select the second source, and indices of 32 or more
;; would have their high bits dropped and alias back into range. Both
;; are covered by masking the result, which lets the same comparison
;; against 15 serve as the bounds check, and lets the permute take the
;; single source twice.
;;
;; The control bytes are 15 - idx rather than 31 - idx because the
;; wanted byte now lies in the *first* source: reflecting an index
;; within one 16-byte half is a complement against 15.
(rule (lower (swizzle _ src idx))
  (let ((s Reg (put_in_reg src))
        (i Reg (put_in_reg idx))
        (fifteen Reg (vec_splt_imm 15 $I8X16))
        (ctrl Reg (vec_alu_rrr (VecAluOp.Sub) fifteen i $I8X16))
        (oob Reg (vec_alu_rrr (VecAluOp.CmpGtU) i fifteen $I8X16))
        (picked Reg (vec_alu_rrrr (VecAluOp4.Perm) s s ctrl)))
    (output_reg (vec_alu_rrr (VecAluOp.AndC) picked oob $I8X16))))

;;;; Vector `fmin` / `fmax` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; `xvmin`/`xvmax` are right about everything CLIF cares about except
;; quiet NaNs: probed on a POWER9, they treat -0 as below +0 and do so
;; independently of operand order (stronger than IEEE minNum requires),
;; and they handle infinities correctly -- but given a quiet NaN they
;; return the *numeric* operand, where CLIF requires a NaN. The scalar
;; forms behave the same way, hence the same shape of fixup here.
;;
;; The NaN is taken from the *sum* of the operands rather than
;; synthesized, because the sum propagates an input NaN's payload: a
;; canonical NaN in gives a canonical NaN out, which is what wasm's
;; min/max tests require of these lanes. Materializing an arbitrary
;; quiet NaN would be one instruction cheaper and would fail them.
;;
;; The select cannot be driven by asking whether the sum is a NaN,
;; because `inf + -inf` is one while the minimum of those operands is
;; perfectly ordered. So it is driven by the operands: comparing each
;; with itself is false exactly where that operand is unordered, and
;; the two results are combined so that either NaN poisons the lane.
(decl vec_min_max (VecFpuOp2 Value Value Type) Reg)
(rule (vec_min_max op x y ty)
  (let ((a Reg (put_in_reg x))
        (b Reg (put_in_reg y))
        (picked Reg (vec_fpu_rrr op a b ty))
        (propagated Reg (vec_fpu_rrr (VecFpuOp2.Add) a b ty))
        (a_ordered Reg (vec_fpu_rrr (VecFpuOp2.CmpEq) a a ty))
        (b_ordered Reg (vec_fpu_rrr (VecFpuOp2.CmpEq) b b ty))
        (ordered Reg (vec_alu_rrr (VecAluOp.And) a_ordered b_ordered ty)))
    (vec_sel picked propagated ordered)))

(rule 1 (lower (fmin (ty_vec_any ty) x y))
  (output_reg (vec_min_max (VecFpuOp2.Min) x y ty)))

(rule 1 (lower (fmax (ty_vec_any ty) x y))
  (output_reg (vec_min_max (VecFpuOp2.Max) x y ty)))

;;;; Vector `fcopysign` and `fma` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; `xvcpsgn` takes the sign from its first operand and the magnitude
;; from its second, which is the order CLIF's `fcopysign x y` wants
;; reversed: the sign comes from `y`.
(rule 2 (lower (fcopysign (ty_vec128 ty) x y))
  (output_reg (vec_fpu_rrr (VecFpuOp2.CopySign) (put_in_reg y) (put_in_reg x) ty)))

;; VSX has only accumulating multiply-adds, so the addend enters as the
;; destination operand; `VecFpuFma` ties the two together.
(rule 2 (lower (fma (ty_vec128 ty) x y z))
  (output_reg (vec_fpu_fma (put_in_reg x) (put_in_reg y) (put_in_reg z) ty)))

;;;; 64-bit vector types ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; `i8x8`, `i16x4`, `i32x2` and `f32x2` live in big-endian doubleword 0
;; of a vector register -- the bit positions that the *high* lanes of
;; the corresponding 128-bit type occupy -- with the other doubleword
;; left undefined. Three consequences, and together they are why that
;; half was chosen:
;;
;;   * `mfvsrd` and `mtvsrd` move exactly that doubleword to and from a
;;     GPR, and within it lane 0 lands in the least-significant bits.
;;     So every bitcast between a 64-bit vector and a 64-bit scalar is
;;     one move, and so is each half of a load or store.
;;   * A little-endian doubleword load puts memory byte j at big-endian
;;     byte 7 - j, which is exactly where lane j lives. Memory order and
;;     lane order therefore agree with no permute at all.
;;   * Lane-wise instructions do not care *where* in the register the
;;     lanes sit, only how wide they are, and the type carried on the
;;     MInst already says that. So every lane-wise rule below is the
;;     128-bit rule with a wider type guard.
;;
;; Only three kinds of operation have to know: anything that reduces
;; across lanes (it must not see the undefined half), anything that
;; names a lane, and the widenings.

;; The meaningful doubleword is what an `i64x2` would call lane 1, and
;; that is already big-endian doubleword 0, so neither direction needs a
;; permute.
(decl vec64_to_gpr (Reg) Reg)
(rule (vec64_to_gpr x) (vec_extract_lane_int x $I64X2 1))

(decl vec64_from_gpr (Reg) Reg)
(rule (vec64_from_gpr x) (mov_to_vec x))

;;;; Loads, stores and constants

(rule 3 (lower (load (ty_vec64 _) (little_or_native_endian flags) addr offset))
  (output_reg (vec64_from_gpr (gen_load $I64 (amode addr offset) flags))))

(rule 3 (lower (store (little_or_native_endian flags)
                      val @ (value_type (ty_vec64 _)) addr offset))
  (side_effect
    (gen_store $I64 (amode addr offset) flags (vec64_to_gpr (put_in_reg val)))))

;; The constant's low 64 bits hold every lane, lane 0 least significant,
;; which is the same layout `mtvsrd` produces.
(rule 1 (lower (vconst (ty_vec64 _) (u64_from_constant n)))
  (output_reg (vec64_from_gpr (imm $I64 n))))

;;;; Splats
;;
;; Splatting fills all sixteen bytes, so the meaningful half is correct
;; whichever half that is; these are the 128-bit rules verbatim.

(rule 1 (lower (splat (ty_vec64 ty) x @ (value_type (ty_int _))))
  (output_reg (vec_splat_lane (mov_to_vec (put_in_reg x)) ty)))

(rule 2 (lower (splat (ty_vec64 _) x @ (value_type $F32)))
  (output_reg (vec_splat_fpr (fpu_rr (FpuOp1.CvtToSingleBits) (put_in_reg x) $F32)
                             true)))

;;;; Bitcasts

(rule 7 (lower (bitcast (ty_vec64 _) _ x @ (value_type (ty_vec64 _))))
  (output_reg (put_in_reg x)))

(rule 6 (lower (bitcast $I64 _ x @ (value_type (ty_vec64 _))))
  (output_reg (vec64_to_gpr (put_in_reg x))))

(rule 4 (lower (bitcast (ty_vec64 _) _ x @ (value_type $I64)))
  (output_reg (vec64_from_gpr (put_in_reg x))))

(rule 5 (lower (bitcast $F64 _ x @ (value_type (ty_vec64 _))))
  (output_reg (mov_to_fpr (vec64_to_gpr (put_in_reg x)) $F64)))

(rule 3 (lower (bitcast (ty_vec64 _) _ x @ (value_type $F64)))
  (output_reg (vec64_from_gpr (mov_from_fpr (put_in_reg x)))))

;;;; Lane-wise arithmetic, logic and comparison

(rule 5 (lower (iadd (ty_vec64 ty) x y))
  (output_reg (vec_alu_rrr (VecAluOp.Add) (put_in_reg x) (put_in_reg y) ty)))
(rule 5 (lower (isub (ty_vec64 ty) x y))
  (output_reg (vec_alu_rrr (VecAluOp.Sub) (put_in_reg x) (put_in_reg y) ty)))
(rule 5 (lower (avg_round (ty_vec64 ty) x y))
  (output_reg (vec_alu_rrr (VecAluOp.AvgRoundU) (put_in_reg x) (put_in_reg y) ty)))

(rule 3 (lower (band (ty_vec64 ty) x y))
  (output_reg (vec_alu_rrr (VecAluOp.And) (put_in_reg x) (put_in_reg y) ty)))
(rule 3 (lower (bor (ty_vec64 ty) x y))
  (output_reg (vec_alu_rrr (VecAluOp.Or) (put_in_reg x) (put_in_reg y) ty)))
(rule 3 (lower (bxor (ty_vec64 ty) x y))
  (output_reg (vec_alu_rrr (VecAluOp.Xor) (put_in_reg x) (put_in_reg y) ty)))
(rule 3 (lower (bnot (ty_vec64 ty) x))
  (let ((xr Reg (put_in_reg x)))
    (output_reg (vec_alu_rrr (VecAluOp.Nor) xr xr ty))))
(rule 3 (lower (fcopysign (ty_vec64 ty) x y))
  (output_reg (vec_fpu_rrr (VecFpuOp2.CopySign) (put_in_reg y) (put_in_reg x) ty)))
(rule 3 (lower (fma (ty_vec64 ty) x y z))
  (output_reg (vec_fpu_fma (put_in_reg x) (put_in_reg y) (put_in_reg z) ty)))

;;;; Reductions
;;
;; Both read the meaningful doubleword into a GPR, which is what keeps
;; the undefined half out of the answer -- cheaper than masking it and
;; impossible to get subtly wrong.

;; Whatever the lane width, some lane is non-zero exactly when the
;; doubleword is non-zero.
(rule 2 (lower (vany_true _ x @ (value_type (ty_vec64 _))))
  (output_reg
    (cmp_set (int_compare (IntCC.NotEqual)
                          (vec64_to_gpr (put_in_reg x))
                          (imm $I64 0)
                          $I64))))

;; `vall_true` does depend on the lane width, so compare lanes against
;; zero first: the mask holds all-ones exactly in the lanes that were
;; zero, so every lane is non-zero precisely when the meaningful
;; doubleword of that mask is zero.
(rule 2 (lower (vall_true _ x @ (value_type (ty_vec64 ty))))
  (output_reg
    (cmp_set (int_compare (IntCC.Equal)
                          (vec64_to_gpr
                            (vec_alu_rrr (VecAluOp.CmpEq)
                                         (put_in_reg x) (vec_zero) ty))
                          (imm $I64 0)
                          $I64))))

;;;; Pairwise addition
;;
;; Same trick as at 128 bits -- a pair of adjacent lanes is one lane of
;; the next width up, so shifting that wider lane down by one element
;; width and adding puts the pair's sum in its low half -- with one
;; difference. There, the two operands' sums could be packed straight
;; against each other. Here each operand's sums sit in its own
;; big-endian doubleword 0, and the pack reads whole registers, so the
;; two doublewords are first gathered into one register: `xxpermdi`
;; with the second operand's half above the first's, which is the order
;; that leaves the result's lanes in CLIF's concatenation order.
(decl iadd_pairwise64_via (Reg Reg Reg Type) Reg)
(rule (iadd_pairwise64_via xr yr amt wide_ty)
  (let ((xs Reg (vec_alu_rrr (VecAluOp.Add) xr
                             (vec_alu_rrr (VecAluOp.ShrU) xr amt wide_ty)
                             wide_ty))
        (ys Reg (vec_alu_rrr (VecAluOp.Add) yr
                             (vec_alu_rrr (VecAluOp.ShrU) yr amt wide_ty)
                             wide_ty))
        (gathered Reg (vec_permdi ys xs 0)))
    (vec_alu_rrr (VecAluOp.PackMod) gathered gathered wide_ty)))

(rule 1 (lower (iadd_pairwise $I8X8 x y))
  (output_reg (iadd_pairwise64_via (put_in_reg x) (put_in_reg y)
                                   (vec_splt_imm 8 $I16X8) $I16X8)))

(rule 1 (lower (iadd_pairwise $I16X4 x y))
  (output_reg (iadd_pairwise64_via (put_in_reg x) (put_in_reg y)
                                   (vec_splt_imm 16 $I32X4) $I32X4)))

;; A doubleword shift of thirty-two has no splat-immediate encoding, as
;; at 128 bits, so it comes through a GPR.
(rule 1 (lower (iadd_pairwise $I32X2 x y))
  (output_reg (iadd_pairwise64_via (put_in_reg x) (put_in_reg y)
                                   (vec_splat_lane (mov_to_vec (imm $I64 32)) $I64X2)
                                   $I64X2)))

;;;; Widening
;;
;; The unpack and merge instructions read big-endian elements 0-7 --
;; which is precisely the doubleword a 64-bit vector occupies -- so the
;; *High* forms are the ones that see the data, for both signed and
;; unsigned widening and for both halves. They widen all eight source
;; lanes across the whole register, leaving CLIF's low four lanes in
;; big-endian doubleword 1 and its high four in doubleword 0. So
;; `_high` is already in place and `_low` needs the halves swapped:
;; the same inversion as at 128 bits, arrived at from the other side.

(rule 1 (lower (swiden_high _ x @ (value_type (ty_vec64 in_ty))))
  (output_reg (vec_unary (VecUnaryOp.WidenSHigh) (put_in_reg x) in_ty)))

(rule 1 (lower (swiden_low _ x @ (value_type (ty_vec64 in_ty))))
  (let ((widened Reg (vec_unary (VecUnaryOp.WidenSHigh) (put_in_reg x) in_ty)))
    (output_reg (vec_permdi widened widened 2))))

(rule 1 (lower (uwiden_high _ x @ (value_type (ty_vec64 in_ty))))
  (output_reg (vec_alu_rrr (VecAluOp.MergeHigh) (vec_zero) (put_in_reg x) in_ty)))

(rule 1 (lower (uwiden_low _ x @ (value_type (ty_vec64 in_ty))))
  (let ((widened Reg (vec_alu_rrr (VecAluOp.MergeHigh)
                                  (vec_zero) (put_in_reg x) in_ty)))
    (output_reg (vec_permdi widened widened 2))))

;; No doubleword average instruction exists, so use the identity
;; `avgr_u(a, b) = (a | b) - ((a ^ b) >> 1)`. Its virtue here is that no
;; intermediate is ever wider than a lane: the carry bit that would
;; overflow a doubleword add never has to be represented at all. The
;; shift amount rides in a byte splat, since there is no
;; splat-immediate at doubleword width -- the doubleword shift reads
;; only the low six bits of each element, and 0x0101..01 has a one
;; there.
(rule 1 (lower (avg_round $I64X2 x y))
  (let ((xr Reg (put_in_reg x))
        (yr Reg (put_in_reg y))
        (one Reg (vec_splt_imm 1 $I8X16)))
    (output_reg
      (vec_alu_rrr (VecAluOp.Sub)
                   (vec_alu_rrr (VecAluOp.Or) xr yr $I64X2)
                   (vec_alu_rrr (VecAluOp.ShrU)
                                (vec_alu_rrr (VecAluOp.Xor) xr yr $I64X2)
                                one $I64X2)
                   $I64X2))))

;;;; Bitcasts between `i128` and a 128-bit vector ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Same sixteen bytes, different register classes: the vector in one
;; register, the integer in a pair of GPRs holding the low doubleword
;; first. Little-endian lanes 0-7 are big-endian doubleword 1 and lanes
;; 8-15 are doubleword 0, so the pair's low half is `i64x2` lane 0 and
;; its high half is lane 1 -- which is also why the vector direction
;; can reuse the constant-materialization permute, whose whole job is
;; putting a high half in big-endian doubleword 0.

(rule 9 (lower (bitcast $I128 _ x @ (value_type (ty_vec128 _))))
  (let ((xr Reg (put_in_reg x)))
    (output (value_regs (vec_extract_lane_int xr $I64X2 0)
                        (vec_extract_lane_int xr $I64X2 1)))))

(rule 8 (lower (bitcast (ty_vec128 _) _ x @ (value_type $I128)))
  (let ((xs ValueRegs (put_in_regs x)))
    (output_reg (vec_permdi (mov_to_vec (hi xs)) (mov_to_vec (lo xs)) 0))))

;;;; Vector `ineg` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; No lane-wise negate exists; subtracting from zero is the whole of it,
;; at either register width.

(rule 3 (lower (ineg (ty_vec_any ty) x))
  (output_reg (vec_alu_rrr (VecAluOp.Sub) (vec_zero) (put_in_reg x) ty)))

;;;; Vector `select` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; The condition is a scalar but the select is over vectors, so it has
;; to be widened into an all-ones or all-zeros mask for `xxsel`.
;; Negating the 0/1 that the comparison produces gives 0 or -1, and
;; splatting that doubleword fills the register either way -- so the
;; mask is right whichever half a 64-bit vector occupies.

(decl vec_mask_from_reg (Reg Type) Reg)
(rule (vec_mask_from_reg c cty)
  (vec_splat_lane
    (mov_to_vec
      (gen_unary (UnaryOp.Neg)
                 (cmp_set (int_compare (IntCC.NotEqual) c (imm $I64 0) cty))))
    $I64X2))

(rule 9 (lower (select (ty_vec_any _) c @ (value_type (fits_in_64 cty)) x y))
  (output_reg (vec_sel (put_in_reg x) (put_in_reg y)
                       (vec_mask_from_reg (put_in_cmp_reg c (IntCC.NotEqual) cty)
                                          cty))))

;; A 128-bit condition is true when either half is non-zero, so the two
;; are folded together before the mask is built.
(rule 10 (lower (select (ty_vec_any _) c @ (value_type $I128) x y))
  (let ((cs ValueRegs (put_in_regs c)))
    (output_reg (vec_sel (put_in_reg x) (put_in_reg y)
                         (vec_mask_from_reg (ppc_or (lo cs) (hi cs)) $I64)))))

;;;; `scalar_to_vector` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Lane 0 takes the scalar and every other lane is zeroed. `mtvsrd`
;; lands the value in big-endian doubleword 0, which is the *high*
;; lanes, so the permute both moves it down to lane 0's doubleword and
;; brings a zero in above it. Narrow scalars are zero-extended first,
;; since the bits above them become lanes of their own.

(decl scalar_to_vec (Reg) Reg)
(rule (scalar_to_vec x) (vec_permdi (vec_zero) (mov_to_vec x) 0))

(rule 1 (lower (scalar_to_vector _ x @ (value_type (ty_int ity))))
  (output_reg (scalar_to_vec (gen_extend (put_in_reg x) false (ty_bits ity) 64))))

(rule 3 (lower (scalar_to_vector _ x @ (value_type $F64)))
  (output_reg (scalar_to_vec (mov_from_fpr (put_in_reg x)))))

(rule 2 (lower (scalar_to_vector _ x @ (value_type $F32)))
  (output_reg (scalar_to_vec (f32_to_bits (put_in_reg x)))))

;;;; Byte-lane multiply ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; There is no byte multiply. The even/odd forms give the full halfword
;; product of alternating byte lanes, and the low byte of each of those
;; is the wanted lane, so a truncating pack of the two collects them.
;; The mnemonics' "even" and "odd" are big-endian element numbers, so
;; under this backend's lane order `vmuleub` supplies the odd lanes;
;; and the pack puts its first operand in the little-endian high lanes,
;; which is where those odd-lane products belong.

(rule 5 (lower (imul $I8X16 x y))
  (let ((xr Reg (put_in_reg x))
        (yr Reg (put_in_reg y))
        ;; Halfword products of alternating byte lanes. Working through
        ;; the element numbering: `vmuleub` reads big-endian bytes 2i,
        ;; which are the *odd* little-endian lanes, and leaves the
        ;; product for lane 2j+1 in halfword lane j; `vmuloub`
        ;; correspondingly leaves lane 2j's product in halfword lane j.
        (odd Reg (vec_alu_rrr (VecAluOp.MulEvenU) xr yr $I8X16))
        (even Reg (vec_alu_rrr (VecAluOp.MulOddU) xr yr $I8X16))
        (eight Reg (vec_splt_imm 8 $I16X8))
        ;; Each result halfword wants lane 2j's product byte below
        ;; lane 2j+1's, so the two are interleaved rather than packed:
        ;; a truncating pack would concatenate the even lanes' bytes
        ;; and then the odd lanes', which is a de-interleaved order.
        (odd_hi Reg (vec_alu_rrr (VecAluOp.Shl) odd eight $I16X8))
        (byte_mask Reg (vec_alu_rrr (VecAluOp.ShrU)
                                    (vec_splt_imm -1 $I8X16) eight $I16X8))
        (even_lo Reg (vec_alu_rrr (VecAluOp.And) even byte_mask $I16X8)))
    (output_reg (vec_alu_rrr (VecAluOp.Or) odd_hi even_lo $I8X16))))

;;;; Overflow-detecting arithmetic ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; These return the wrapped result together with a boolean. PPC keeps
;; carry and overflow bits in XER, but reading them back costs about
;; what recomputing the condition costs, and the recomputation reuses
;; the existing compare-into-a-GPR machinery -- so only the 128-bit
;; carry chain, which has no cheap alternative, actually reads XER.
;;
;; For a type narrower than a doubleword the work is done at full width
;; on extended operands. The exact result of any such add, subtract or
;; multiply fits in a doubleword, so "overflowed" is just "the result
;; does not fit back into the type", which is one compare.

;; Extend an operand to fill the whole register. This has to be an
;; unconditional extension, including from `i32`: the checks below
;; compare entire doublewords, so the bits above the type must be
;; correct rather than merely ignored. (Rules that feed only word-wide
;; instructions can and do skip it, since those read the low word in
;; full -- but reusing such an operand here reads that register's
;; undefined upper half and reports overflow at random.)
(decl ext_to_64 (Value Type bool) Reg)
(rule (ext_to_64 val ty signed)
  (gen_extend (put_in_reg val) signed (ty_bits ty) 64))

(decl overflowed_narrow (Reg Type bool) Reg)
;; Signed: the value is out of range exactly when re-extending its low
;; bits changes it.
(rule (overflowed_narrow v ty true)
  (cmp_set (int_compare (IntCC.NotEqual) v
                        (gen_extend v true (ty_bits ty) 64) $I64)))
;; Unsigned: out of range exactly when a bit at or above the type's
;; width survives.
(rule (overflowed_narrow v ty false)
  (cmp_set (int_compare (IntCC.NotEqual)
                        (gen_shift (ShiftOp.Srd) v (imm $I64 (ty_bits_u64 ty)))
                        (imm $I64 0) $I64)))

(rule 0 (lower (uadd_overflow (fits_in_32 ty) x y))
  (let ((sum Reg (ppc_add (ext_to_64 x ty false) (ext_to_64 y ty false))))
    (output_pair (value_reg sum) (value_reg (overflowed_narrow sum ty false)))))

(rule 0 (lower (sadd_overflow (fits_in_32 ty) x y))
  (let ((sum Reg (ppc_add (ext_to_64 x ty true) (ext_to_64 y ty true))))
    (output_pair (value_reg sum) (value_reg (overflowed_narrow sum ty true)))))

(rule 0 (lower (ssub_overflow (fits_in_32 ty) x y))
  (let ((diff Reg (ppc_sub (ext_to_64 x ty true) (ext_to_64 y ty true))))
    (output_pair (value_reg diff) (value_reg (overflowed_narrow diff ty true)))))

(rule 0 (lower (umul_overflow (fits_in_32 ty) x y))
  (let ((prod Reg (ppc_mulld (ext_to_64 x ty false) (ext_to_64 y ty false))))
    (output_pair (value_reg prod) (value_reg (overflowed_narrow prod ty false)))))

(rule 0 (lower (smul_overflow (fits_in_32 ty) x y))
  (let ((prod Reg (ppc_mulld (ext_to_64 x ty true) (ext_to_64 y ty true))))
    (output_pair (value_reg prod) (value_reg (overflowed_narrow prod ty true)))))

;; An unsigned subtract borrows exactly when the minuend is smaller, so
;; this one needs no range check at any width.
(rule 0 (lower (usub_overflow (fits_in_32 ty) x y))
  (let ((xe Reg (ext_to_64 x ty false))
        (ye Reg (ext_to_64 y ty false)))
    (output_pair (value_reg (ppc_sub xe ye))
                 (value_reg (cmp_set (int_compare (IntCC.UnsignedLessThan)
                                                  xe ye $I64))))))

;;;; The doubleword cases, where the exact result no longer fits.

;; Wrapping past the top of the range makes an unsigned sum smaller
;; than either input.
(rule 1 (lower (uadd_overflow $I64 x y))
  (let ((xr Reg (put_in_reg x))
        (sum Reg (ppc_add xr (put_in_reg y))))
    (output_pair (value_reg sum)
                 (value_reg (cmp_set (int_compare (IntCC.UnsignedLessThan)
                                                  sum xr $I64))))))

(rule 1 (lower (usub_overflow $I64 x y))
  (let ((xr Reg (put_in_reg x))
        (yr Reg (put_in_reg y)))
    (output_pair (value_reg (ppc_sub xr yr))
                 (value_reg (cmp_set (int_compare (IntCC.UnsignedLessThan)
                                                  xr yr $I64))))))

;; A signed add overflows when both inputs differ in sign from the
;; result, which is what the two exclusive-ors and the sign test say.
(decl signed_add_ovf (Reg Reg Reg) Reg)
(rule (signed_add_ovf a b sum)
  (cmp_set (int_compare (IntCC.SignedLessThan)
                        (ppc_and (ppc_xor a sum) (ppc_xor b sum))
                        (imm $I64 0) $I64)))

;; For a subtract it is the inputs differing in sign from each other
;; and the result differing from the minuend.
(decl signed_sub_ovf (Reg Reg Reg) Reg)
(rule (signed_sub_ovf a b diff)
  (cmp_set (int_compare (IntCC.SignedLessThan)
                        (ppc_and (ppc_xor a b) (ppc_xor a diff))
                        (imm $I64 0) $I64)))

(rule 1 (lower (sadd_overflow $I64 x y))
  (let ((xr Reg (put_in_reg x))
        (yr Reg (put_in_reg y))
        (sum Reg (ppc_add xr yr)))
    (output_pair (value_reg sum) (value_reg (signed_add_ovf xr yr sum)))))

(rule 1 (lower (ssub_overflow $I64 x y))
  (let ((xr Reg (put_in_reg x))
        (yr Reg (put_in_reg y))
        (diff Reg (ppc_sub xr yr)))
    (output_pair (value_reg diff) (value_reg (signed_sub_ovf xr yr diff)))))

;; The high half of the product is the overflow: zero for an unsigned
;; product that fits, and the low half's sign-fill for a signed one.
(rule 1 (lower (umul_overflow $I64 x y))
  (let ((xr Reg (put_in_reg x))
        (yr Reg (put_in_reg y)))
    (output_pair (value_reg (ppc_mulld xr yr))
                 (value_reg (cmp_set (int_compare (IntCC.NotEqual)
                                                  (ppc_mulhdu xr yr)
                                                  (imm $I64 0) $I64))))))

(rule 1 (lower (smul_overflow $I64 x y))
  (let ((xr Reg (put_in_reg x))
        (yr Reg (put_in_reg y))
        (prod Reg (ppc_mulld xr yr)))
    (output_pair (value_reg prod)
                 (value_reg (cmp_set (int_compare (IntCC.NotEqual)
                                                  (ppc_mulhd xr yr)
                                                  (gen_shift (ShiftOp.Srad) prod (imm $I64 63))
                                                  $I64))))))

;;;; The 128-bit cases.
;;
;; The signed ones reuse the sign tests above on the high halves alone,
;; which is where a 128-bit result's sign lives. The unsigned ones need
;; the carry out of the top of the chain, and that is the one place
;; XER.CA is read: `addze` of zero yields it directly. The zero is
;; materialized before the chain starts so that nothing lands between
;; the `adde` and the `addze`.

(rule 2 (lower (uadd_overflow $I128 x y))
  (let ((xs ValueRegs (put_in_regs x))
        (ys ValueRegs (put_in_regs y))
        (zero Reg (imm $I64 0))
        (lo Reg (ppc_addc (lo xs) (lo ys)))
        (hi Reg (ppc_adde (hi xs) (hi ys))))
    (output_pair (value_regs lo hi) (value_reg (ppc_addze zero)))))

;; A subtract's carry out is the *complement* of a borrow -- the
;; hardware computes `x + ~y + 1` -- so the flag is inverted.
(rule 2 (lower (usub_overflow $I128 x y))
  (let ((xs ValueRegs (put_in_regs x))
        (ys ValueRegs (put_in_regs y))
        (zero Reg (imm $I64 0))
        (one Reg (imm $I64 1))
        (lo Reg (ppc_subfc (lo xs) (lo ys)))
        (hi Reg (ppc_subfe (hi xs) (hi ys))))
    (output_pair (value_regs lo hi)
                 (value_reg (ppc_xor (ppc_addze zero) one)))))

(rule 2 (lower (sadd_overflow $I128 x y))
  (let ((xs ValueRegs (put_in_regs x))
        (ys ValueRegs (put_in_regs y))
        (lo Reg (ppc_addc (lo xs) (lo ys)))
        (hi Reg (ppc_adde (hi xs) (hi ys))))
    (output_pair (value_regs lo hi)
                 (value_reg (signed_add_ovf (hi xs) (hi ys) hi)))))

(rule 2 (lower (ssub_overflow $I128 x y))
  (let ((xs ValueRegs (put_in_regs x))
        (ys ValueRegs (put_in_regs y))
        (lo Reg (ppc_subfc (lo xs) (lo ys)))
        (hi Reg (ppc_subfe (hi xs) (hi ys))))
    (output_pair (value_regs lo hi)
                 (value_reg (signed_sub_ovf (hi xs) (hi ys) hi)))))

;;;; Sub-word float-to-integer conversions ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; The trapping forms need nothing new: the range checks are built from
;; the destination type's own bounds, so once they pass, the word-wide
;; conversion instruction's result is in range and its low bits are the
;; answer.

(rule 1 (lower (fcvt_to_sint (fits_in_16 out_ty) x @ (value_type (ty_scalar_float in_ty))))
  (output_reg (fpu_to_int (put_in_reg x) true false in_ty out_ty)))

(rule 1 (lower (fcvt_to_uint (fits_in_16 out_ty) x @ (value_type (ty_scalar_float in_ty))))
  (output_reg (fpu_to_int (put_in_reg x) false false in_ty out_ty)))

;; The saturating forms do need work, because the instruction saturates
;; to a *word*: an input of 1000 converted for an `i8` comes back as
;; 1000, where CLIF wants 127. So the word conversion is clamped
;; afterwards. Its upper bits are undefined, so it is extended first --
;; the comparisons that follow are 64-bit.

(rule 1 (lower (fcvt_to_sint_sat (fits_in_16 out_ty)
                                 x @ (value_type (ty_scalar_float in_ty))))
  (let ((wide Reg (gen_extend (fpu_to_int (put_in_reg x) true true in_ty $I32)
                              true 32 64))
        (lo Reg (imm $I64 (ty_smin_u64 out_ty)))
        (hi Reg (imm $I64 (ty_smax_u64 out_ty))))
    (output_reg
      (gen_select (int_compare (IntCC.SignedLessThan) wide lo $I64)
                  lo
                  (gen_select (int_compare (IntCC.SignedGreaterThan) wide hi $I64)
                              hi wide)))))

;; The unsigned conversion cannot go below zero, so only the upper
;; bound needs clamping.
(rule 1 (lower (fcvt_to_uint_sat (fits_in_16 out_ty)
                                 x @ (value_type (ty_scalar_float in_ty))))
  (let ((wide Reg (gen_extend (fpu_to_int (put_in_reg x) false true in_ty $I32)
                              false 32 64))
        (hi Reg (imm $I64 (ty_umax_u64 out_ty))))
    (output_reg
      (gen_select (int_compare (IntCC.UnsignedGreaterThan) wide hi $I64) hi wide))))

;;;; Multiply on 64-bit vectors ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; The halfword and word multiplies are per-lane and so position-blind;
;; bytes reuse the interleave the 128-bit rule needs.

(rule 6 (lower (imul $I16X4 x y))
  (output_reg (vec_alu_rrrr (VecAluOp4.MulAddUH)
                            (put_in_reg x) (put_in_reg y) (vec_zero))))

(rule 6 (lower (imul $I32X2 x y))
  (output_reg (vec_alu_rrr (VecAluOp.MulWord) (put_in_reg x) (put_in_reg y) $I32X4)))

;;;; `vhigh_bits` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Collect one bit per lane -- its sign -- into a scalar. `vbpermq`
;; gathers sixteen arbitrary bits named by an index vector, which is
;; exactly this once the indices are worked out; see `vhigh_bits_ctrl`.
;; The gathered bits land in the low halfword of big-endian doubleword
;; 0, which is what a move to a general register reads.

(rule (lower (vhigh_bits _ x @ (value_type (ty_vec128 ty))))
  (output_reg
    (vec64_to_gpr (vec_alu_rrr (VecAluOp.BitPermQ)
                               (put_in_reg x)
                               (vec_const (vhigh_bits_ctrl ty))
                               ty))))

;;;; Vector rotates ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; `vrl{b,h,w,d}` rotate each lane by its own amount and mask that
;; amount to the lane width, which is exactly CLIF's rule -- so the
;; splatted amount needs no masking, and negating it gives a rotate
;; right, the negation reducing modulo the width for free.

(rule 3 (lower (rotl (ty_vec_any ty) x y))
  (output_reg (vec_alu_rrr (VecAluOp.Rotl) (put_in_reg x) (vec_shift_amount y ty) ty)))

(rule 3 (lower (rotr (ty_vec_any ty) x y))
  (output_reg
    (vec_alu_rrr (VecAluOp.Rotl) (put_in_reg x)
                 (vec_alu_rrr (VecAluOp.Sub) (vec_zero) (vec_shift_amount y ty) ty)
                 ty)))

;;;; Vector `select_spectre_guard` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Same as the vector `select` above. The guard's contract is that the
;; result is not speculated past the condition, which a data-dependent
;; `xxsel` satisfies exactly as it does for the scalar cases.

(rule 6 (lower (select_spectre_guard (ty_vec_any _)
                                     c @ (value_type (fits_in_64 cty)) x y))
  (output_reg (vec_sel (put_in_reg x) (put_in_reg y)
                       (vec_mask_from_reg (put_in_cmp_reg c (IntCC.NotEqual) cty)
                                          cty))))

(rule 7 (lower (select_spectre_guard (ty_vec_any _) c @ (value_type $I128) x y))
  (let ((cs ValueRegs (put_in_regs c)))
    (output_reg (vec_sel (put_in_reg x) (put_in_reg y)
                         (vec_mask_from_reg (ppc_or (lo cs) (hi cs)) $I64)))))

;;;; Extending 64-bit vector loads ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Load eight bytes and widen each lane to twice its width. The value
;; arrives in big-endian doubleword 0 -- the same placement the 64-bit
;; vector types use -- which is exactly where the *High* unpack and
;; merge forms read from, so these are the 64-bit widening rules with a
;; load in front and no permute anywhere.

(decl vec64_load (Value i32 MemFlagsData) Reg)
(rule (vec64_load addr offset flags)
  (vec64_from_gpr (gen_load $I64 (amode addr offset) flags)))

(rule (lower (uload8x8 _ (little_or_native_endian flags) addr offset))
  (output_reg (vec_alu_rrr (VecAluOp.MergeHigh) (vec_zero)
                           (vec64_load addr offset flags) $I8X16)))
(rule (lower (uload16x4 _ (little_or_native_endian flags) addr offset))
  (output_reg (vec_alu_rrr (VecAluOp.MergeHigh) (vec_zero)
                           (vec64_load addr offset flags) $I16X8)))
(rule (lower (uload32x2 _ (little_or_native_endian flags) addr offset))
  (output_reg (vec_alu_rrr (VecAluOp.MergeHigh) (vec_zero)
                           (vec64_load addr offset flags) $I32X4)))

(rule (lower (sload8x8 _ (little_or_native_endian flags) addr offset))
  (output_reg (vec_unary (VecUnaryOp.WidenSHigh)
                         (vec64_load addr offset flags) $I8X16)))
(rule (lower (sload16x4 _ (little_or_native_endian flags) addr offset))
  (output_reg (vec_unary (VecUnaryOp.WidenSHigh)
                         (vec64_load addr offset flags) $I16X8)))
(rule (lower (sload32x2 _ (little_or_native_endian flags) addr offset))
  (output_reg (vec_unary (VecUnaryOp.WidenSHigh)
                         (vec64_load addr offset flags) $I32X4)))

;; The float `select_spectre_guard`, which mirrors the float `select`:
;; the guard's contract is that the result is not speculated past the
;; condition, and the data-dependent conditional move satisfies it.
(rule 8 (lower (select_spectre_guard (ty_scalar_float ty)
                                     c @ (value_type (fits_in_64 cty)) x y))
  (output_reg
    (gen_fpu_select (int_compare (IntCC.NotEqual)
                                 (put_in_cmp_reg c (IntCC.NotEqual) cty)
                                 (imm $I64 0)
                                 cty)
                    (put_in_reg x)
                    (put_in_reg y)
                    ty)))

(rule 9 (lower (select_spectre_guard (ty_scalar_float ty) c @ (value_type $I128) x y))
  (let ((cs ValueRegs (put_in_regs c)))
    (output_reg
      (gen_fpu_select (int_compare (IntCC.NotEqual)
                                   (ppc_or (lo cs) (hi cs))
                                   (imm $I64 0)
                                   $I64)
                      (put_in_reg x)
                      (put_in_reg y)
                      ty))))

;;;; Completing the 64-bit vector grid ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; The lane-wise operations above accept either register width already,
;; because the instruction does not care where in the register the lanes
;; sit. What is left are the operations that *do* care: those that
;; combine two operands' lanes into one register, or that read only one
;; half of a product. For a 64-bit vector the data lives in big-endian
;; doubleword 0, so each of these has to put its result back there.

;; The word conversions read and write word lanes in place, so the two
;; meaningful lanes stay in big-endian words 0 and 1 throughout.
;; ISLE has no `$F32X2` constant, so the float side is matched
;; structurally; `f32x2` is the only 64-bit float vector this backend
;; accepts, `f16x4` having been rejected in `rc_for_type`.
(rule 3 (lower (fcvt_to_sint_sat $I32X2 x @ (value_type (ty_vec64 _))))
  (output_reg (fcvt_to_sint_sat_masked (VecCvtOp.F32ToI32S) (VecFpuOp2.CmpEq)
                                       x $F32X4)))
(rule 3 (lower (fcvt_to_uint_sat $I32X2 x @ (value_type (ty_vec64 _))))
  (output_reg (vec_cvt (VecCvtOp.F32ToI32U) (put_in_reg x))))
(rule 3 (lower (fcvt_from_sint (ty_vec64 _) x @ (value_type $I32X2)))
  (output_reg (vec_cvt (VecCvtOp.I32ToF32S) (put_in_reg x))))
(rule 3 (lower (fcvt_from_uint (ty_vec64 _) x @ (value_type $I32X2)))
  (output_reg (vec_cvt (VecCvtOp.I32ToF32U) (put_in_reg x))))

;; Per-lane, and the addend is zero, so this is width-blind.
(rule 1 (lower (sqmul_round_sat $I16X4 x y))
  (output_reg (vec_alu_rrrr (VecAluOp4.MulHiRoundAddSHS)
                            (put_in_reg x) (put_in_reg y) (vec_zero))))

;; Byte multiply, exactly as at 128 bits: the even/odd products of the
;; meaningful bytes land in big-endian halfwords 0-3, and combining each
;; pair into one halfword leaves all eight result bytes in doubleword 0.
(rule 6 (lower (imul $I8X8 x y))
  (let ((xr Reg (put_in_reg x))
        (yr Reg (put_in_reg y))
        (odd Reg (vec_alu_rrr (VecAluOp.MulEvenU) xr yr $I8X16))
        (even Reg (vec_alu_rrr (VecAluOp.MulOddU) xr yr $I8X16))
        (eight Reg (vec_splt_imm 8 $I16X8))
        (odd_hi Reg (vec_alu_rrr (VecAluOp.Shl) odd eight $I16X8))
        (byte_mask Reg (vec_alu_rrr (VecAluOp.ShrU)
                                    (vec_splt_imm -1 $I8X16) eight $I16X8))
        (even_lo Reg (vec_alu_rrr (VecAluOp.And) even byte_mask $I16X8)))
    (output_reg (vec_alu_rrr (VecAluOp.Or) odd_hi even_lo $I8X16))))

;; High halves of the products, for a 64-bit source. The even/odd
;; multiplies leave the meaningful products in the *high* big-endian
;; elements of the double-width result -- there are only four of them,
;; not eight -- so the high merge interleaves them back into source
;; order, filling all eight, and one shift and pack then puts the eight
;; high halves in doubleword 0. That is one merge fewer than the
;; 128-bit sequence needs, which has products in both halves.
(decl mulhi_narrow64 (Reg Reg Type i8) Reg)
(rule (mulhi_narrow64 evens odds prod_ty shift)
  (let ((merged Reg (vec_alu_rrr (VecAluOp.MergeHigh) evens odds prod_ty))
        (amt Reg (vec_splt_imm shift prod_ty))
        (sh Reg (vec_alu_rrr (VecAluOp.ShrU) merged amt prod_ty)))
    (vec_alu_rrr (VecAluOp.PackMod) sh sh prod_ty)))

(rule 4 (lower (smulhi $I8X8 x y))
  (output_reg (mulhi_narrow64
                (vec_alu_rrr (VecAluOp.MulEvenS) (put_in_reg x) (put_in_reg y) $I8X16)
                (vec_alu_rrr (VecAluOp.MulOddS) (put_in_reg x) (put_in_reg y) $I8X16)
                $I16X8 8)))
(rule 4 (lower (umulhi $I8X8 x y))
  (output_reg (mulhi_narrow64
                (vec_alu_rrr (VecAluOp.MulEvenU) (put_in_reg x) (put_in_reg y) $I8X16)
                (vec_alu_rrr (VecAluOp.MulOddU) (put_in_reg x) (put_in_reg y) $I8X16)
                $I16X8 8)))
(rule 4 (lower (smulhi $I16X4 x y))
  (output_reg (mulhi_narrow64
                (vec_alu_rrr (VecAluOp.MulEvenS) (put_in_reg x) (put_in_reg y) $I16X8)
                (vec_alu_rrr (VecAluOp.MulOddS) (put_in_reg x) (put_in_reg y) $I16X8)
                $I32X4 -16)))
(rule 4 (lower (umulhi $I16X4 x y))
  (output_reg (mulhi_narrow64
                (vec_alu_rrr (VecAluOp.MulEvenU) (put_in_reg x) (put_in_reg y) $I16X8)
                (vec_alu_rrr (VecAluOp.MulOddU) (put_in_reg x) (put_in_reg y) $I16X8)
                $I32X4 -16)))

;; The word case has a doubleword product, so the merge granularity the
;; narrow path needs does not exist; the two halves are gathered
;; instead, exactly as `iadd_pairwise` does at this width.
(rule 4 (lower (smulhi $I32X2 x y))
  (output_reg (mulhi_i32x4
                (vec_alu_rrr (VecAluOp.MulOddS) (put_in_reg x) (put_in_reg y) $I32X4)
                (vec_alu_rrr (VecAluOp.MulEvenS) (put_in_reg x) (put_in_reg y) $I32X4))))
(rule 4 (lower (umulhi $I32X2 x y))
  (output_reg (mulhi_i32x4
                (vec_alu_rrr (VecAluOp.MulOddU) (put_in_reg x) (put_in_reg y) $I32X4)
                (vec_alu_rrr (VecAluOp.MulEvenU) (put_in_reg x) (put_in_reg y) $I32X4))))

;; Narrowing. The pack fills the result's big-endian doubleword 0 from
;; its *first* operand's eight lanes, and here each source contributes
;; only four -- so the two are gathered into one register first, `y`
;; below `x`, which is the order that leaves CLIF's `x` in the low
;; lanes.
(decl narrow64 (VecAluOp Value Value Type) Reg)
(rule (narrow64 op x y in_ty)
  (let ((gathered Reg (vec_permdi (put_in_reg y) (put_in_reg x) 0)))
    (vec_alu_rrr op gathered gathered in_ty)))

;; The pack is selected by the *source* lane width, and these
;; opcodes' controlling type is the narrower result -- so, as in the
;; 128-bit rules, the width comes from the argument.
(rule 1 (lower (snarrow _ x @ (value_type (ty_vec64 in_ty)) y))
  (output_reg (narrow64 (VecAluOp.PackSS) x y in_ty)))
(rule 1 (lower (unarrow _ x @ (value_type (ty_vec64 in_ty)) y))
  (output_reg (narrow64 (VecAluOp.PackSU) x y in_ty)))
(rule 1 (lower (uunarrow _ x @ (value_type (ty_vec64 in_ty)) y))
  (output_reg (narrow64 (VecAluOp.PackUU) x y in_ty)))

;;;; Lane access on 64-bit vectors ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Both lane-access paths turn a little-endian lane index into a
;; big-endian element number by subtracting it from the lane count less
;; one. A 64-bit vector occupies big-endian doubleword 0, so its lane j
;; is big-endian element n - 1 - j for its *own* lane count n -- half
;; the 128-bit type's. Restating the index as `lane + n` makes the wider
;; path's subtraction land on exactly that element, so these reuse it
;; rather than duplicating the element arithmetic.

(rule 1 (lower (extractlane _ x @ (value_type (ty_vec64 ty)) (u8_from_uimm8 lane)))
  (if-let true (ty_vec_is_int ty))
  (output_reg (vec_extract_lane_int (put_in_reg x)
                                    (ty_vec64_widened ty)
                                    (vec64_lane_in_128 ty lane))))

(rule 2 (lower (extractlane _ x @ (value_type (ty_vec64 ty)) (u8_from_uimm8 lane)))
  (if-let false (ty_vec_is_int ty))
  (output_reg (vec_extract_lane_fpu (put_in_reg x)
                                    (ty_vec64_widened ty)
                                    (vec64_lane_in_128 ty lane))))

(rule 1 (lower (insertlane _ x @ (value_type (ty_vec64 ty)) y (u8_from_uimm8 lane)))
  (output_reg (vec_insert_lane (put_in_reg x) (put_in_reg y)
                               (ty_vec64_widened ty)
                               (vec64_lane_in_128 ty lane))))
