    dst))

(decl vec_round (FpuRoundMode Reg Type) Reg)
(rule (vec_round mode rn ty)
  (let ((dst WritableReg (temp_writable_reg $I8X16))
        (_ Unit (emit (MInst.VecRound dst rn mode ty))))
    dst))

(decl vec_sel (Reg Reg Reg) Reg)
(rule (vec_sel if_set if_clear mask)
  (let ((dst WritableReg (temp_writable_reg $I8X16))
        (_ Unit (emit (MInst.VecSel dst if_set if_clear mask))))
    dst))

(decl vec_test_lanes (Reg Type bool) Reg)
(rule (vec_test_lanes rn ty all)
  (let ((dst WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.VecTestLanes dst rn ty all))))
    dst))

(decl vec_fpu_rrr (VecFpuOp2 Reg Reg Type) Reg)
(rule (vec_fpu_rrr op a b ty)
  (let ((dst WritableReg (temp_writable_reg $I8X16))
        (_ Unit (emit (MInst.VecFpuRRR op dst a b ty))))
    dst))

(decl vec_fpu_rr (VecFpuOp1 Reg Type) Reg)
(rule (vec_fpu_rr op rn ty)
  (let ((dst WritableReg (temp_writable_reg $I8X16))
        (_ Unit (emit (MInst.VecFpuRR op dst rn ty))))
    dst))

;; Complement every lane: `vnor rd, x, x`.
(decl vec_not (Reg Type) Reg)
(rule (vec_not x ty) (vec_alu_rrr (VecAluOp.Nor) x x ty))

;; Splat a scalar shift amount across the lanes of `ty`. The amount is
;; left unmasked: see `VecAluOp.Shl`. CLIF permits the amount to be any
;; integer type including `i128`, so it goes through `shift_amt_64`,
;; which takes just the low doubleword of a pair.
(decl vec_shift_amount (Value Type) Reg)
(rule (vec_shift_amount amt ty)
  (vec_splat_lane (mov_to_vec (shift_amt_64 amt)) ty))

(decl gen_vec_load (AMode MemFlagsData) Reg)
(rule (gen_vec_load mem flags)
  (let ((dst WritableReg (temp_writable_reg $I8X16))
        (_ Unit (emit (MInst.VecLoad dst mem flags))))
    dst))

(decl gen_vec_store (AMode MemFlagsData Reg) SideEffectNoResult)
(rule (gen_vec_store mem flags src)
  (SideEffectNoResult.Inst (MInst.VecStore mem src flags)))

(decl vec_zero () Reg)
(rule (vec_zero)
  (let ((dst WritableReg (temp_writable_reg $I8X16))
        (_ Unit (emit (MInst.VecZero dst))))
    dst))

(decl mov_to_vec (Reg) Reg)
(rule (mov_to_vec rn)
  (let ((dst WritableReg (temp_writable_reg $I8X16))
        (_ Unit (emit (MInst.MovToVec dst rn))))
    dst))

(decl vec_splat_lane (Reg Type) Reg)
(rule (vec_splat_lane rn ty)
  (let ((dst WritableReg (temp_writable_reg $I8X16))
        (_ Unit (emit (MInst.VecSplatLane dst rn ty))))
    dst))

(decl vec_splat_fpr (Reg bool) Reg)
(rule (vec_splat_fpr rn is_f32)
  (let ((dst WritableReg (temp_writable_reg $I8X16))
        (_ Unit (emit (MInst.VecSplatFpr dst rn is_f32))))
    dst))

;; Materialize a 128-bit vector constant. Little-endian byte j of `n`
;; becomes lane byte j.
(decl vec_const (u128) Reg)
(rule 1 (vec_const n)
  (if-let true (u128_is_zero n))
  (vec_zero))
(rule 0 (vec_const n)
  (let ((lo Reg (imm $I64 (vconst_lo64 n)))
        (hi Reg (imm $I64 (vconst_hi64 n))))
    (vec_permdi (mov_to_vec hi) (mov_to_vec lo) 0)))

;; The `vperm` control vector for a CLIF `shuffle` mask: lane byte j is
;; 31 - mask[j], the big-endian position of the byte the mask selects.
(decl shuffle_ctrl (u128) u128)
(extern constructor shuffle_ctrl shuffle_ctrl)

(decl vec_permdi (Reg Reg u8) Reg)
(rule (vec_permdi a b dm)
  (let ((dst WritableReg (temp_writable_reg $I8X16))
        (_ Unit (emit (MInst.VecPermDi dst a b dm))))
    dst))

;; Split a 128-bit constant for materialization through the GPRs.
(decl pure vec_lanes_under_64 (Type) bool)
(extern constructor vec_lanes_under_64 vec_lanes_under_64)

;; Narrowing needs a source wider than a byte; there is nothing to
;; pack bytes into.
(decl pure vec_lanes_over_8 (Type) bool)
(extern constructor vec_lanes_over_8 vec_lanes_over_8)

(decl pure vconst_lo64 (u128) u64)
(extern constructor vconst_lo64 vconst_lo64)
(decl pure vconst_hi64 (u128) u64)
(extern constructor vconst_hi64 vconst_hi64)

(decl fpu_to_int (Reg bool bool Type Type) Reg)
(rule (fpu_to_int rn signed sat in_ty out_ty)
  (let ((dst WritableReg (temp_writable_reg $I64))
        (tmp WritableReg (temp_writable_reg $F64))
        (_ Unit (emit (MInst.FpuToInt dst tmp rn signed sat in_ty out_ty))))
    dst))

(decl fpu_min_max (Reg Reg bool Type) Reg)
(rule (fpu_min_max ra rb is_max ty)
  (let ((dst WritableReg (temp_writable_reg ty))
        (_ Unit (emit (MInst.FpuMinMax dst ra rb is_max))))
    dst))

(decl mov_from_fpr (Reg) Reg)
(rule (mov_from_fpr rn)
  (let ((dst WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.MovFromFpr dst rn))))
    dst))

;; An `f32` lives in an FPR in double format, so its constant is the bit
;; pattern of the widened value.
(decl f32_bits_as_f64 (u32) u64)
(extern constructor f32_bits_as_f64 f32_bits_as_f64)

;; Materialize a 64-bit immediate.
(decl imm (Type u64) Reg)
(rule (imm _ty n)
  (let ((dst WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.LoadConst64 dst n))))
    dst))

;; Sign/zero extension.
(decl gen_extend (Reg bool u8 u8) Reg)
;; Extending from 64 bits is a no-op: the value already fills the
;; register. (Reached e.g. by `uextend`/`sextend` from `i64` to `i128`,
;; where only the high half needs producing.)
(rule 1 (gen_extend val _ 64 _) val)
(rule 0 (gen_extend val signed from to)
  (let ((dst WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.Extend dst val signed from to))))
    dst))

;; Loads and stores. The AMode is constructed by the `amode` extern
;; constructor implemented in `lower/isle.rs`.
(decl amode (Value i32) AMode)
(extern constructor amode amode)

;; The same address eight bytes on, for the high half of an `i128`.
(decl amode8 (Value i32) AMode)
(extern constructor amode8 amode8)

;; Condition-code decomposition for ordered 128-bit comparisons: the
;; strict same-signedness compare for the high halves, and the
;; unsigned same-strictness compare for the low halves. Both fail on
;; equal/not-equal.
(decl pure partial icmp128_hi_cc (IntCC) IntCC)
(extern constructor icmp128_hi_cc icmp128_hi_cc)
(decl pure partial icmp128_lo_cc (IntCC) IntCC)
(extern constructor icmp128_lo_cc icmp128_lo_cc)

(decl load_op_for_type (Type) LoadOP)
(extern constructor load_op_for_type load_op_for_type)
(decl store_op_for_type (Type) StoreOP)
(extern constructor store_op_for_type store_op_for_type)

(decl gen_load (Type AMode MemFlagsData) Reg)
(rule (gen_load ty mem flags)
  (let ((dst WritableReg (temp_writable_reg ty))
        (_ Unit (emit (MInst.Load dst (load_op_for_type ty) flags mem))))
    dst))

(decl gen_store (Type AMode MemFlagsData Reg) SideEffectNoResult)
(rule (gen_store ty mem flags src)
  (SideEffectNoResult.Inst (MInst.Store mem (store_op_for_type ty) flags src)))

;; Integer comparisons. Narrow (<32 bit) inputs are extended by the
;; lowering rules before this is used; `cmpw`/`cmpd` (and their logical
;; variants) ignore or use the full register appropriately for 32/64 bit.
(decl int_compare (IntCC Reg Reg Type) IntegerCompare)
(extern constructor int_compare int_compare)

(decl gen_stack_addr (StackSlot Offset32) Reg)
(extern constructor gen_stack_addr gen_stack_addr)

(decl cmp_set (IntegerCompare) Reg)
(rule (cmp_set kind)
  (let ((dst WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.CmpSet dst kind))))
    dst))

;; Reads of the stack/frame pointer and of the return address (which
;; the prologue stored at [FP+8]).
(decl ppc_mov_from_preg (u8) Reg)
(rule (ppc_mov_from_preg rm)
  (let ((dst WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.MovFromPReg dst rm))))
    dst))

(decl read_return_address () Reg)
(extern constructor read_return_address read_return_address)

;; The address of a label, for exception-handler tables.
(decl ppc_label_address (MachLabel) Reg)
(rule (ppc_label_address label)
  (let ((dst WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.LabelAddress dst label))))
    dst))

(decl lower_br_table (Reg MachLabelSlice) Unit)
(extern constructor lower_br_table lower_br_table)

;; Atomic helpers.
(decl gen_atomic_load (Reg Type) Reg)
(rule (gen_atomic_load addr ty)
  (let ((dst WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.AtomicLoad dst addr ty))))
    dst))

(decl gen_atomic_store (Reg Reg Type) SideEffectNoResult)
(rule (gen_atomic_store src addr ty)
  (SideEffectNoResult.Inst (MInst.AtomicStore src addr ty)))

(decl gen_atomic_rmw (AtomicRmwOp Reg Reg Type) Reg)
(rule (gen_atomic_rmw op addr src ty)
  (let ((dst WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.AtomicRmw op dst addr src ty))))
    dst))

(decl gen_atomic_cas (Reg Reg Reg Type) Reg)
(rule (gen_atomic_cas addr expected new ty)
  (let ((dst WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.AtomicCas dst addr expected new ty))))
    dst))

;; 128-bit atomics; results come back as a lo/hi pair.
(decl gen_atomic_load128 (Reg) ValueRegs)
(rule (gen_atomic_load128 addr)
  (let ((lo WritableReg (temp_writable_reg $I64))
        (hi WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.AtomicLoad128 lo hi addr))))
    (value_regs lo hi)))

(decl gen_atomic_store128 (Reg Reg Reg) SideEffectNoResult)
(rule (gen_atomic_store128 src_lo src_hi addr)
  (let ((tmp_lo WritableReg (temp_writable_reg $I64))
        (tmp_hi WritableReg (temp_writable_reg $I64)))
    (SideEffectNoResult.Inst (MInst.AtomicStore128 src_lo src_hi tmp_lo tmp_hi addr))))

(decl gen_atomic_rmw128 (AtomicRmwOp Reg Reg Reg) ValueRegs)
(rule (gen_atomic_rmw128 op addr src_lo src_hi)
  (let ((lo WritableReg (temp_writable_reg $I64))
        (hi WritableReg (temp_writable_reg $I64))
        (tmp_hi WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.AtomicRmw128 op lo hi tmp_hi addr src_lo src_hi))))
    (value_regs lo hi)))

(decl gen_atomic_cas128 (Reg Reg Reg Reg Reg) ValueRegs)
(rule (gen_atomic_cas128 addr exp_lo exp_hi new_lo new_hi)
  (let ((lo WritableReg (temp_writable_reg $I64))
        (hi WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.AtomicCas128 lo hi addr exp_lo exp_hi new_lo new_hi))))
    (value_regs lo hi)))

;; Extend `src` for an atomic min/max: the compare inside the loop is
;; done at full width against the zero-extended loaded value.
(decl atomic_rmw_src (AtomicRmwOp Type Value) Reg)
(extern constructor atomic_rmw_src atomic_rmw_src)

;; Branch helpers.
(decl ppc_jump (MachLabel) SideEffectNoResult)
(rule (ppc_jump label) (SideEffectNoResult.Inst (MInst.Jump label)))

(decl cond_br_target (MachLabel) CondBrTarget)
(extern constructor cond_br_target cond_br_target)

(decl ppc_cond_br (IntegerCompare MachLabel MachLabel) SideEffectNoResult)
(rule (ppc_cond_br kind taken not_taken)
  (SideEffectNoResult.Inst
    (MInst.CondBr (cond_br_target taken) (cond_br_target not_taken) kind)))
