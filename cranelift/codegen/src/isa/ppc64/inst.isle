(decl fpu_cond_br (FloatCompare MachLabel MachLabel) SideEffectNoResult)
(rule (fpu_cond_br kind taken not_taken)
  (SideEffectNoResult.Inst
    (MInst.FpuCondBr (cond_br_target taken) (cond_br_target not_taken) kind)))

;; Move bits between a GPR and an FPR. PPC has no floating-point immediate
;; form, so constants are built in a GPR and transferred.
(decl mov_to_fpr (Reg Type) Reg)
(rule (mov_to_fpr rn ty)
  (let ((dst WritableReg (temp_writable_reg ty))
        (_ Unit (emit (MInst.MovToFpr dst rn))))
    dst))

;; Convert an integer to floating point. `fcfid` and friends read a 64-bit
;; integer out of an FPR, so the value is widened to 64 bits in a GPR and
;; then transferred across.
(decl int_to_fpu (Reg bool Type) Reg)
(rule (int_to_fpu rn signed ty)
  (let ((dst WritableReg (temp_writable_reg ty))
        (_ Unit (emit (MInst.IntToFpu dst rn signed ty))))
    dst))

(decl gen_int_to_fpu (Value Type bool Type) Reg)
(rule (gen_int_to_fpu val in_ty signed out_ty)
  (int_to_fpu (mov_to_fpr (gen_extend (put_in_reg val) signed (ty_bits in_ty) 64) $F64)
              signed
              out_ty))

(decl fpu_round (FpuRoundMode Reg) Reg)
(rule (fpu_round mode rn)
  (let ((dst WritableReg (temp_writable_reg $F64))
        (_ Unit (emit (MInst.FpuRound dst rn mode))))
    dst))

(decl gen_bswap (Type Reg) Reg)
(rule (gen_bswap ty rn)
  (let ((dst WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.Bswap dst rn ty))))
    dst))

(decl vec_alu_rrr (VecAluOp Reg Reg Type) Reg)
(rule (vec_alu_rrr op a b ty)
