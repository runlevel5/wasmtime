;; Instruction formats for the ppc64le backend.
;;
;; This backend targets the ELFv2 ABI, little-endian, with a POWER8 (ISA
;; 2.07) baseline. See `abi.rs` for the frame layout and register
;; conventions.

;; Types passed through to Rust; defined in `inst/args.rs` and the shared
;; machinst code.
(type BoxCallInfo (primitive BoxCallInfo))
(type BoxCallIndInfo (primitive BoxCallIndInfo))
(type BoxReturnCallInfo (primitive BoxReturnCallInfo))
(type BoxReturnCallIndInfo (primitive BoxReturnCallIndInfo))
(type IntegerCompare (primitive IntegerCompare))
(type AMode (primitive AMode))
(type CondBrTarget (primitive CondBrTarget))
(type FloatCompare (primitive FloatCompare))
(type VecMachLabel extern (enum))

;; Integer ALU operations, register-register. The emitter maps these to
;; XO-form (add/subf/mull/div) or X-form (logicals) encodings.
(type AluOp
  (enum
    (Add)
    (Sub)
    (And)
    (Or)
    (Xor)
    (Mulld)
    ;; Carrying adds and subtracts for 128-bit arithmetic. `Addc`/`Subfc`
    ;; set XER.CA and `Adde`/`Subfe` consume it. The pair is emitted as
    ;; two separate instructions rather than one fused pseudo-instruction
    ;; because nothing that can appear between them clobbers the carry:
    ;; the lowering rules place the pair adjacently within one rule, and
    ;; everything the register allocator or the machine buffer may insert
    ;; -- `mr` (encoded as `or`), spill loads and stores, `addi` address
    ;; arithmetic, constant materialization, or a branch around an island
    ;; -- leaves XER.CA untouched. No other instruction this backend
    ;; emits writes CA.
    (Addc)
    (Adde)
    (Subfc)
    (Subfe)
    ;; High half of a 64x64 product.
    (Mulhd)
    (Mulhdu)
    ;; High half of a 32x32 product.
    (Mulhw)
    (Mulhwu)
))

;; ALU operations with a 16-bit immediate. `Addi` reads the immediate as
;; signed, `Andi` as unsigned; the lowering rules only produce values in
;; the appropriate range.
(type AluImmOp
  (enum
    (Addi)
    (Andi)
))

;; Shift operations. The shift amount is masked by the lowering rules:
;; PPC's shifts consume 6 bits (word forms) or 7 bits (doubleword forms)
;; and produce zero when the amount exceeds the width, whereas CLIF masks
;; the amount to the type's width.
(type ShiftOp
  (enum
    (Slw)
    (Srw)
    (Sraw)
    (Sld)
    (Srd)
    (Srad)
    ;; Rotates; the amount is masked by the hardware to the width.
    (Rotlw)
    (Rotld)
))

;; Single-operand integer operations.
(type UnaryOp
  (enum
    (Neg)
    (Not)
))

;; Bit-counting operations, expanded at emit time: the POWER9 (ISA 3.0)
;; `cnttz{w,d}` instructions are used when available, otherwise trailing
;; zeros are emulated.
(type BitOp
  (enum
    (Clz)
    (Ctz)
    (Popcnt)
))

;; Division and remainder. Expanded at emit time because PPC's divide
;; instructions leave the result undefined rather than trapping on a zero
;; divisor or on signed overflow, so the checks CLIF requires must be
;; emitted explicitly.
(type DivOp
  (enum
    (SDiv)
    (UDiv)
    (SRem)
    (URem)
))


;; Floating-point binary operations. The single-precision forms differ only
;; in primary opcode, so the operand type selects between them.
(type FpuOp2
  (enum
    (Add)
    (Sub)
    (Mul)
    (Div)
    (CopySign)
))

;; Floating-point unary operations.
(type FpuOp1
  (enum
    (Neg)
    (Abs)
    (Sqrt)
    (Mov)
    ;; Round a double to single precision (`frsp`), for `fdemote`.
    (Demote)
    ;; Non-signalling conversions between the double held in an FPR and
    ;; the single-precision encoding in the register's high word. These
    ;; preserve NaN payloads, which is what makes them usable for
    ;; reinterpreting an `f32`'s bits.
    (CvtToSingleBits)
    (CvtFromSingleBits)
))

;; Vector integer lane arithmetic and bitwise logic. The type on the
;; MInst selects the lane width for Add/Sub; the logicals ignore it.
(type VecAluOp
  (enum
    (Add)
    (Sub)
    (And)
    (Or)
    (Xor)
    (Nor)
    ;; `a & ~b`, for clearing lanes a mask has selected.
    (AndC)
    ;; Lane comparisons, producing an all-ones or all-zeros mask per
    ;; lane, which is exactly CLIF's vector `icmp` result. Only equality
    ;; and greater-than exist in hardware; the lowering rules get the
    ;; other six conditions by swapping operands and/or complementing.
    (CmpEq)
    (CmpGtS)
    (CmpGtU)
    (MinS)
    (MinU)
    (MaxS)
    (MaxU)
    ;; Per-lane shifts. The hardware uses only the low log2(lane width)
    ;; bits of each element of the amount, which matches CLIF's rule
    ;; that the amount is masked to the lane width, so the lowering
    ;; rules splat the scalar amount without masking it.
    (Shl)
    (ShrU)
    (ShrS)
    ;; Rounding average, `(a + b + 1) >> 1`, which is exactly CLIF's
    ;; `avg_round` and wasm's `avgr_u`. Byte, halfword and word only:
    ;; the ISA has no doubleword average, and neither proposal needs one.
    (AvgRoundS)
    (AvgRoundU)
    ;; Saturating add and subtract. Byte, halfword and word only: the
    ;; ISA has no doubleword saturating arithmetic, and neither CLIF's
    ;; users nor wasm need one.
    (SAddSat)
    (UAddSat)
    (SSubSat)
    (USubSat)
    ;; Interleave with a zero vector, which is how unsigned widening is
    ;; done: the ISA has signed unpack instructions but no unsigned
    ;; ones. `MergeLow` takes the *register's* low-order half, which
    ;; under this backend's little-endian lane order is CLIF's low
    ;; lanes -- see the note on the widening rules.
    (MergeLow)
    (MergeHigh)
    ;; Saturating pack, selected by the *source* lane width: signed to
    ;; signed, signed to unsigned, unsigned to unsigned.
    (PackSS)
    (PackSU)
    (PackUU)
    ;; Word-lane multiply, low half (`vmuluwm`). Word only.
    (MulWord)
    ;; Even/odd multiplies: the full double-width product of every
    ;; other source lane, selected by the *source* lane width. The
    ;; mnemonics' "even" and "odd" refer to big-endian elements, so
    ;; under this backend's lane order they are inverted: `vmule*`
    ;; takes the odd little-endian lanes and `vmulo*` the even ones.
    ;; (Hence `MulOddU` at word width supplying a doubleword's low-half
    ;; product, which is what the i64x2 multiply needs.)
    (MulEvenS)
    (MulOddS)
    (MulEvenU)
    (MulOddU)
    ;; Truncating pack -- the low half of each source lane, no
    ;; saturation. Indexed by source width.
    (PackMod)
    ;; `vmrgew`: interleave the odd little-endian word lanes of the two
    ;; operands. Word only.
    (MergeEvenWord)
    ;; Rotate each doubleword left by the per-lane amount (`vrld`).
    (RotlDword)

))

;; Four-operand VMX multiply forms. Each is per-lane, so unlike the
;; even/odd multiplies they need no big-endian element reasoning.
(type VecAluOp4
  (enum
    ;; (a * b + c) mod 2^16, per halfword: vector `imul` with c = 0.
    (MulAddUH)
    ;; NOTE: `vmsumshm` (per word, the sum of that word's two halfword
    ;; products, plus c) computes exactly the tree that CLIF spells as
    ;; swiden + imul + iadd_pairwise -- the same fusion aarch64 does to
    ;; reach `sdot`. Worth folding once `iadd_pairwise` exists, and
    ;; worth measuring first: Phase 6 found instruction-count wins do
    ;; not necessarily show up in wall-clock on this core.
    ;; sat((a * b + 0x4000) >> 15) + c per halfword, which is exactly
    ;; CLIF's Q15 saturating rounding multiply when c = 0.
    (MulHiRoundAddSHS)
    ;; Byte permute: `a` and `b` are concatenated into a 32-byte value
    ;; and each byte of `c` selects one byte of it, using only the low
    ;; five bits. Defined in big-endian element terms, which is what
    ;; makes the lowering rules below reverse the operands.
    (Perm)
))

;; Single-operand lane operations in VX form (RA field zero).
;; Lane-wise conversions between floating point and integers. The
;; float-to-integer forms truncate toward zero and saturate to the
;; representable range, which is what CLIF's saturating conversions
;; ask for -- but only the *unsigned* ones already give zero for a NaN
;; lane. Probed on a POWER9: the signed forms produce the most negative
;; value for NaN, so those rules mask the NaN lanes afterwards.
(type VecCvtOp
  (enum
    (F32ToI32S)
    (F32ToI32U)
    (I32ToF32S)
    (I32ToF32U)
    (F64ToI64S)
    (F64ToI64U)
    (I64ToF64S)
    (I64ToF64U)
    ;; Precision changes between float widths. These do not convert in
    ;; place: `xvcvdpsp` writes its two single-precision results to
    ;; alternating words and `xvcvspdp` reads its two sources from
    ;; alternating words, so both need the lanes gathered around them.
    (F64ToF32)
    (F32ToF64)
))

(type VecUnaryOp
  (enum
    (Popcnt)
    ;; Sign-extending unpack, selected by the *source* lane width.
    (WidenSLow)
    (WidenSHigh)
))

;; Floating-point lane arithmetic; the lane type selects between the
;; single- and double-precision forms.
(type VecFpuOp2
  (enum
    (Add)
    (Sub)
    (Mul)
    (Div)
    ;; Ordered lane comparisons, producing an all-ones or all-zeros
    ;; mask. A NaN operand makes all three false, which is what the
    ;; unordered-aware conditions are built from.
    (CmpEq)
    (CmpGt)
    (CmpGe)
    ;; Lane minimum and maximum. Probed on a POWER9: these give the
    ;; signed-zero behaviour CLIF wants, and give it independently of
    ;; operand order -- stronger than IEEE minNum requires -- and they
    ;; handle infinities correctly. On a *quiet* NaN, though, they
    ;; return the numeric operand, where CLIF requires a NaN, so the
    ;; lowering rules add a fixup. (A signalling NaN they do quiet and
    ;; return, but the fixup covers that case too.)
    (Min)
    (Max)
))

(type VecFpuOp1
  (enum
    (Sqrt)
    (Neg)
    (Abs)
))

;; Floating-point round-to-integral. Ceil/floor/trunc map to
;; `frip`/`frim`/`friz`; `nearest` needs ties-to-even, which none of the
;; `fri*` family provides (`frin` rounds ties away from zero), so it
;; uses `xsrdpic`, rounding by the current FPSCR mode -- and Cranelift
;; code always runs with the default round-to-nearest-even.
(type FpuRoundMode
  (enum
    (Floor)
    (Ceil)
    (Trunc)
    (Nearest)
))

;; Load opcodes; selected by type in `LoadOP::from_type`.
(type LoadOP
  (enum
    (Lbz)   ;; i8, zero-extending
    (Lhz)   ;; i16, zero-extending
    (Lwz)   ;; i32, zero-extending
    (Ld)    ;; i64
    (Lfs)   ;; f32
    (Lfd)   ;; f64
))

;; Store opcodes.
(type StoreOP
  (enum
    (Stb)
    (Sth)
    (Stw)
    (Std)
    (Stfs)
    (Stfd)
))

(type MInst
  (enum
    ;; A no-op of zero size.
    (Nop0)

    ;; A 4-byte no-op (`ori r0, r0, 0`).
    (Nop4)

    ;; Materialize a 64-bit constant, using the shortest sequence of
    ;; `li`/`lis`/`ori`/`rldicr`/`oris` the emitter can find (1-5
    ;; instructions). PPC64 before POWER10 has no PC-relative addressing,
    ;; so constants are built from immediates rather than loaded from a
    ;; pool by default.
    (LoadConst64
      (rd WritableReg)
      (imm u64))

    ;; Register-register ALU operation.
    (AluRRR
      (op AluOp)
      (rd WritableReg)
      (ra Reg)
      (rb Reg))

    ;; ALU operation with a 16-bit immediate.
    (AluRRImm16
      (op AluImmOp)
      (rd WritableReg)
      (ra Reg)
      (imm u16))

    ;; Single-operand integer operation.
    (UnaryRR
      (op UnaryOp)
      (rd WritableReg)
      (rn Reg))

    ;; Shift by a register amount, pre-masked by the lowering rules.
    (ShiftRRR
      (op ShiftOp)
      (rd WritableReg)
      (ra Reg)
      (rb Reg))

    ;; Shift by a constant amount. PPC has no shift-immediate opcodes as
    ;; such: the doubleword forms are `rldicl`/`rldicr` (rotate-and-mask)
    ;; and the word forms `rlwinm`, with only the arithmetic shifts
    ;; (`sradi`/`srawi`) having dedicated immediate encodings. The
    ;; lowering rules pre-mask the amount to the type's width, so it is
    ;; always in range for the selected form.
    (ShiftRRImm
      (op ShiftOp)
      (rd WritableReg)
      (ra Reg)
      (imm u8))

    ;; Bit count. `ty` selects the word or doubleword form and, for
    ;; trailing zeros without ISA 3.0, the emulation sequence.
    (BitCount
      (op BitOp)
      (rd WritableReg)
      (rn Reg)
      (ty Type))

    ;; Division or remainder, including the divide-by-zero and signed
    ;; overflow checks CLIF requires.
    (DivRem
      (op DivOp)
      (rd WritableReg)
      (ra Reg)
      (rb Reg)
      (ty Type))

    ;; Conditional select via `cmp` + `isel`.
    (Select
      (rd WritableReg)
      (kind IntegerCompare)
      (rt Reg)
      (rf Reg))

    ;; Floating-point binary operation.
    (FpuRRR
      (op FpuOp2)
      (rd WritableReg)
      (ra Reg)
      (rb Reg)
      (ty Type))

    ;; Floating-point unary operation.
    (FpuRR
      (op FpuOp1)
      (rd WritableReg)
      (rn Reg)
      (ty Type))

    ;; Round to an integral value in floating-point.
    (FpuRound
      (rd WritableReg)
      (rn Reg)
      (mode FpuRoundMode))

    ;; Byte-reverse the low `ty` bits: store to the ELFv2 red zone
    ;; (the 288 bytes below SP, which the Linux kernel leaves intact
    ;; across signal delivery) and reload with a byte-reversed load.
    ;; The address lives in r0.
    (Bswap
      (rd WritableReg)
      (rn Reg)
      (ty Type))

    ;; Vector loads and stores. Lane order in the register is
    ;; little-endian: wasm lane 0 in the least-significant bits, memory
    ;; byte 0 at the LSB end, so `bitcast` between `i64x2` lane 0 and a
    ;; scalar is the identity and lane `i` of an `iNxM` sits at byte
    ;; offset `i*N/8` in memory. On ISA 3.0 this is exactly `lxvx` /
    ;; `stxvx`; before it (the POWER8 baseline), `lxvd2x`/`stxvd2x`
    ;; load big-endian doubleword pairs and each access adds an
    ;; `xxswapd` -- through the reserved scratch v0 for stores, since
    ;; spill stores cannot allocate a temporary. All forms are
    ;; alignment-free.
    (VecLoad
      (rd WritableReg)
      (from AMode)
      (flags MemFlagsData))

    (VecStore
      (to AMode)
      (rs Reg)
      (flags MemFlagsData))

    ;; Vector register-register ALU operation.
    (VecAluRRR
      (op VecAluOp)
      (rd WritableReg)
      (ra Reg)
      (rb Reg)
      (ty Type))

    ;; Extract a lane to a GPR: splat the wanted lane across the
    ;; reserved scratch v0 (`vsplt{b,h,w}`, or `xxpermdi` for
    ;; doublewords) and read big-endian doubleword 0 with `mfvsrd`.
    ;; The value lands in the low lane-width bits with copies of
    ;; itself above, which the backend's narrow-value convention
    ;; permits. Register-only and POWER8-clean; the lane index is
    ;; translated to big-endian element numbering at emission, the
    ;; only place allowed to see it.
    (VecExtractLaneInt
      (rd WritableReg)
      (rn Reg)
      (ty Type)
      (lane u8))

    ;; Extract a float lane to an FPR: `xxspltw` + `xscvspdpn` widens
    ;; an `f32` lane into the double-held-in-FPR form scalars use;
    ;; an `f64` lane is one `xxpermdi` placing it in doubleword 0.
    (VecExtractLaneFpu
      (rd WritableReg)
      (rn Reg)
      (ty Type)
      (lane u8))

    ;; Replace one lane: the vector round-trips through the red zone
    ;; and the scalar store overwrites the lane's bytes -- with the
    ;; little-endian lane order, lane i of an `iNxM` sits at byte
    ;; offset i*N/8, and `stfs` converts the widened-double `f32`
    ;; scalar to its single-precision lane bits for free. Uniform
    ;; across every lane type and POWER8-clean; the ISA 3.0
    ;; `vinsert*` forms are a later optimization.
    (VecInsertLane
      (rd WritableReg)
      (rv Reg)
      (rs Reg)
      (ty Type)
      (lane u8))

    ;; Four-operand lane multiply.
    (VecAluRRRR
      (op VecAluOp4)
      (rd WritableReg)
      (ra Reg)
      (rb Reg)
      (rc Reg))

    ;; Lane-wise float/integer conversion.
    (VecCvt
      (op VecCvtOp)
      (rd WritableReg)
      (rn Reg))

    ;; Splat a 5-bit signed immediate to every lane (`vspltis{b,h,w}`).
    ;; Useful beyond small constants: the vector shifts read only the
    ;; low log2(lane width) bits of each element, so a negative
    ;; immediate can encode a shift amount its range would not
    ;; otherwise reach -- -16 splatted to words has low five bits 16.
    (VecSpltImm
      (rd WritableReg)
      (imm i8)
      (ty Type))

    ;; Single-operand lane operation.
    (VecUnary
      (op VecUnaryOp)
      (rd WritableReg)
      (rn Reg)
      (ty Type))

    ;; Round float lanes to integral values. As for the scalar case,
    ;; `nearest` needs ties-to-even, which the `xvr*ic` forms give by
    ;; rounding in the current FPSCR mode; the plain `xvr*i` forms
    ;; round ties away from zero and cannot implement it.
    (VecRound
      (rd WritableReg)
      (rn Reg)
      (mode FpuRoundMode)
      (ty Type))

    ;; Bitwise select (`xxsel`): each result bit comes from `if_set`
    ;; where the mask bit is set, `if_clear` where it is clear.
    (VecSel
      (rd WritableReg)
      (if_set Reg)
      (if_clear Reg)
      (mask Reg))

    ;; Reduce a vector to a 0/1 GPR: whether all lanes, or any lane, is
    ;; non-zero. The record form of the equality compare sets CR6, whose
    ;; EQ bit means "no lane compared equal" (so every lane is non-zero)
    ;; and whose LT bit means "every lane compared equal" (so no lane
    ;; is). CR6 is read by the `isel` inside this same expansion, which
    ;; keeps condition-register use entirely local, exactly as the cr0
    ;; sequences do. The comparison must use the value's own lane width:
    ;; a 32-bit lane holding 1 is non-zero yet contains three zero
    ;; bytes, so a byte-wise test would answer `vall_true` wrongly.
    (VecTestLanes
      (rd WritableReg)
      (rn Reg)
      (ty Type)
      (all bool))

    ;; Floating-point lane arithmetic.
    (VecFpuRRR
      (op VecFpuOp2)
      (rd WritableReg)
      (ra Reg)
      (rb Reg)
      (ty Type))

    (VecFpuRR
      (op VecFpuOp1)
      (rd WritableReg)
      (rn Reg)
      (ty Type))

    ;; Materialize the all-zeros vector (`xxlxor rd, rd, rd`).
    (VecZero
      (rd WritableReg))

    ;; Move a GPR into doubleword element 0 (the most-significant
    ;; doubleword) of a vector register (`mtvsrd`).
    (MovToVec
      (rd WritableReg)
      (rn Reg))

    ;; Splat the scalar that `MovToVec` deposited: the value sits at
    ;; the low end of big-endian doubleword 0, so the source lane is
    ;; BE byte 7 / halfword 3 / word 1, or the doubleword itself.
    (VecSplatLane
      (rd WritableReg)
      (rn Reg)
      (ty Type))

    ;; Splat from an FPR: `xxspltw` of big-endian word 0 for an `f32`
    ;; whose single-precision bits `xscvdpspn` placed there, or
    ;; `xxpermdi` doubling doubleword 0 for an `f64`.
    (VecSplatFpr
      (rd WritableReg)
      (rn Reg)
      (is_f32 bool))

    ;; `xxpermdi rd, ra, rb, dm`, all operands vector registers.
    (VecPermDi
      (rd WritableReg)
      (ra Reg)
      (rb Reg)
      (dm u8))

    ;; Fused multiply-add: `rd = ra * rc + rb`.
    (FpuFma
      (rd WritableReg)
      (ra Reg)
      (rc Reg)
      (rb Reg)
      (ty Type))

    ;; Materialize a floating-point comparison result as 0/1 in a GPR.
    (FpuCmpSet
      (rd WritableReg)
      (kind FloatCompare))

    ;; Conditional branch on a floating-point comparison.
    (FpuCondBr
      (taken CondBrTarget)
      (not_taken CondBrTarget)
      (kind FloatCompare))

    ;; Convert a 64-bit integer, held in an FPR, to floating point.
    ;; `signed` selects `fcfid`/`fcfidu`, and `ty` the result precision.
    (IntToFpu
      (rd WritableReg)
      (rn Reg)
      (signed bool)
      (ty Type))

    ;; Convert floating point to integer, with the checks CLIF requires:
    ;; the trapping form traps on NaN and out-of-range inputs, while the
    ;; saturating form maps NaN to zero and lets the hardware's saturating
    ;; conversions handle the bounds. `tmp` holds the bound constants.
    (FpuToInt
      (rd WritableReg)
      (tmp WritableReg)
      (rn Reg)
      (signed bool)
      (sat bool)
      (in_ty Type)
      (out_ty Type))

    ;; IEEE 754 minimum/maximum with CLIF NaN semantics: NaN if either
    ;; input is NaN. `xsmindp`/`xsmaxdp` give the correct signed-zero
    ;; behaviour but the wrong NaN behaviour, so the NaN case is handled
    ;; with an explicit check.
    (FpuMinMax
      (rd WritableReg)
      (ra Reg)
      (rb Reg)
      (is_max bool))

    ;; Move a GPR's bits into an FPR (`mtvsrd`), and back (`mfvsrd`).
    (MovToFpr
      (rd WritableReg)
      (rn Reg))
    (MovFromFpr
      (rd WritableReg)
      (rn Reg))

    ;; Sign- or zero-extend a narrow value.
    (Extend
      (rd WritableReg)
      (rn Reg)
      (signed bool)
      (from_bits u8)
      (to_bits u8))

    ;; A load from memory.
    (Load
      (rd WritableReg)
      (op LoadOP)
      (flags MemFlagsData)
      (from AMode))

    ;; A store to memory.
    (Store
      (to AMode)
      (op StoreOP)
      (flags MemFlagsData)
      (src Reg))

    ;; Compute the address of an AMode into a register.
    (LoadAddr
      (rd WritableReg)
      (mem AMode))

    ;; A pseudo-instruction that captures register arguments in vregs.
    (Args
      (args VecArgPair))

    ;; A pseudo-instruction that moves vregs to return registers.
    (Rets
      (rets VecRetPair))

    ;; Return (`blr`). The Rets pseudo-inst above handles the moves; the
    ;; epilogue itself is generated by the ABI code.
    (Ret)

    ;; Register-register move (`ori rd, rs, 0` or `fmr`).
    (Mov
      (rd WritableReg)
      (rm Reg)
      (ty Type))

    ;; Materialize an icmp result as 0/1 in a GPR:
    ;; `cmp/cmpl cr0; li rd, 1; li r0, 0; isel rd, rd/r0 per cc`.
    ;; `isel` is available on all POWER8 (ISA 2.06+) hardware.
    (CmpSet
      (rd WritableReg)
      (kind IntegerCompare))

    ;; Unconditional jump (`b`).
    (Jump
      (label MachLabel))

    ;; Conditional branch: `cmp/cmpl cr0` followed by `bc`.
    (CondBr
      (taken CondBrTarget)
      (not_taken CondBrTarget)
      (kind IntegerCompare))

    ;; Unconditional trap (`trap`, i.e. `tw 31,0,0`).
    (Udf
      (trap_code TrapCode))

    ;; Trap if the comparison holds: `cmp; bc !cond, +8; trap`.
    (TrapIf
      (kind IntegerCompare)
      (trap_code TrapCode))

    ;; Direct call (`bl` with a Ppc64Call relocation).
    (Call
      (info BoxCallInfo))

    ;; Indirect call (`mtctr; bctrl`). The target is constrained to r12,
    ;; which the ELFv2 global-entry convention requires to hold the
    ;; callee's entry address.
    (CallInd
      (info BoxCallIndInfo))

    ;; A sequentially consistent atomic load: `sync; load; cmp; bc .+4;
    ;; isync` (the compare/branch forms the control dependency the isync
    ;; needs, the pattern the kernel and LLVM use).
    (AtomicLoad
      (rd WritableReg)
      (addr Reg)
      (ty Type))

    ;; A sequentially consistent atomic store: `sync; store`.
    (AtomicStore
      (src Reg)
      (addr Reg)
      (ty Type))

    ;; An atomic read-modify-write: a `sync`-fenced larx/stcx. loop, with
    ;; the update computed into r0 each iteration. POWER8 has byte and
    ;; halfword reservation forms, so no sub-word masking loop is needed.
    ;; For the min/max operations `src` is pre-extended by the lowering
    ;; rules; the loaded value is extended in the loop as required.
    (AtomicRmw
      (op AtomicRmwOp)
      (rd WritableReg)
      (addr Reg)
      (src Reg)
      (ty Type))

    ;; An atomic compare-and-swap: larx; compare with `expected`
    ;; (pre-zero-extended for sub-word types, matching the zero-extending
    ;; reservation loads); store `new` if equal.
    (AtomicCas
      (rd WritableReg)
      (addr Reg)
      (expected Reg)
      (new Reg)
      (ty Type))

    ;; A full memory barrier (`sync`).
        ;; 128-bit atomic operations. Plain `lq`/`stq` raise alignment
    ;; interrupts in little-endian mode before ISA 3.0, so every access
    ;; goes through `lqarx`/`stqcx.`, whose register pairs must be
    ;; even:odd with the even register holding the most-significant
    ;; doubleword. All operands are pinned to distinct registers by the
    ;; operand collector (mirroring the aarch64 CAS loop): the address
    ;; in r3, sources in r4:r5 (and a CAS replacement in r6:r7), the
    ;; loaded old value in r8:r9, and the computed store pair in
    ;; r10:r11 (r11 is the spill temp, always free).
    (AtomicLoad128
      (rd_lo WritableReg)
      (rd_hi WritableReg)
      (addr Reg))

    (AtomicStore128
      (rs_lo Reg)
      (rs_hi Reg)
      (tmp_lo WritableReg)
      (tmp_hi WritableReg)
      (addr Reg))

    (AtomicRmw128
      (op AtomicRmwOp)
      (rd_lo WritableReg)
      (rd_hi WritableReg)
      (tmp_hi WritableReg)
      (addr Reg)
      (src_lo Reg)
      (src_hi Reg))

    (AtomicCas128
      (rd_lo WritableReg)
      (rd_hi WritableReg)
      (addr Reg)
      (exp_lo Reg)
      (exp_hi Reg)
      (new_lo Reg)
      (new_hi Reg))

(Fence)

    ;; A direct tail call: tear the frame down and branch (`b`, not
    ;; `bl`) with LR already restored to the original return address.
    (ReturnCall
      (info BoxReturnCallInfo))

    ;; An indirect tail call, via CTR with the target pinned to r12.
    (ReturnCallInd
      (info BoxReturnCallIndInfo))

    ;; Load the address of an external symbol. Emitted as a `bcl 20,31,+4;
    ;; mflr rd; ld rd, 12(rd); b +12; .quad sym` sequence: the 8-byte
    ;; island carries an Abs8 relocation, which every object/JIT consumer
    ;; already knows how to process. This costs an LR clobber, which is
    ;; fine: LR is dead between the prologue and any call.
    (LoadExtName
      (rd WritableReg)
      (name BoxExternalName)
      (offset i64))

    ;; Move from the link register (`mflr`). Used by the prologue; rd is
    ;; always the r0 scratch there.
    (Mflr
      (rd WritableReg))

    ;; Move to the link register (`mtlr`). Used by the epilogue.
    (Mtlr
      (rs Reg))

    ;; Select between two floating-point values, by bouncing both through
    ;; general registers so `isel` can pick one. The condition is an
    ;; integer comparison, as for `Select`.
    (FpuSelect
      (rd WritableReg)
      (kind IntegerCompare)
      (rt Reg)
      (rf Reg))

    ;; A jump table: a bounds check against the number of entries, then an
    ;; indexed branch through a table of `b` instructions.
    (BrTable
      (index Reg)
      (tmp1 WritableReg)
      (tmp2 WritableReg)
      (targets VecMachLabel))

    ;; Request a constant island of the given size. Used by the
    ;; return-value loads after a call, which can be arbitrarily long.
    (EmitIsland
      (needed_space u32))

    ;; Read a fixed non-allocatable register (the stack or frame
    ;; pointer, by number) into an ordinary register.
    (MovFromPReg
      (rd WritableReg)
      (rm u8))

    ;; Materialize the address of a label (e.g. an exception handler),
    ;; via `bcl 20,31,$+4; mflr rd; addis rd, rd, ha; addi rd, rd, lo`
    ;; with the hi/lo pair patched once the label is bound. Pre-POWER10
    ;; PPC has no direct PC-relative address computation.
    (LabelAddress
      (rd WritableReg)
      (label MachLabel))

    ;; Marker for unwind info.
    (Unwind
      (inst UnwindInst))

    ;; Keep a vreg alive with no other effect.
    (DummyUse
      (reg Reg))
))

;;;; Call metadata constructors, implemented in `lower/isle.rs` ;;;;;;;;;;;;;

(decl gen_call_info (Sig ExternalName CallArgList CallRetList OptionTryCallInfo bool) BoxCallInfo)
(extern constructor gen_call_info gen_call_info)

(decl gen_call_ind_info (Sig Reg CallArgList CallRetList OptionTryCallInfo) BoxCallIndInfo)
(extern constructor gen_call_ind_info gen_call_ind_info)

(decl gen_return_call_info (Sig ExternalName CallArgList) BoxReturnCallInfo)
(extern constructor gen_return_call_info gen_return_call_info)

(decl gen_return_call_ind_info (Sig Reg CallArgList) BoxReturnCallIndInfo)
(extern constructor gen_return_call_ind_info gen_return_call_ind_info)

;;;; Internal constructor helpers ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Emit an ALU op producing a fresh temp.
(decl alu_rrr (AluOp Reg Reg) Reg)
(rule (alu_rrr op a b)
  (let ((dst WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.AluRRR op dst a b))))
    dst))

(decl ppc_add (Reg Reg) Reg)
(rule (ppc_add a b) (alu_rrr (AluOp.Add) a b))
(decl ppc_sub (Reg Reg) Reg)
(rule (ppc_sub a b) (alu_rrr (AluOp.Sub) a b))
(decl ppc_and (Reg Reg) Reg)
(rule (ppc_and a b) (alu_rrr (AluOp.And) a b))
(decl ppc_or (Reg Reg) Reg)
(rule (ppc_or a b) (alu_rrr (AluOp.Or) a b))
(decl ppc_xor (Reg Reg) Reg)
(rule (ppc_xor a b) (alu_rrr (AluOp.Xor) a b))
(decl ppc_addc (Reg Reg) Reg)
(rule (ppc_addc a b) (alu_rrr (AluOp.Addc) a b))
(decl ppc_adde (Reg Reg) Reg)
(rule (ppc_adde a b) (alu_rrr (AluOp.Adde) a b))
(decl ppc_subfc (Reg Reg) Reg)
(rule (ppc_subfc a b) (alu_rrr (AluOp.Subfc) a b))
(decl ppc_subfe (Reg Reg) Reg)
(rule (ppc_subfe a b) (alu_rrr (AluOp.Subfe) a b))
(decl ppc_mulld (Reg Reg) Reg)
(rule (ppc_mulld a b) (alu_rrr (AluOp.Mulld) a b))
(decl ppc_mulhd (Reg Reg) Reg)
(rule (ppc_mulhd a b) (alu_rrr (AluOp.Mulhd) a b))
(decl ppc_mulhdu (Reg Reg) Reg)
(rule (ppc_mulhdu a b) (alu_rrr (AluOp.Mulhdu) a b))
(decl ppc_mulhw (Reg Reg) Reg)
(rule (ppc_mulhw a b) (alu_rrr (AluOp.Mulhw) a b))
(decl ppc_mulhwu (Reg Reg) Reg)
(rule (ppc_mulhwu a b) (alu_rrr (AluOp.Mulhwu) a b))

;; ALU with a 16-bit immediate.
(decl alu_rr_imm16 (AluImmOp Reg u16) Reg)
(rule (alu_rr_imm16 op a imm)
  (let ((dst WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.AluRRImm16 op dst a imm))))
    dst))

;; `addi rd, ra, imm` when the constant fits a signed 16-bit field.
(decl pure partial simm16_from_imm64 (Imm64) u16)
(extern constructor simm16_from_imm64 simm16_from_imm64)

;; Mask a shift amount down to `ty`'s width, as CLIF requires. PPC's own
;; shifts consume a wider field and produce zero past the width, so the
;; masking cannot be left to the hardware.
(decl mask_shift_amount (Value Type) Reg)
(rule 1 (mask_shift_amount (iconst _ (u64_from_imm64 n)) ty)
  (imm $I64 (u64_and n (ty_shift_mask ty))))
(rule 0 (mask_shift_amount val ty)
  (alu_rr_imm16 (AluImmOp.Andi) (shift_amt_64 val) (shift_mask_u16 ty)))

;; A shift amount as a single register: an `i128` amount contributes
;; only its low doubleword (the mask discards everything above seven
;; bits anyway).
(decl shift_amt_64 (Value) Reg)
(rule 1 (shift_amt_64 val @ (value_type $I128))
  (value_regs_get (put_in_regs val) 0))
(rule 0 (shift_amt_64 val) (put_in_reg val))

(decl shift_mask_u16 (Type) u16)
(extern constructor shift_mask_u16 shift_mask_u16)

(decl gen_unary (UnaryOp Reg) Reg)
(rule (gen_unary op rn)
  (let ((dst WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.UnaryRR op dst rn))))
    dst))

(decl gen_shift_imm (ShiftOp Reg u8) Reg)
(rule (gen_shift_imm op ra imm)
  (let ((dst WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.ShiftRRImm op dst ra imm))))
    dst))

;; Mask a constant shift amount to the type's width, as CLIF requires.
(decl shift_imm (u64 Type) u8)
(extern constructor shift_imm shift_imm)

;; The complementary amount for turning a right rotate into a left one:
;; (bits - n) mod bits.
(decl rot_imm_neg (u64 Type) u8)
(extern constructor rot_imm_neg rot_imm_neg)

(decl gen_shift (ShiftOp Reg Reg) Reg)
(rule (gen_shift op ra rb)
  (let ((dst WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.ShiftRRR op dst ra rb))))
    dst))

(decl gen_bitcount (BitOp Reg Type) Reg)
(rule (gen_bitcount op rn ty)
  (let ((dst WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.BitCount op dst rn ty))))
    dst))

(decl gen_divrem (DivOp Reg Reg Type) Reg)
(rule (gen_divrem op ra rb ty)
  (let ((dst WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.DivRem op dst ra rb ty))))
    dst))

;; An `f32` is held in an FPR widened to double, so reinterpreting its
;; bits means converting to the single-precision encoding first. The
;; single lands in the register's high word, hence the shifts.
(decl f32_to_bits (Reg) Reg)
(rule (f32_to_bits x)
  (gen_shift (ShiftOp.Srd)
             (mov_from_fpr (fpu_rr (FpuOp1.CvtToSingleBits) x $F32))
             (imm $I64 32)))

(decl f32_from_bits (Reg) Reg)
(rule (f32_from_bits x)
  (fpu_rr (FpuOp1.CvtFromSingleBits)
          (mov_to_fpr (gen_shift (ShiftOp.Sld) x (imm $I64 32)) $F32)
          $F32))

(decl gen_fpu_select (IntegerCompare Reg Reg Type) Reg)
(rule (gen_fpu_select kind rt rf ty)
  (let ((dst WritableReg (temp_writable_reg ty))
        (_ Unit (emit (MInst.FpuSelect dst kind rt rf))))
    dst))

(decl gen_select (IntegerCompare Reg Reg) Reg)
(rule (gen_select kind rt rf)
  (let ((dst WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.Select dst kind rt rf))))
    dst))

(decl gen_trapif (IntegerCompare TrapCode) SideEffectNoResult)
(rule (gen_trapif kind code)
  (SideEffectNoResult.Inst (MInst.TrapIf kind code)))

(decl fpu_rrr (FpuOp2 Reg Reg Type) Reg)
(rule (fpu_rrr op a b ty)
  (let ((dst WritableReg (temp_writable_reg ty))
        (_ Unit (emit (MInst.FpuRRR op dst a b ty))))
    dst))

(decl fpu_rr (FpuOp1 Reg Type) Reg)
(rule (fpu_rr op rn ty)
  (let ((dst WritableReg (temp_writable_reg ty))
        (_ Unit (emit (MInst.FpuRR op dst rn ty))))
    dst))

(decl fpu_fma (Reg Reg Reg Type) Reg)
(rule (fpu_fma a c b ty)
  (let ((dst WritableReg (temp_writable_reg ty))
        (_ Unit (emit (MInst.FpuFma dst a c b ty))))
    dst))

(decl float_compare (FloatCC Reg Reg) FloatCompare)
(extern constructor float_compare float_compare)

(decl fpu_cmp_set (FloatCompare) Reg)
(rule (fpu_cmp_set kind)
  (let ((dst WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.FpuCmpSet dst kind))))
